<%- include('../partials/header') %>
<form method="post" action="<%= plan ? '/admin/plans/'+plan.id : '/admin/plans' %>" class="form fs-page" id="planForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="fs-page-head">
    <div>
      <h2><%= plan ? 'Modifica pacchetto' : 'Nuovo pacchetto' %></h2>
      <p><%= plan ? 'ID #'+plan.id+' · slug "'+plan.slug+'"' : 'Crea un nuovo pacchetto (Single / Red / Gold / Junior) collegato a un evento.' %></p>
    </div>
    <a class="btn btn-ghost" href="/admin/plans">← Torna ai pacchetti</a>
  </div>

  <!-- SEZIONE 1: Identità -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#fdf2c9;color:#7a5800">🎯</div>
      <div>
        <h3 class="fs-section-title">Identità e aspetto</h3>
        <p class="fs-section-sub">Come appare la card del pacchetto nella pagina prezzi.</p>
      </div>
    </div>
    <div class="fs-grid">
      <div class="field">
        <label class="field-lbl">Nome *</label>
        <input type="text" name="name" required value="<%= plan ? plan.name : '' %>" placeholder="es. Pack Gold">
      </div>
      <div class="field">
        <label class="field-lbl">Slug *</label>
        <input type="text" name="slug" required value="<%= plan ? plan.slug : '' %>" placeholder="pack-gold">
        <div class="field-help">URL: <code>/reserva/&lt;slug&gt;</code> — solo lettere minuscole, numeri e trattini.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Badge in alto (opzionale)</label>
        <input type="text" name="badge" value="<%= plan ? plan.badge : '' %>" placeholder="es. Más popular">
        <div class="field-help">Appare come tag sopra la card.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Etichetta bottone CTA</label>
        <input type="text" name="ctaLabel" value="<%= plan ? plan.ctaLabel : 'Reserva' %>" placeholder="Reserva">
      </div>
      <div class="field">
        <label class="field-lbl">Colore di brand</label>
        <div class="color-row">
          <input type="color" name="color" value="<%= plan ? (plan.color||'#e0aa00') : '#e0aa00' %>">
          <input type="text" class="color-hex" value="<%= plan ? (plan.color||'#e0aa00') : '#e0aa00' %>" readonly>
        </div>
        <div class="field-help">Usato per accenti grafici sulla card e nel checkout.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Ordine in lista</label>
        <input type="number" name="sort" value="<%= plan ? plan.sort : 0 %>">
        <div class="field-help">Valore più basso = mostrato per primo.</div>
      </div>
      <div class="field field-full">
        <label class="field-lbl">Descrizione (opzionale)</label>
        <textarea name="description" rows="3" placeholder="Breve descrizione visibile sotto al titolo del pacchetto."><%= plan ? plan.description : '' %></textarea>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2: Evento + comportamento prenotazione -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#e3f0ff;color:#0d5290">🎟</div>
      <div>
        <h3 class="fs-section-title">Evento e modalità di prenotazione</h3>
        <p class="fs-section-sub">A quale stage è collegato e come si compila il checkout.</p>
      </div>
    </div>
    <div class="fs-grid">
      <div class="field">
        <label class="field-lbl">Evento collegato</label>
        <select name="eventId">
          <option value="">— Nessuno —</option>
          <% events.forEach(function(ev){ %>
            <option value="<%= ev.id %>" <%= plan && plan.eventId===ev.id ? 'selected':'' %>><%= ev.title %></option>
          <% }) %>
        </select>
        <div class="field-help">Determina date e orari proposti nel checkout.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Comportamento prenotazione</label>
        <select name="bookingMode">
          <% MODES.forEach(function(m){ %><option value="<%= m.v %>" <%= plan && plan.bookingMode===m.v ? 'selected':'' %>><%= m.l %></option><% }) %>
        </select>
        <div class="field-help">Definisce se l'utente sceglie lezioni singole, fasce AM/PM o un range intero.</div>
      </div>
      <div class="field">
        <div class="fs-switch-card">
          <label class="switch" style="margin:0">
            <input type="checkbox" name="active" value="1" <%= !plan || plan.active ? 'checked':'' %>>
            <span><strong>Pacchetto attivo</strong></span>
          </label>
          <span class="muted" style="font-size:12px">Quando OFF è nascosto dal sito.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3: Prezzo -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#e7f3ec;color:#1b6b3e">💰</div>
      <div>
        <h3 class="fs-section-title">Prezzo base e valuta</h3>
        <p class="fs-section-sub">Prezzo di partenza. Sconti e tariffe avanzate si configurano sotto.</p>
      </div>
    </div>
    <div class="fs-grid">
      <div class="field">
        <label class="field-lbl">Prezzo</label>
        <input type="number" step="0.01" name="price" value="<%= plan ? plan.price : 0 %>">
      </div>
      <div class="field">
        <label class="field-lbl">Valuta</label>
        <input type="text" name="currency" value="<%= plan ? plan.currency : 'EUR' %>" placeholder="EUR">
      </div>
    </div>
  </section>

  <!-- SEZIONE 4: Sconto -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#fff3d6;color:#7a5800">🎁</div>
      <div>
        <h3 class="fs-section-title">Sconto multi-partecipante</h3>
        <p class="fs-section-sub">Quando un cliente prenota per più persone, può scattare uno sconto percentuale automatico.</p>
      </div>
    </div>
    <div class="fs-grid">
      <div class="field">
        <label class="field-lbl">Da N partecipanti in su</label>
        <input type="number" name="discountThreshold" min="0" step="1" value="<%= plan ? plan.discountThreshold : 0 %>" placeholder="es. 5">
        <div class="field-help"><strong>0</strong> = sconto disattivato.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Sconto %</label>
        <input type="number" name="discountPercent" min="0" max="100" step="0.5" value="<%= plan ? plan.discountPercent : 0 %>" placeholder="es. 20">
        <div class="field-help">Si applica solo al prezzo del pacchetto, gli extras restano a prezzo pieno.</div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 5: Tariffe avanzate -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#f0e8f7;color:#5b3a86">⚙</div>
      <div>
        <h3 class="fs-section-title">Tariffe avanzate (Early bird / per numero lezioni)</h3>
        <p class="fs-section-sub">Configurazione JSON delle tariffe dinamiche.</p>
      </div>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
      <button type="button" class="btn btn-ghost btn-sm" data-pricing-template="lessons">📐 Template "lezioni singole"</button>
      <button type="button" class="btn btn-ghost btn-sm" data-pricing-template="tiers">📅 Template "fasce early bird"</button>
      <button type="button" class="btn btn-ghost btn-sm" id="pricingFormat">✨ Formatta JSON</button>
      <span class="muted" id="pricingValidity" style="font-size:12.5px;display:inline-flex;align-items:center;gap:6px"></span>
    </div>

    <textarea name="pricingJson" id="pricingJson" rows="6" style="font-family:Consolas,Menlo,monospace;font-size:13px"><%= plan ? plan.pricingJson : '' %></textarea>

    <div class="fs-help" style="margin-top:12px">
      <strong>Formati supportati:</strong><br>
      • <strong>Single</strong> (lezioni): <code>{"type":"lessons","options":[{"count":1,"price":35},{"count":3,"price":82.5},{"count":6,"price":120}]}</code><br>
      • <strong>Gold / Red / Junior</strong> (fasce date): <code>{"type":"tiers","base":360,"tiers":[{"until":"2026-06-15","price":288},{"until":"2026-07-10","price":324}]}</code><br>
      Le fasce scattano in base alla data: la prima <code>until</code> futura vince. Dopo l'ultima → <code>base</code>.
    </div>
  </section>

  <div class="fs-actions">
    <a class="btn btn-ghost" href="/admin/plans">Annulla</a>
    <button class="btn btn-primary" type="submit"><%= plan ? '💾 Salva modifiche' : '✨ Crea pacchetto' %></button>
  </div>
</form>

<script>
  // Sincronizza picker colore <-> input testo
  document.querySelectorAll('.color-row').forEach(function(r){
    var c=r.querySelector('input[type=color]'), t=r.querySelector('.color-hex');
    c.addEventListener('input',function(){ t.value=c.value; });
  });

  // Pricing JSON helpers
  var pricingTa = document.getElementById('pricingJson');
  var validity = document.getElementById('pricingValidity');

  var TEMPLATES = {
    lessons: { type:'lessons', options:[
      { count:1, price:35 },
      { count:3, price:82.5 },
      { count:6, price:120 },
    ]},
    tiers: { type:'tiers', base:360, tiers:[
      { until:'2026-06-15', price:288 },
      { until:'2026-07-10', price:324 },
    ]},
  };

  document.querySelectorAll('[data-pricing-template]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (pricingTa.value.trim() && !confirm('Sostituire il contenuto attuale con il template?')) return;
      pricingTa.value = JSON.stringify(TEMPLATES[btn.getAttribute('data-pricing-template')], null, 2);
      validate();
    });
  });

  document.getElementById('pricingFormat').addEventListener('click', function(){
    try { pricingTa.value = JSON.stringify(JSON.parse(pricingTa.value), null, 2); validate(); }
    catch(e){ validity.innerHTML = '<span style="color:#b53636">⨯ JSON non valido: '+e.message+'</span>'; }
  });

  function validate(){
    var v = pricingTa.value.trim();
    if (!v) { validity.textContent = ''; return; }
    try { JSON.parse(v); validity.innerHTML = '<span style="color:#1b6b3e">✓ JSON valido</span>'; }
    catch(e){ validity.innerHTML = '<span style="color:#b53636">⨯ JSON non valido</span>'; }
  }
  pricingTa.addEventListener('input', validate);
  validate();
</script>
<%- include('../partials/footer') %>
