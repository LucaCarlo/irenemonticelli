<%- include('../partials/header') %>
<div class="card">
  <div class="card-head">
    <h2>Piani / Pacchetti</h2>
    <a class="btn btn-primary" href="/admin/plans/new">+ Nuovo piano</a>
  </div>
  <%- include('../partials/dt-toolbar', {
    params, total, totalUnfiltered,
    entitySingular:'piano', entityPlural:'piani',
    basePath:'/admin/plans',
    searchPlaceholder:'Cerca per nome, slug, descrizione…',
    extraFilters:[{ name:'status', value: status, options:[{val:'',label:'Tutti gli stati'},{val:'active',label:'Attivo'},{val:'inactive',label:'Nascosto'}] }],
  }) %>
  <% if (!plans.length) { %><p class="muted" style="padding:20px 0">Nessun piano.</p><% } else { %>
  <div class="table-wrap">
  <table class="table">
    <thead><tr>
      <th></th>
      <%- include('../partials/dt-th', { label:'Nome', sortKey:'name', params, basePath:'/admin/plans' }) %>
      <th>Evento</th>
      <%- include('../partials/dt-th', { label:'Prezzo', sortKey:'price', params, basePath:'/admin/plans' }) %>
      <%- include('../partials/dt-th', { label:'Prenotazione', sortKey:'bookingMode', params, basePath:'/admin/plans' }) %>
      <th>CTA</th>
      <%- include('../partials/dt-th', { label:'Stato', sortKey:'active', params, basePath:'/admin/plans' }) %>
      <th></th>
    </tr></thead>
    <tbody>
    <% plans.forEach(function(p){ var mode=(MODES.find(function(m){return m.v===p.bookingMode;})||{}).l||p.bookingMode; %>
      <tr>
        <td><span class="color-dot" style="background:<%= p.color || '#e0aa00' %>"></span></td>
        <td><strong><%= p.name %></strong><% if (p.badge) { %> <span class="badge badge-warn"><%= p.badge %></span><% } %><div class="muted" style="font-size:12px"><code><%= p.slug %></code></div></td>
        <td><%= p.event ? p.event.title : '—' %></td>
        <td><%= p.price %> <%= p.currency %></td>
        <td><%= mode %></td>
        <td><%= p.ctaLabel %></td>
        <td><% if (p.active) { %><span class="badge badge-ok">attivo</span><% } else { %><span class="badge badge-off">nascosto</span><% } %></td>
        <td class="row-actions">
          <a class="btn-ico btn-ico-edit" href="/admin/plans/<%= p.id %>/edit" title="Modifica"><%- include('../partials/ico', { name:'edit' }) %></a>
          <form method="post" action="/admin/plans/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-ico <%= p.active?'btn-ico-hide':'btn-ico-show' %>" title="<%= p.active?'Nascondi (ora visibile)':'Attiva (ora nascosto)' %>"><%- include('../partials/ico', { name: p.active?'eye':'eye-off' }) %></button></form>
          <form method="post" action="/admin/plans/<%= p.id %>/delete" onsubmit="return confirm('Eliminare questo piano?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button></form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <%- include('../partials/dt-pagination', { links, params, basePath:'/admin/plans' }) %>
  <% } %>
</div>
<%- include('../partials/footer') %>
