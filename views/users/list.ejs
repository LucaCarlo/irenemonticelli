<%- include('../partials/header') %>
<div class="card">
  <div class="card-head">
    <h2>Amministratori</h2>
    <% if (can('users.create')) { %><a class="btn btn-primary" href="/admin/users/new">+ Nuovo amministratore</a><% } %>
  </div>

  <%- include('../partials/dt-toolbar', {
    params: params,
    total: total,
    totalUnfiltered: totalUnfiltered,
    entitySingular: 'amministratore',
    entityPlural: 'amministratori',
    basePath: '/admin/users',
    searchPlaceholder: 'Cerca per nome o email…',
    extraFilters: [
      { name: 'roleId', value: roleId, options: [{ val: '', label: 'Tutti i ruoli' }].concat(roles.map(function(r){return { val: r.id, label: r.name };})) },
      { name: 'status', value: status, options: [
        { val: '', label: 'Tutti gli stati' },
        { val: 'active', label: 'Attivo' },
        { val: 'inactive', label: 'Disattivo' },
      ] },
    ],
  }) %>

  <% if (!users.length) { %>
    <p class="muted" style="padding:20px 0">Nessun amministratore trovato.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <%- include('../partials/dt-th', { label: 'Nome', sortKey: 'name', params: params, basePath: '/admin/users' }) %>
            <%- include('../partials/dt-th', { label: 'Email', sortKey: 'email', params: params, basePath: '/admin/users' }) %>
            <%- include('../partials/dt-th', { label: 'Ruolo', sortKey: 'role.name', params: params, basePath: '/admin/users' }) %>
            <th>Stato</th>
            <%- include('../partials/dt-th', { label: 'Ultimo accesso', sortKey: 'lastLoginAt', params: params, basePath: '/admin/users' }) %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u){ %>
            <tr>
              <td><%= u.name %><% if (u.id === currentUser.id) { %> <span class="badge">tu</span><% } %></td>
              <td><%= u.email %></td>
              <td><span class="badge badge-role"><%= u.role ? u.role.name : '—' %></span></td>
              <td><% if (u.isActive) { %><span class="badge badge-ok">attivo</span><% } else { %><span class="badge badge-off">disattivo</span><% } %>
                <% if (u.mustChangePassword) { %><span class="badge badge-warn">cambio pw</span><% } %>
              </td>
              <td class="muted"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString('it-IT') : 'mai' %></td>
              <td class="row-actions">
                <% if (can('users.edit')) { %>
                  <a class="btn-ico btn-ico-edit" href="/admin/users/<%= u.id %>/edit" title="Modifica"><%- include('../partials/ico', { name:'edit' }) %></a>
                <% } %>
                <% if (can('users.delete') && u.id !== currentUser.id) { %>
                  <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Eliminare definitivamente questo utente?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/dt-pagination', { links: links, params: params, basePath: '/admin/users' }) %>
  <% } %>
</div>
<%- include('../partials/footer') %>
