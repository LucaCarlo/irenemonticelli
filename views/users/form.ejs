<%- include('../partials/header') %>
<form method="post" action="<%= user ? '/admin/users/'+user.id : '/admin/users' %>" class="form fs-page" id="userForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="fs-page-head">
    <div>
      <h2><%= user ? 'Modifica amministratore' : 'Nuovo amministratore' %></h2>
      <p><%= user ? 'ID #'+user.id+' · '+user.email : 'Crea un nuovo account amministratore con accesso al pannello.' %></p>
    </div>
    <a class="btn btn-ghost" href="/admin/users">← Torna agli amministratori</a>
  </div>

  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#fdf2c9;color:#7a5800">👤</div>
      <div>
        <h3 class="fs-section-title">Dati di accesso</h3>
        <p class="fs-section-sub">Nome, email e ruolo assegnato.</p>
      </div>
    </div>
    <div class="fs-grid">
      <div class="field">
        <label class="field-lbl">Nome *</label>
        <input type="text" name="name" required value="<%= user ? user.name : '' %>" placeholder="es. Mario Rossi">
      </div>
      <div class="field">
        <label class="field-lbl">Email *</label>
        <input type="email" name="email" required value="<%= user ? user.email : '' %>" placeholder="nome@dominio.com">
        <div class="field-help">Sarà l'username per il login.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Ruolo *</label>
        <select name="roleId" required>
          <% roles.forEach(function(r){ %>
            <option value="<%= r.id %>" <%= user && user.roleId === r.id ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
        <div class="field-help">Definisce quali sezioni del pannello sono accessibili.</div>
      </div>
      <% if (!user) { %>
      <div class="field">
        <label class="field-lbl">Password iniziale (opzionale)</label>
        <input type="text" name="password" placeholder="Lascia vuoto per generarla automaticamente">
        <div class="field-help">Se la generi, sarà mostrata dopo la creazione. L'utente potrà cambiarla.</div>
      </div>
      <% } %>
      <div class="field field-full">
        <div class="fs-switch-card">
          <label class="switch" style="margin:0">
            <input type="checkbox" name="isActive" value="1" <%= !user || user.isActive ? 'checked' : '' %>>
            <span><strong>Account attivo</strong></span>
          </label>
          <span class="muted" style="font-size:12px">Se OFF, l'utente non può effettuare il login.</span>
        </div>
      </div>
    </div>
  </section>

  <div class="fs-actions">
    <a class="btn btn-ghost" href="/admin/users">Annulla</a>
    <button type="submit" class="btn btn-primary"><%= user ? '💾 Salva modifiche' : '✨ Crea amministratore' %></button>
  </div>
</form>
<%- include('../partials/footer') %>
