<%- include('../partials/header') %>
<div class="card">
  <div class="card-head">
    <h2>Ruoli</h2>
    <% if (can('roles.create')) { %><a class="btn btn-primary" href="/admin/roles/new">+ Nuovo ruolo</a><% } %>
  </div>
  <%- include('../partials/dt-toolbar', {
    params, total, totalUnfiltered,
    entitySingular:'ruolo', entityPlural:'ruoli',
    basePath:'/admin/roles',
    searchPlaceholder:'Cerca per nome o descrizione…',
  }) %>
  <% if (!roles.length) { %><p class="muted" style="padding:20px 0">Nessun ruolo.</p><% } else { %>
  <div class="table-wrap">
  <table class="table">
    <thead><tr>
      <%- include('../partials/dt-th', { label:'Nome', sortKey:'name', params, basePath:'/admin/roles' }) %>
      <th>Descrizione</th>
      <th>Permessi</th>
      <th>Utenti</th>
      <th></th>
    </tr></thead>
    <tbody>
    <% roles.forEach(function(r){ var perms; try { perms = JSON.parse(r.permissions||'[]'); } catch(e){ perms=[]; } %>
      <tr>
        <td><%= r.name %> <% if (r.isSystem) { %><span class="badge badge-warn">sistema</span><% } %></td>
        <td class="muted"><%= r.description %></td>
        <td><%= perms.includes('*') ? 'Tutti i permessi' : perms.length + ' permessi' %></td>
        <td><%= r._count.users %></td>
        <td class="row-actions">
          <% if (can('roles.edit') && !r.isSystem) { %>
            <a class="btn-ico btn-ico-edit" href="/admin/roles/<%= r.id %>/edit" title="Modifica"><%- include('../partials/ico', { name:'edit' }) %></a>
          <% } %>
          <% if (can('roles.delete') && !r.isSystem) { %>
            <form method="post" action="/admin/roles/<%= r.id %>/delete" onsubmit="return confirm('Eliminare questo ruolo?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <%- include('../partials/dt-pagination', { links, params, basePath:'/admin/roles' }) %>
  <% } %>
</div>
<%- include('../partials/footer') %>
