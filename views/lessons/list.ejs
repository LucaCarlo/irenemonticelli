<%- include('../partials/header') %>

<div class="card">
  <div class="card-head">
    <div>
      <h2 style="margin:0">Programma lezioni</h2>
      <p class="muted" style="margin:4px 0 0;font-size:13.5px">Programma del Pro Dance. Trascina <strong>⠿</strong> per riordinare. Click su <strong>✎</strong> per modificare o <strong>👥</strong> per vedere i partecipanti.</p>
    </div>
    <div class="head-tools" style="display:flex;gap:10px;align-items:center">
      <form method="get" action="/admin/lessons" style="display:inline-flex;align-items:center;gap:8px;margin:0">
        <label class="muted" style="font-size:13px">Evento</label>
        <select name="event" onchange="this.form.submit()" class="lessons-evt">
          <% events.forEach(function(ev){ %>
            <option value="<%= ev.id %>" <%= ev.id===evId?'selected':'' %>><%= ev.title %></option>
          <% }) %>
        </select>
      </form>
      <% if (evId) { %>
        <button type="button" class="btn btn-primary btn-sm" id="openNewLessonBtn">+ Nuova lezione</button>
      <% } %>
    </div>
  </div>
</div>

<% if (!Object.keys(byDay).length) { %>
  <div class="card" style="text-align:center;padding:50px 20px">
    <div style="font-size:42px;margin-bottom:8px">🎶</div>
    <h3 style="margin:0 0 6px">Nessuna lezione</h3>
    <p class="muted" style="margin:0 0 18px">Crea la prima lezione per questo evento usando il form qui sotto.</p>
  </div>
<% } %>

<% Object.keys(byDay).sort(function(a,b){return parseInt(a,10)-parseInt(b,10)}).forEach(function(dKey){ %>
  <div class="card lessons-day-card" data-day="<%= dKey %>">
    <div class="lessons-day-head">
      <div class="lessons-day-num">G<%= dKey %></div>
      <div class="lessons-day-title">
        <h3 style="margin:0;font-size:16px">Giorno <%= dKey %></h3>
        <div class="muted" style="font-size:12.5px"><%= byDay[dKey].length %> lezioni</div>
      </div>
    </div>

    <div class="table-wrap">
      <table class="table lessons-table">
        <thead>
          <tr>
            <th style="width:30px"></th>
            <th style="width:80px">Orario</th>
            <th>Titolo</th>
            <th style="width:170px">Professore</th>
            <th style="width:110px">Fascia</th>
            <th style="width:180px">Posti</th>
            <th style="width:100px">Stato</th>
            <th style="width:140px"></th>
          </tr>
        </thead>
        <tbody data-day-list="<%= dKey %>">
          <% byDay[dKey].forEach(function(l){
               var occPct = (l.capacity > 0) ? Math.min(100, Math.round((l._occupied/l.capacity)*100)) : 0;
               var occCls = l._full ? 'is-full' : (l.capacity > 0 && l._occupied/l.capacity > 0.7 ? 'is-warn' : '');
          %>
            <tr class="lesson-row <%= l.isPause?'is-pause':'' %> <%= !l.active?'is-off':'' %>" data-id="<%= l.id %>" data-day="<%= dKey %>">
              <td class="lesson-grip" title="Trascina per riordinare">
                <svg width="14" height="20" viewBox="0 0 14 20" fill="currentColor"><circle cx="3" cy="3" r="1.5"/><circle cx="3" cy="10" r="1.5"/><circle cx="3" cy="17" r="1.5"/><circle cx="11" cy="3" r="1.5"/><circle cx="11" cy="10" r="1.5"/><circle cx="11" cy="17" r="1.5"/></svg>
              </td>
              <td><span class="lesson-time-badge"><%= l.time %></span></td>
              <td>
                <a href="/admin/lessons/<%= l.id %>/edit" class="lesson-title-link"><strong><%= l.title %></strong></a>
                <% if (l.isPause) { %><div class="muted" style="font-size:11px">⏸ pausa</div><% } %>
              </td>
              <td>
                <% if (l.professor) { %>
                  <span><%= l.professor.firstName %> <%= l.professor.lastName %></span>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <td>
                <% if (l.isPause) { %>
                  <span class="muted">—</span>
                <% } else if (l.isAfternoon) { %>
                  <span class="chip chip-pm">Tarde</span>
                <% } else { %>
                  <span class="chip chip-am">Mañana</span>
                <% } %>
              </td>
              <td>
                <% if (l.isPause) { %>
                  <span class="muted">—</span>
                <% } else if (l.capacity === 0) { %>
                  <span class="muted">Illimitato</span>
                <% } else { %>
                  <div class="cap-cell">
                    <div class="cap-num"><strong><%= l._occupied %></strong>/<%= l.capacity %></div>
                    <div class="cap-bar"><div class="cap-fill <%= occCls %>" style="width:<%= occPct %>%"></div></div>
                  </div>
                <% } %>
              </td>
              <td>
                <% if (!l.active) { %><span class="badge badge-off">disattiva</span>
                <% } else if (l.isPause) { %><span class="badge badge-warn">pausa</span>
                <% } else if (l._full) { %><span class="badge badge-off">piena</span>
                <% } else { %><span class="badge badge-ok">attiva</span><% } %>
              </td>
              <td class="row-actions">
                <% if (!l.isPause) { %>
                  <a class="btn-ico btn-ico-open" href="/admin/lessons/<%= l.id %>/participants" title="Vedi partecipanti (<%= l._occupied %>)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 6.5a3 3 0 0 1 0 6M16.5 20a5.5 5.5 0 0 0-3-4.9"/></svg>
                  </a>
                <% } %>
                <a class="btn-ico btn-ico-edit" href="/admin/lessons/<%= l.id %>/edit" title="Modifica"><%- include('../partials/ico', { name:'edit' }) %></a>
                <form method="post" action="/admin/lessons/<%= l.id %>/delete" onsubmit="return confirm('Eliminare la lezione <%= l.title %>?')" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% }) %>

<% if (evId) { %>
<!-- Modal nuova lezione (aperto da bottone in alto) -->
<div class="nl-modal" id="newLessonModal" hidden>
  <div class="nl-modal-backdrop" data-close></div>
  <div class="nl-modal-panel">
    <div class="nl-modal-head">
      <h3 style="margin:0">+ Nuova lezione</h3>
      <button type="button" class="btn-ico" data-close title="Chiudi">×</button>
    </div>
    <form method="post" action="/admin/lessons" class="form" style="padding:20px 24px 24px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="eventId" value="<%= evId %>">
      <div class="fs-grid">
        <div class="field"><label class="field-lbl">Giorno</label><input type="number" name="dayIndex" value="1" min="1" required></div>
        <div class="field"><label class="field-lbl">Orario</label><input type="text" name="time" placeholder="9:30" required autofocus></div>
        <div class="field field-full"><label class="field-lbl">Titolo lezione</label><input type="text" name="title" placeholder="Ballet" required></div>
        <div class="field field-full">
          <label class="field-lbl">Professore</label>
          <select name="professorId">
            <option value="">— Nessuno —</option>
            <% professors.forEach(function(p){ %><option value="<%= p.id %>"><%= p.firstName %> <%= p.lastName %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label class="field-lbl">Fascia</label>
          <select name="isAfternoon"><option value="">Mañana</option><option value="1">Tarde</option></select>
        </div>
        <div class="field">
          <label class="field-lbl">Capacità (0 = illimitata)</label>
          <input type="number" name="capacity" value="100" min="0" max="9999">
        </div>
        <div class="field field-full" style="padding-top:6px">
          <label class="switch"><input type="checkbox" name="isPause" value="1"><span>È una pausa (lunch ecc.)</span></label>
        </div>
      </div>
      <div class="fs-actions" style="margin-top:16px">
        <button type="button" class="btn btn-ghost" data-close>Annulla</button>
        <button type="submit" class="btn btn-primary">+ Aggiungi lezione</button>
      </div>
    </form>
  </div>
</div>
<script>
(function(){
  var modal = document.getElementById('newLessonModal');
  var openBtn = document.getElementById('openNewLessonBtn');
  function show(){ modal.hidden = false; document.body.style.overflow='hidden'; var inp = modal.querySelector('input[name=time]'); if (inp) inp.focus(); }
  function hide(){ modal.hidden = true; document.body.style.overflow=''; }
  if (openBtn) openBtn.addEventListener('click', show);
  modal.addEventListener('click', function(e){ if (e.target.hasAttribute('data-close')) hide(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !modal.hidden) hide(); });
})();
</script>
<% } %>

<div class="lesson-saver" id="lessonSaver" hidden>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
  <span>Ordine salvato</span>
</div>

<style>
  .lessons-evt{height:38px;padding:0 32px 0 12px;border:1px solid var(--line);border-radius:8px;background:#fff;font-size:13.5px;min-width:200px}

  .lessons-day-card{padding:18px 18px 14px;margin-top:14px}
  .lessons-day-head{display:flex;align-items:center;gap:14px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px dashed #eef0f4}
  .lessons-day-num{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#fdf2c9,#ffe39e);
    display:flex;align-items:center;justify-content:center;font-weight:700;color:#7a5800;font-size:14px;letter-spacing:.05em}

  .lessons-table tbody tr.lesson-row{transition:background .15s}
  .lessons-table tbody tr.lesson-row:hover{background:#fafbfc}
  .lessons-table tbody tr.lesson-row.is-pause{background:linear-gradient(135deg,#fbf6e6 0%,#fff 50%)}
  .lessons-table tbody tr.lesson-row.is-off{opacity:.55}
  .lessons-table tbody tr.lesson-row.is-dragging{opacity:.6;background:#fffbe8}
  .lessons-table tbody tr.lesson-row.is-ghost{background:#fffbe8;border:1px dashed #e0aa00}

  .lesson-grip{color:#b5bcc8;cursor:grab;text-align:center;padding:8px 6px;touch-action:none}
  .lesson-grip:hover{color:#7a5800}
  .lesson-grip:active{cursor:grabbing}

  .lesson-time-badge{display:inline-block;background:#1c1f26;color:#e0aa00;padding:4px 10px;border-radius:6px;font-family:'Courier New',monospace;font-weight:700;font-size:13px;letter-spacing:.04em;min-width:54px;text-align:center}
  .lesson-title-link{color:#1c1f26;text-decoration:none}
  .lesson-title-link:hover{color:#7a5800;text-decoration:underline}

  .chip{display:inline-block;padding:3px 9px;border-radius:11px;font-size:11.5px;font-weight:700;letter-spacing:.02em}
  .chip-am{background:#fffbe8;color:#7a5800;border:1px solid #e8d99a}
  .chip-pm{background:#fde7d6;color:#8a4a1c;border:1px solid #e8b88a}

  .cap-cell{display:flex;flex-direction:column;gap:4px}
  .cap-num{font-size:12.5px;color:#1c1f26}
  .cap-num strong{font-weight:700}
  .cap-bar{height:6px;background:#eef0f4;border-radius:3px;overflow:hidden}
  .cap-fill{height:100%;background:linear-gradient(90deg,#9ad1ae,#1b6b3e);transition:width .25s}
  .cap-fill.is-warn{background:linear-gradient(90deg,#f0c04b,#c8970a)}
  .cap-fill.is-full{background:linear-gradient(90deg,#e88080,#9b2727)}

  /* Modal nuova lezione */
  .nl-modal{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center}
  .nl-modal-backdrop{position:absolute;inset:0;background:rgba(28,31,38,.55);backdrop-filter:blur(2px)}
  .nl-modal-panel{position:relative;background:#fff;border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.3);width:min(560px,92vw);max-height:90vh;overflow:auto;animation:nlIn .2s ease}
  @keyframes nlIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:none}}
  .nl-modal-head{display:flex;justify-content:space-between;align-items:center;padding:18px 24px;border-bottom:1px solid #eef0f4}

  .lesson-saver{position:fixed;bottom:20px;right:24px;background:#1c1f26;color:#e0aa00;padding:10px 16px;border-radius:30px;
    display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;box-shadow:0 8px 28px rgba(0,0,0,.2);z-index:50;
    animation:lessonSaverIn .25s ease}
  @keyframes lessonSaverIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  @media(max-width:900px){
    .lessons-table th:nth-child(4),.lessons-table td:nth-child(4){display:none}
    .lessons-table th:nth-child(7),.lessons-table td:nth-child(7){display:none}
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
(function(){
  var saver = document.getElementById('lessonSaver');
  var saverTimer = null;
  function showSaver(){
    saver.hidden = false;
    if (saverTimer) clearTimeout(saverTimer);
    saverTimer = setTimeout(function(){ saver.hidden = true; }, 1400);
  }

  function readOrder(){
    var rows = document.querySelectorAll('.lesson-row');
    var items = [];
    var perDay = {};
    rows.forEach(function(row){
      var listEl = row.parentElement;
      var day = parseInt(listEl.getAttribute('data-day-list'), 10);
      perDay[day] = perDay[day] || 0;
      var sort = perDay[day]++;
      items.push({ id: parseInt(row.getAttribute('data-id'), 10), dayIndex: day, sort: sort });
      row.setAttribute('data-day', String(day));
    });
    return items;
  }

  function persist(){
    var items = readOrder();
    if (!items.length) return;
    var csrf = document.querySelector('input[name=_csrf]');
    fetch('/admin/lessons/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf ? csrf.value : '' },
      body: JSON.stringify({ items: items }),
    }).then(function(r){ if (r.ok) showSaver(); });
  }

  document.querySelectorAll('[data-day-list]').forEach(function(list){
    new Sortable(list, {
      group: 'lessons',
      handle: '.lesson-grip',
      animation: 180,
      ghostClass: 'is-ghost',
      dragClass: 'is-dragging',
      onEnd: persist,
    });
  });
})();
</script>
<%- include('../partials/footer') %>
