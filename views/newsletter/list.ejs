<%- include('../partials/header') %>

<%
  function fmtDate(d){ if(!d) return '—'; var dt=new Date(d); return isNaN(dt)?'—':dt.toLocaleDateString('it-IT',{day:'2-digit',month:'short',year:'numeric'}); }
  function fmtDateTime(d){ if(!d) return '—'; var dt=new Date(d); return isNaN(dt)?'—':dt.toLocaleString('it-IT',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
%>

<div class="card">
  <div class="card-head">
    <div>
      <h2 style="margin:0">Campagne</h2>
      <p class="muted" style="margin:4px 0 0;font-size:13.5px">Bozze, programmate e cronologia di tutte le email inviate.</p>
    </div>
    <div class="head-tools" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <a class="btn btn-ghost" href="/admin/contacts" title="Vai alla pagina utenti">👥 Iscritti totali: <%= subStats.active %></a>
      <a class="btn btn-primary" href="/admin/newsletter/new">+ Nuova campagna</a>
    </div>
  </div>

  <!-- KPI -->
  <div class="nl-kpi-grid">
    <div class="nl-kpi"><div class="nl-kpi-lbl">Iscritti attivi</div><div class="nl-kpi-val"><%= subStats.active %></div></div>
    <div class="nl-kpi"><div class="nl-kpi-lbl">Disiscritti</div><div class="nl-kpi-val" style="color:#9b2727"><%= subStats.unsubscribed %></div></div>
    <div class="nl-kpi"><div class="nl-kpi-lbl">Bounced</div><div class="nl-kpi-val" style="color:#9b2727"><%= subStats.bounced %></div></div>
    <div class="nl-kpi nl-kpi-accent"><div class="nl-kpi-lbl">Campagne totali</div><div class="nl-kpi-val"><%= campaigns.length %></div></div>
  </div>
</div>

<%
  var drafts = campaigns.filter(function(c){ return c.status==='draft'; });
  var sent = campaigns.filter(function(c){ return c.status!=='draft'; });
%>

<% if (!campaigns.length) { %>
  <div class="card" style="text-align:center;padding:60px 20px">
    <div style="font-size:48px;margin-bottom:8px">✉️</div>
    <h3 style="margin:0 0 6px">Nessuna campagna ancora</h3>
    <p class="muted" style="margin:0 0 18px">Crea la prima campagna newsletter per i tuoi iscritti.</p>
    <a class="btn btn-primary" href="/admin/newsletter/new">+ Nuova campagna</a>
  </div>
<% } %>

<!-- BOZZE -->
<% if (drafts.length) { %>
<div class="card">
  <div class="card-head">
    <h3 style="margin:0;font-size:16px">📝 Bozze — da inviare (<%= drafts.length %>)</h3>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Oggetto</th>
          <th style="width:240px">Destinatari</th>
          <th style="width:140px">Creata</th>
          <th style="width:160px"></th>
        </tr>
      </thead>
      <tbody>
        <% drafts.forEach(function(c){ %>
          <tr>
            <td>
              <strong><%= c.subject %></strong>
              <% if (c.preheader) { %><div class="muted" style="font-size:12px;margin-top:3px;max-width:520px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.preheader %></div><% } %>
            </td>
            <td>
              <form method="post" action="/admin/newsletter/<%= c.id %>/send" id="sendf-<%= c.id %>"
                    onsubmit="return confirm('Inviare ora la campagna ai destinatari selezionati?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="audience" class="nl-aud-sel">
                  <option value="all" <%= c.audience==='all'?'selected':'' %>>📣 Tutti gli iscritti (<%= subStats.active %>)</option>
                  <option value="bookings" <%= c.audience==='bookings'?'selected':'' %>>🎟 Solo chi ha prenotato</option>
                  <option value="contacts" <%= c.audience==='contacts'?'selected':'' %>>✉️ Solo form contatti</option>
                </select>
              </form>
            </td>
            <td class="muted" style="white-space:nowrap;font-size:12.5px"><%= fmtDateTime(c.createdAt) %></td>
            <td class="row-actions">
              <a class="btn-ico btn-ico-open" href="/admin/newsletter/<%= c.id %>/preview" target="_blank" title="Anteprima"><%- include('../partials/ico', { name:'eye' }) %></a>
              <a class="btn-ico btn-ico-edit" href="/admin/newsletter/<%= c.id %>/edit" title="Modifica"><%- include('../partials/ico', { name:'edit' }) %></a>
              <button type="submit" form="sendf-<%= c.id %>" class="btn-ico btn-ico-send" title="Invia ora">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
              <form method="post" action="/admin/newsletter/<%= c.id %>/delete" onsubmit="return confirm('Eliminare la bozza?')" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- CRONOLOGIA -->
<% if (sent.length) { %>
<div class="card">
  <div class="card-head">
    <h3 style="margin:0;font-size:16px">📊 Cronologia invii (<%= sent.length %>)</h3>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Oggetto</th>
          <th style="width:110px">Audience</th>
          <th style="width:110px">Consegne</th>
          <th style="width:90px">Stato</th>
          <th style="width:160px">Inviata</th>
          <th style="width:120px"></th>
        </tr>
      </thead>
      <tbody>
        <% sent.forEach(function(c){ %>
          <tr>
            <td>
              <strong><%= c.subject %></strong>
              <% if (c.preheader) { %><div class="muted" style="font-size:12px;margin-top:3px;max-width:520px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.preheader %></div><% } %>
            </td>
            <td><span class="src src-<%= c.audience || 'all' %>"><%= c.audience || 'all' %></span></td>
            <td>
              <strong style="color:#1b6b3e"><%= c.successCount %></strong><span class="muted">/<%= c.totalRecipients %></span>
              <% if (c.failureCount) { %><div class="muted" style="font-size:11px;color:#8a2a1c"><%= c.failureCount %> falliti</div><% } %>
            </td>
            <td><span class="nl-tag nl-tag-<%= c.status %>"><%= c.status %></span></td>
            <td class="muted" style="white-space:nowrap;font-size:12.5px"><%= fmtDateTime(c.sentAt) %></td>
            <td class="row-actions" style="text-align:right">
              <a class="btn-ico btn-ico-open" href="/admin/newsletter/<%= c.id %>/preview" target="_blank" title="Anteprima"><%- include('../partials/ico', { name:'open' }) %></a>
              <form method="post" action="/admin/newsletter/<%= c.id %>/delete" onsubmit="return confirm('Eliminare dalla cronologia?')" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<style>
  .nl-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-top:14px}
  .nl-kpi{background:#fafbfc;border:1px solid #eef0f4;border-radius:10px;padding:14px 16px}
  .nl-kpi-accent{background:linear-gradient(135deg,#fffbe8,#fdf2c9);border-color:#ead9a8}
  .nl-kpi-lbl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#7a8190;margin-bottom:5px}
  .nl-kpi-val{font-family:'Fraunces',Georgia,serif;font-size:28px;font-weight:600;color:#1c1f26;line-height:1}

  .nl-aud-sel{
    width:100%;height:38px;padding:0 32px 0 12px;
    border:1px solid var(--line, #dde0e4);border-radius:8px;background:#fff;
    font-family:inherit;font-size:13.5px;color:#1c1f26;
    appearance:none;-webkit-appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%237a8190' d='M0 0l5 6 5-6z'/></svg>");
    background-repeat:no-repeat;background-position:right 12px center;
    cursor:pointer;transition:border-color .15s
  }
  .nl-aud-sel:hover{border-color:#1c1f26}
  .nl-aud-sel:focus{outline:2px solid #e0aa00;border-color:#e0aa00}

  .btn-ico-send{color:#1b6b3e;border:1px solid #aedabe;background:#e7f3ec}
  .btn-ico-send:hover{background:#1b6b3e;color:#fff}

  .src{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:700;background:#eef0f4;color:#5a5e6a;text-transform:uppercase;letter-spacing:.04em}
  .src-all{background:#fff3d6;color:#7a5800}
  .src-bookings{background:#d6f3df;color:#1b6b3e}
  .src-contacts{background:#e3f0ff;color:#0d5290}

  .nl-tag{display:inline-block;padding:3px 9px;border-radius:99px;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}
  .nl-tag-draft{background:#fff3d6;color:#7a5800}
  .nl-tag-sending{background:#e3f0ff;color:#0d5290}
  .nl-tag-sent{background:#d6f3df;color:#1b6b3e}
  .nl-tag-failed{background:#ffe1dc;color:#8a2a1c}
</style>
<%- include('../partials/footer') %>
