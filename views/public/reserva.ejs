<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
<style id="scx-flatpickr-css">
.flatpickr-calendar{background:#fff !important;border:1px solid #dde0e4 !important;border-radius:16px !important;box-shadow:0 6px 24px -6px rgba(0,0,0,.10) !important;font-family:"Manrope",system-ui,sans-serif !important;font-size:14px !important;width:288px !important;padding:10px 12px 4px !important;overflow:visible !important;z-index:10000 !important}
.flatpickr-calendar.arrowTop:before,.flatpickr-calendar.arrowTop:after,.flatpickr-calendar.arrowBottom:before,.flatpickr-calendar.arrowBottom:after{display:none !important}
.flatpickr-months{padding:0 !important;height:0 !important;overflow:hidden !important}
.flatpickr-month,.flatpickr-current-month,.flatpickr-prev-month,.flatpickr-next-month{display:none !important}
.flatpickr-weekday{font-size:11px !important;font-weight:700 !important;color:#5a5a5a !important;text-transform:uppercase !important;letter-spacing:.06em !important}
.flatpickr-day{border-radius:6px !important;height:28px !important;line-height:28px !important;font-size:13px !important;color:#2a2a2a !important;font-weight:500 !important;border:1px solid transparent !important}
.flatpickr-day:hover:not(.flatpickr-disabled){background:#fdf7e3 !important;border-color:#F5C518 !important}
.flatpickr-day.selected,.flatpickr-day.selected:hover{background:#F5C518 !important;border-color:#F5C518 !important;color:#2a2a2a !important;font-weight:700 !important}
.flatpickr-day.today{border-color:rgba(42,42,42,.3) !important}
.flatpickr-day.flatpickr-disabled,.flatpickr-day.nextMonthDay,.flatpickr-day.prevMonthDay{color:rgba(42,42,42,.2) !important}
.flatpickr-day.nextMonthDay,.flatpickr-day.prevMonthDay{visibility:hidden !important;pointer-events:none !important}
.flatpickr-rContainer,.flatpickr-days,.dayContainer{width:100% !important;overflow:hidden !important}
.scx-date-wrap{position:relative;display:block;width:100%}
.scx-date-wrap.scx-pg-full{grid-column:1/-1}
.scx-date-wrap input.scx-pg-input{width:100% !important;padding-right:42px !important;cursor:text !important;box-sizing:border-box !important}
.scx-cal-btn{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;padding:3px;color:#888;display:flex;align-items:center;line-height:1;transition:color .15s;z-index:2}
.scx-cal-btn:hover{color:#F5C518}
.scx-fp-header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:16px 0 6px}
.scx-fp-sel{position:relative;display:inline-flex;align-items:center}
.scx-fp-btn{display:inline-flex;align-items:center;gap:6px;background:#fafbfc;border:1px solid #dde0e4;border-radius:8px;padding:5px 10px;font-family:"Manrope",sans-serif;font-size:14px;font-weight:600;color:#2a2a2a;cursor:pointer;outline:none;white-space:nowrap;transition:border-color .15s}
.scx-fp-btn:hover{border-color:#F5C518}
.scx-fp-btn svg{flex-shrink:0;transition:transform .15s}
.scx-fp-btn.open svg{transform:rotate(180deg)}
.scx-fp-drop{position:absolute;top:calc(100% + 6px);left:0;background:#fff;border:1px solid #dde0e4;border-radius:12px;z-index:99999;min-width:130px;overflow-y:auto;padding:6px 0;display:none;list-style:none;margin:0}
.scx-fp-drop.months-drop{max-height:none;overflow-y:visible}
.scx-fp-drop.years-drop{max-height:260px;overflow-y:auto}
.scx-fp-drop.visible{display:block}
.scx-fp-drop li{list-style:none;padding:8px 14px;font-family:"Manrope",sans-serif;font-size:14px;font-weight:400;color:#2a2a2a;cursor:pointer;transition:background .12s}
.scx-fp-drop li:hover{background:#fdf7e3}
.scx-fp-drop li.active{font-weight:700;color:#2a2a2a;background:#fdf7e3}
.scx-cal-close{position:absolute;top:10px;right:10px;background:none;border:none;cursor:pointer;padding:4px;color:#888;display:flex;align-items:center;border-radius:4px;transition:color .15s}
.scx-cal-close:hover{color:#2a2a2a}
</style>
</head>
<body class="on-pack page-pack" data-pack-color="<%= plan.slug.replace('pack-','') %>">
<% if (typeof logoDefs !== 'undefined' && logoDefs) { %><%- logoDefs %><% } %>
<header class="site">
  <nav class="nav">
    <a href="/" class="logo" aria-label="Irene Monticelli — Inicio">
      <svg viewBox="0 0 1000 140" preserveAspectRatio="xMinYMid meet" aria-hidden="true"><use href="#logo-paths"/></svg>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Menú"><span></span><span></span><span></span></button>
    <div class="nav-links" id="navLinks">
      <a href="/quien-soy" data-h>Quién soy</a>
      <a href="/pro-dance" data-h>Pro Dance</a>
      <a href="/contacto" data-h>Contacto</a>
      <a href="/area-referral" class="nav-referral" data-h>Área Referidos</a>
    </div>
  </nav>
</header>

<% if (error) { %><div class="rv-err"><%= error %></div><% } %>

<section class="pk-booking">
  <div class="pk-booking-wrap" data-pack-key="<%= plan.slug %>" data-pack-price="<%= currentPrice %>">
    <div class="pk-checkout-grid">
      <!-- COLONNA SINISTRA -->
      <div class="pk-checkout-main">
        <form class="pk-form" id="rvForm" novalidate
              data-mode="<%= plan.bookingMode %>"
              data-pricing='<%- JSON.stringify(pricing) %>'
              data-days='<%- JSON.stringify(days) %>'
              data-slots='<%- JSON.stringify(slots) %>'
              data-lessons='<%- JSON.stringify(lessons || {}).replace(/'/g, "&#39;") %>'
              data-extras='<%- JSON.stringify((extras||[]).map(function(x){return {id:x.id,name:x.name,description:x.description,price:x.price,mandatory:x.mandatory};})).replace(/'/g, "&#39;") %>'
              data-discount-threshold="<%= plan.discountThreshold || 0 %>"
              data-discount-percent="<%= plan.discountPercent || 0 %>"
              data-curprice="<%= currentPrice %>">

          <!-- 1. Pack -->
          <section class="pk-block pk-block-pack">
            <h2 class="pk-block-title">Paquete</h2>
            <% /* Costruisco array completo: pack corrente + others, ordinati per sort */
               var allPacks = [{slug: plan.slug, name: plan.name, price: currentPrice, currency: plan.currency || 'EUR', current: true}]
                 .concat((others||[]).map(function(o){ return {slug:o.slug, name:o.name, price:o.price, currency:o.currency||'EUR', current:false}; }));
               /* Ordine canonico: single, red, gold, junior */
               var packOrder = {'pack-single':1,'pack-red':2,'pack-gold':3,'pack-junior':4};
               allPacks.sort(function(a,b){ return (packOrder[a.slug]||99) - (packOrder[b.slug]||99); });
            %>
            <div class="scx-pack-chips" role="radiogroup" aria-label="Paquete">
              <% allPacks.forEach(function(p){ %>
                <% if (p.current) { %>
                  <button type="button" class="scx-pchip is-selected" data-scx-pack="<%= p.slug %>" aria-checked="true">
                    <span class="scx-pchip-name"><%= p.name %></span>
                    <span class="scx-pchip-price"><%= p.price %><%= p.currency==='EUR'?'€':p.currency %></span>
                  </button>
                <% } else { %>
                  <a class="scx-pchip" href="/reserva/<%= p.slug %>" data-scx-pack="<%= p.slug %>" aria-checked="false">
                    <span class="scx-pchip-name"><%= p.name %></span>
                    <span class="scx-pchip-price"><%= p.price %><%= p.currency==='EUR'?'€':p.currency %></span>
                  </a>
                <% } %>
              <% }) %>
            </div>
            <% if (plan.description) { %>
              <p class="scx-pack-desc-text"><%= plan.description %></p>
            <% } %>
          </section>

          <!-- 2. Selezione formula (per Single: # classi) -->
          <% if (plan.bookingMode === 'single_lessons') { %>
          <section class="pk-block">
            <h2 class="pk-block-title">Fórmula</h2>
            <div class="scx-formula" id="rvFormula" role="radiogroup">
              <% (pricing.options||[]).forEach(function(o,i){ %>
                <button type="button" class="scx-fchip rv-opt<%= i===0?' is-selected':'' %>" data-count="<%= o.count %>" data-price="<%= o.price %>" aria-checked="<%= i===0?'true':'false' %>">
                  <span class="scx-fchip-name"><%= o.count %> clase<%= o.count>1?'s':'' %></span>
                  <span class="scx-fchip-price"><%= o.price %>€</span>
                </button>
              <% }) %>
            </div>
            <input type="hidden" name="count" id="rvCount" value="<%= (pricing.options&&pricing.options[0])?pricing.options[0].count:1 %>">
          </section>
          <section class="pk-block">
            <h2 class="pk-block-title">Fecha y horario de cada clase</h2>
            <div id="rvLessons"></div>
          </section>
          <% } else if (plan.bookingMode === 'red') { %>
          <section class="pk-block">
            <h2 class="pk-block-title">Para cada día: mañana o tarde</h2>
            <% var morningH = (event && event.morningHours) || '9:30 - 12:30';
               var afternoonH = (event && event.afternoonHours) || '15:30 - 18:30'; %>
            <div class="scx-red-window">
            <% var spMonths = ['ENERO','FEBRERO','MARZO','ABRIL','MAYO','JUNIO','JULIO','AGOSTO','SEPTIEMBRE','OCTUBRE','NOVIEMBRE','DICIEMBRE']; %>
            <% days.forEach(function(d){ %>
              <% var dt = new Date(d.iso+'T00:00:00');
                 var dayLabel = d.num + ' ' + spMonths[dt.getMonth()] + ' ' + dt.getFullYear(); %>
              <div class="scx-red-day">
                <div class="scx-red-day-header"><%= dayLabel %></div>
                <div class="scx-red-day-body rv-ampm" data-day="<%= d.iso %>" role="radiogroup">
                  <button type="button" class="scx-ampm-btn pk-slot" data-val="AM" aria-checked="false"><%= morningH %></button>
                  <button type="button" class="scx-ampm-btn pk-slot" data-val="PM" aria-checked="false"><%= afternoonH %></button>
                </div>
                <div class="scx-clase-label" style="margin:14px 16px 6px">LECCIÓN</div>
                <div class="scx-lecion-display" data-red-lecion="<%= d.iso %>" style="padding:0 16px 14px">-</div>
                <input type="hidden" name="day_<%= d.iso %>" value="">
              </div>
            <% }) %>
            </div>
          </section>
          <% } else if (plan.bookingMode === 'junior') { %>
          <section class="pk-block">
            <h2 class="pk-block-title">Programa</h2>
            <p class="pk-pack-desc">Todos los días por la mañana, de <strong>9:30 a 12:30</strong> (<%= days.length %> días). No hay que elegir horario.</p>
          </section>
          <% } else { %>
          <section class="pk-block">
            <h2 class="pk-block-title">Programa</h2>
            <p class="pk-pack-desc">Acceso libre a todas las clases de los <%= days.length %> días. No hay que elegir nada.</p>
          </section>
          <% } %>

          <!-- 3. Numero partecipanti -->
          <section class="pk-block scx-participants-block">
            <h2 class="pk-block-title">Participantes</h2>
            <p class="scx-participants-note">Mismo paquete para todos los participantes. Hasta 20 personas por reserva.</p>
            <div class="scx-personas" id="rvPartCounter" role="group" aria-label="Número de participantes">
              <button type="button" data-act="dec" aria-label="Restar participante">−</button>
              <span class="scx-pers-display" id="rvPartCount">1</span>
              <button type="button" data-act="inc" aria-label="Sumar participante">+</button>
            </div>
          </section>

          <!-- 5. Partecipanti (accordion dinamico) -->
          <section class="pk-block">
            <h2 class="pk-block-title">Datos de los participantes</h2>
            <p class="pk-pack-desc" style="font-size:13.5px;color:#7a8190;margin:0 0 14px">
              Para cada participante, rellena los datos. Para menores de 18 años se pedirá el tutor abajo.
            </p>
            <div id="rvParticipants"></div>
          </section>


          <!-- 7. Extras -->
          <% if (extras && extras.length) { %>
          <section class="pk-block pk-block-extras">
            <h2 class="pk-block-title">Extras</h2>
            <p class="scx-extras-subtitle">Los obligatorios se aplican por cada participante. Los opcionales también se multiplican por el número de participantes.</p>
            <div class="rv-extras-list">
              <% extras.forEach(function(x){ %>
                <label class="rv-extra scx-extra <%= x.mandatory?'is-mandatory':'' %>" data-extra-id="<%= x.id %>" data-extra-price="<%= x.price %>">
                  <input type="checkbox" name="extras" value="<%= x.id %>" <%= x.mandatory?'checked disabled':'' %> style="position:absolute;opacity:0;pointer-events:none">
                  <span class="scx-extra-check" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2.4 6.3 5 8.7 9.6 3.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="scx-extra-body">
                    <span class="scx-extra-name"><%= x.name %></span>
                    <% if (x.description) { %><span class="scx-extra-desc"><%= x.description %></span><% } %>
                  </span>
                  <span class="scx-extra-price">+<%= x.price %>€</span>
                </label>
              <% }) %>
            </div>
            <% if (extras.some(function(x){return x.mandatory;})) { %>
              <% extras.filter(function(x){return x.mandatory}).forEach(function(x){ %>
                <input type="hidden" name="extras" value="<%= x.id %>">
              <% }) %>
            <% } %>
            <style>
              .rv-extras-list{display:flex;flex-direction:column;gap:10px;margin-top:6px}
              .rv-extra{display:flex;gap:14px;align-items:center;padding:14px 16px;
                border:1px solid rgba(42,42,42,.12);border-radius:8px;cursor:pointer;
                transition:border-color .25s ease,background .25s ease}
              .rv-extra:hover{border-color:rgba(224,170,0,.5);background:#fffdf5}
              .rv-extra input[type=checkbox]{flex-shrink:0;width:18px;height:18px;cursor:pointer;accent-color:#e0aa00}
              .rv-extra input[type=checkbox]:checked + .rv-extra-body .rv-extra-name{font-weight:600}
              .rv-extra.is-mandatory{background:#fdf8e8;border-color:#ead9a8;cursor:default}
              .rv-extra.is-mandatory:hover{background:#fdf8e8}
              .rv-extra-body{flex:1;display:flex;flex-direction:column;gap:2px}
              .rv-extra-name{font-size:14.5px;color:#1c1f26}
              .rv-extra-desc{font-size:12.5px;color:#7a8190;line-height:1.45}
              .rv-extra-price{font-size:15px;font-weight:600;color:#1c1f26;white-space:nowrap;text-align:right}
              .rv-extra-badge{display:inline-block;background:#e0aa00;color:#1c1408;font-size:9.5px;
                letter-spacing:.12em;text-transform:uppercase;font-weight:700;padding:2px 7px;
                border-radius:99px;margin-left:6px;vertical-align:middle}
            </style>
          </section>
          <% } %>

          <!-- Código de descuento (referral) -->
          <section class="pk-block pk-block-refcode">
            <h2 class="pk-block-title">¿Tienes un código de descuento?</h2>
            <p class="pk-pack-desc" style="font-size:13.5px;color:#7a8190;margin:0 0 12px">Introduce un código de afiliado/promocional (opcional).</p>
            <div class="rv-refcode-row">
              <input type="text" name="referralCode" id="rvRefCodeInput" placeholder="Ej. MARIA20" autocomplete="off" spellcheck="false">
              <button type="button" class="rv-refcode-btn" id="rvRefCodeApply">Aplicar</button>
            </div>
            <div class="rv-refcode-status" id="rvRefCodeStatus" hidden></div>
            <style>
              .pk-block-refcode{background:linear-gradient(135deg,#fffbe8 0%,#fff 60%);border:0;padding:18px 20px;border-radius:14px;margin-bottom:18px}
              .rv-refcode-row{display:flex;gap:10px;align-items:stretch}
              .rv-refcode-row input{flex:1;height:48px;padding:0 16px;border:1.5px solid rgba(42,42,42,.15);border-radius:10px;background:#fff;font-family:"Manrope",system-ui,sans-serif;font-size:15px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#2a2a2a;outline:none;transition:border-color .2s}
              .rv-refcode-row input:focus{border-color:#F5C518;box-shadow:0 0 0 3px rgba(245,197,24,.18)}
              .rv-refcode-row input::placeholder{font-weight:400;letter-spacing:.04em;color:#aaa}
              .rv-refcode-btn{padding:0 22px;background:#1c1f26;color:#fff;border:0;border-radius:10px;font-family:inherit;font-size:13.5px;font-weight:600;letter-spacing:.04em;cursor:pointer;transition:.2s;text-transform:uppercase}
              .rv-refcode-btn:hover{background:#000;transform:translateY(-1px)}
              .rv-refcode-btn.is-applied{background:#1b6b3e;cursor:default}
              .rv-refcode-status{margin-top:10px;padding:10px 14px;border-radius:8px;font-size:13.5px;font-weight:500;display:flex;align-items:center;gap:8px}
              .rv-refcode-status.ok{background:#e7f3ec;color:#1b6b3e;border:1px solid #aedabe}
              .rv-refcode-status.err{background:#fef0ec;color:#a8351c;border:1px solid #f3c5b9}
            </style>
          </section>

          <!-- 4. Datos del pagante -->
          <section class="pk-block">
            <h2 class="pk-block-title">Datos del pagante</h2>
            <p class="pk-pack-desc" style="font-size:13.5px;color:#7a8190;margin:0 0 14px">Quién paga la reserva y recibe la confirmación y la factura.</p>
            <div class="pk-row">
              <div class="pk-field"><input type="text" name="payerFirstName" autocomplete="given-name" placeholder="Nombre" required></div>
              <div class="pk-field"><input type="text" name="payerLastName" autocomplete="family-name" placeholder="Apellidos" required></div>
            </div>
            <div class="pk-row">
              <div class="pk-field"><input type="email" name="payerEmail" autocomplete="email" placeholder="Email" required></div>
              <div class="pk-field"><input type="tel" name="payerPhone" autocomplete="tel" placeholder="Teléfono" required></div>
            </div>
            <div class="pk-row pk-row-1" style="display:grid;grid-template-columns:1fr;gap:22px">
              <div class="pk-field" style="display:flex;flex-direction:column;gap:8px">
                <label class="scx-pg-label" for="rvPayerBd" style="font-family:'Manrope',system-ui,sans-serif;font-size:11px;font-weight:700;color:#5a5a5a;text-transform:uppercase;letter-spacing:.16em;margin:0">Fecha de nacimiento</label>
                <input type="date" id="rvPayerBd" name="payerBirthDate" data-payer-birth class="scx-pg-input" required autocomplete="bday" placeholder="dd/mm/aaaa">
              </div>
            </div>

            <!-- Datos para factura (opcional) — design scx-factura-card -->
            <div class="scx-factura-card">
              <label class="scx-consent scx-factura-label" for="rvBillToggle">
                <input type="checkbox" id="rvBillToggle">
                <span class="scx-consent-box" aria-hidden="true"></span>
                <span class="scx-factura-text">
                  <strong>Necesito factura</strong>
                  <span class="scx-factura-desc">Si lo activas, te pediremos los datos de facturación (dirección + NIF). Si no, recibirás solo el ticket de Stripe.</span>
                </span>
              </label>
            </div>
            <div class="scx-factura-form rv-billing-fields" id="rvBillFields">
              <input type="text" name="billingAddress" placeholder="Dirección (calle, número, piso)" autocomplete="street-address">
              <div class="scx-factura-row">
                <input type="text" name="billingCity" placeholder="Ciudad" autocomplete="address-level2">
                <input type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" name="billingZip" placeholder="Código postal" autocomplete="postal-code">
                <div class="scx-factura-country"><input type="text" name="billingCountry" placeholder="ES" value="ES" autocomplete="country"></div>
              </div>
              <input type="text" name="billingNif" placeholder="NIF / CIF / DNI">
            </div>

            <div class="scx-consents">
              <label class="rv-consent scx-consent" for="rvIc">
                <input type="checkbox" name="imageConsent" id="rvIc" required>
                <span class="scx-consent-box" aria-hidden="true"></span>
                <span>Autorizo a <strong>Pro Dance Experience</strong> la toma de imágenes (foto/video) para difusión del evento en Instagram y página web.</span>
              </label>
              <label class="rv-consent scx-consent" for="rvDc">
                <input type="checkbox" name="dataConsent" id="rvDc" required>
                <span class="scx-consent-box" aria-hidden="true"></span>
                <span>Declaro que los datos proporcionados son correctos y acepto las <strong>condiciones de participación</strong>.</span>
              </label>
              <label class="rv-consent scx-consent" for="rvHc">
                <input type="checkbox" name="healthConsent" id="rvHc" required>
                <span class="scx-consent-box" aria-hidden="true"></span>
                <span>Declaro que todos los participantes tienen un <strong>nivel adecuado del estado de salud física</strong> para participar en la actividad.</span>
              </label>
              <!-- Consent minorenni: appare quando c'è almeno un partecipante minorenne -->
              <label class="rv-consent scx-consent rv-hide" id="rvMinorConsent" for="rvMc">
                <input type="checkbox" name="minorConsent" id="rvMc">
                <span class="scx-consent-box" aria-hidden="true"></span>
                <span>Como pagante <strong>autorizo la participación de los menores</strong> indicados arriba y asumo la responsabilidad como tutor legal durante toda la actividad.</span>
              </label>
            </div>
          </section>

          <!-- 8. Método de pago — Stripe Payment Element (auto-include tutti i metodi attivi sul tuo account Stripe) -->
          <section class="pk-block">
            <h2 class="pk-block-title">Método de pago</h2>
            <div class="scx-pay-wrap">
              <div id="scx-pay-element" class="scx-pay-element"><div class="scx-pay-element-placeholder">Cargando métodos de pago seguros…</div></div>
              <div id="scx-pay-message" class="scx-pay-message" role="alert" hidden></div>
              <p class="scx-pay-note">Pago seguro · cifrado SSL · procesado por Stripe</p>
            </div>
          </section>

          <div class="pk-confirm-left">
            <button type="submit" class="pk-confirm-final is-disabled" id="rvSubmitL">Confirmar y pagar</button>
          </div>

          <div class="scx-refund-box" role="note">
            <p class="scx-refund-title">Política de reembolso</p>
            <p class="scx-refund-text">Dispones de <strong><%= refundDays %> días</strong> desde la fecha de tu reserva para solicitar el reembolso íntegro escribiendo a <a href="mailto:info@irenemonticelli.com" class="scx-refund-link">info@irenemonticelli.com</a>. Pasado este plazo no se aceptan devoluciones.</p>
          </div>
        </form>

        <div class="pk-embed-wrap" id="rvEmbedded" hidden>
          <button class="pk-embed-back" type="button" id="rvEmbedBack" aria-label="Volver">← Volver al formulario</button>
          <h2 class="pk-embed-title">Pago seguro</h2>
          <div id="rvEmbedError" class="pk-embed-error" hidden></div>
          <div class="pk-embed-loading" id="rvEmbedLoading">Cargando el pago seguro...</div>
          <div id="embed-payment"></div>
        </div>
      </div>

      <!-- COLONNA DESTRA: summary -->
      <aside class="pk-summary-sticky" id="rvSummary">
        <button class="pk-summary-trigger" id="rvSumTrigger" type="button" aria-expanded="false">
          <span class="pk-trigger-meta">
            <span class="pk-trigger-lbl">Resumen</span>
            <span class="pk-trigger-amt">Total <strong id="rvTotalMobile"><%= currentPrice %>€</strong></span>
          </span>
          <span class="pk-trigger-arrow" aria-hidden="true">▲</span>
        </button>
        <div class="pk-summary-card ck-sumcard">
          <h3 class="pk-summary-title ck-sum-title">Resumen de tu reserva</h3>
          <div class="pk-summary-rows ck-sum-rows">
            <div class="pk-summary-row ck-sum-row"><span class="pk-summary-label ck-sum-k">Paquete</span><span class="pk-summary-value ck-sum-v" data-sum-pack><%= plan.name %></span></div>
            <% if (plan.bookingMode === 'single_lessons') { %>
            <div class="pk-summary-row ck-sum-row" id="scx-sum-formula-row"><span class="pk-summary-label ck-sum-k">Fórmula</span><span class="pk-summary-value ck-sum-v" data-sum-detalle>1 clase</span></div>
            <% } %>
            <div class="pk-summary-row ck-sum-row"><span class="pk-summary-label ck-sum-k">Fecha y horario</span><span class="pk-summary-value ck-sum-v pk-summary-empty" id="rvSumDetail" data-sum-fechahorario>—</span></div>
            <div class="pk-summary-row ck-sum-row"><span class="pk-summary-label ck-sum-k">Participantes</span><span class="pk-summary-value ck-sum-v" id="rvSumParts" data-sum-pers>1</span></div>
            <div class="pk-summary-row ck-sum-row"><span class="pk-summary-label ck-sum-k">Precio por participante</span><span class="pk-summary-value ck-sum-v" data-sum-unit><%= currentPrice %>€</span></div>
            <% if (extras && extras.some(function(x){return x.mandatory;})) { %>
            <div class="pk-summary-row ck-sum-row"><span class="pk-summary-label ck-sum-k">Seguro obligatorio</span><span class="pk-summary-value ck-sum-v" data-sum-seguro>+20€</span></div>
            <% } %>
            <div class="pk-summary-row ck-sum-row rv-sum-refcode" id="rvSumRefcodeRow" hidden style="color:#1b6b3e">
              <span class="pk-summary-label ck-sum-k">Código <span id="rvSumRefcodeName" style="font-weight:700"></span></span>
              <span class="pk-summary-value ck-sum-v" id="rvSumRefcodeAmt">−0€</span>
            </div>
          </div>
          <div class="pk-summary-total">
            <span class="pk-summary-total-label">Total</span>
            <span class="pk-summary-total-amount" id="rvTotal"><%= currentPrice %>€</span>
          </div>
          <button type="submit" form="rvForm" class="pk-confirm-final is-disabled" id="rvSubmitR">Confirmar y pagar</button>
          <div class="pk-secure-note">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 1l9 4v6c0 5.5-4 10.7-9 12-5-1.3-9-6.5-9-12V5l9-4z"/></svg>
            Pago seguro · cifrado SSL · Stripe
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Modale "Prenotazioni disabilitate" -->
<div class="pk-bk-off" id="rvBookingsOff" hidden role="dialog" aria-modal="true" aria-labelledby="rvBkOffTitle">
  <div class="pk-bk-off-backdrop" id="rvBkOffBackdrop"></div>
  <div class="pk-bk-off-box">
    <button type="button" class="pk-bk-off-close" id="rvBkOffClose" aria-label="Cerrar">×</button>
    <div class="pk-bk-off-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 16h.01"/>
      </svg>
    </div>
    <h3 id="rvBkOffTitle">Reservas no disponibles por el momento</h3>
    <p>Las reservas online están <strong>temporalmente desactivadas</strong>. Estamos ultimando los preparativos para abrirlas pronto.</p>
    <p>Para reservar tu plaza ahora o para cualquier información puedes contactarnos directamente:</p>
    <div class="pk-bk-off-actions">
      <a class="pk-bk-off-cta primary" href="/contacto">Escríbenos por el formulario →</a>
      <% if (contactPhone) { %>
        <a class="pk-bk-off-cta" href="tel:<%= contactPhone.replace(/\s+/g,'') %>">Llamar al <%= contactPhone %></a>
      <% } %>
      <% if (contactEmail) { %>
        <a class="pk-bk-off-cta ghost" href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
      <% } %>
    </div>
    <p class="pk-bk-off-foot">Gracias por tu paciencia. Volveremos pronto.</p>
  </div>
</div>

<script>
(function(){
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.nav-toggle');
    if (btn) {
      e.preventDefault();
      var links = document.getElementById('navLinks');
      btn.classList.toggle('open');
      if (links) links.classList.toggle('open');
      return;
    }
    var link = e.target.closest('.nav-links a');
    if (link) {
      var openLinks = document.querySelector('.nav-links.open');
      if (openLinks) openLinks.classList.remove('open');
      var openBtn = document.querySelector('.nav-toggle.open');
      if (openBtn) openBtn.classList.remove('open');
    }
  });
})();

(function(){
  var form = document.getElementById('rvForm');
  var mode = form.dataset.mode;
  var pricing = JSON.parse(form.dataset.pricing||'{}');
  var DAYS = JSON.parse(form.dataset.days||'[]');
  var SLOTS = JSON.parse(form.dataset.slots||'[]');
  var LESSONS = JSON.parse((form.dataset.lessons||'{}').replace(/&#39;/g,"'"));
  var EXTRAS = JSON.parse((form.dataset.extras||'[]').replace(/&#39;/g,"'"));
  var curPrice = parseFloat(form.dataset.curprice)||0;
  var DISC_THR = parseInt(form.dataset.discountThreshold||'0', 10);
  var DISC_PCT = parseFloat(form.dataset.discountPercent||'0');
  var MAX_PARTS = 20;

  // ===== Riferimenti elementi summary (devono esistere PRIMA della prima sync()) =====
  var totalEl = document.getElementById('rvTotal');
  var detEl = document.getElementById('rvSumDetail');
  var sumPartsEl = document.getElementById('rvSumParts');
  var subs = [document.getElementById('rvSubmitL'), document.getElementById('rvSubmitR')];

  // ---- State ----
  // participants: array di oggetti, gli input vivono nel DOM (querySelector); qui solo lo "stato" minimo
  // tutors: array di oggetti (firstName, lastName, email, phone, relationship)
  var STATE = {
    perParticipant: curPrice,  // prezzo per partecipante (cambia con la fórmula Single)
    participantsCount: 1,
    tutors: [],                // [{firstName, lastName, email, phone, relationship}]
    openParticipantIdx: 0,     // accordion aperto
    openTutorIdx: -1,
  };

  // ===== Helpers UI =====
  function escapeHtml(s){ return String(s||'').replace(/[&<>"]/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); }
  function ageYears(isoOrDate){
    if (!isoOrDate) return null;
    var b = (isoOrDate instanceof Date) ? isoOrDate : new Date(isoOrDate);
    if (isNaN(b.getTime())) return null;
    var n = new Date(), a = n.getFullYear() - b.getFullYear();
    var m = n.getMonth() - b.getMonth();
    if (m < 0 || (m===0 && n.getDate() < b.getDate())) a--;
    return a;
  }
  function isValidEmail(s){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s||''); }

  // ===== Single Class — formula + lessons =====
  /* Full Spanish date label es. "29 Julio 2026" come design */
  var SP_MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  function datePills(){return DAYS.map(function(d){
    var dt = new Date(d.iso+'T00:00:00');
    var label = d.num + ' ' + (SP_MONTHS[dt.getMonth()] || d.mon) + ' ' + dt.getFullYear();
    return '<button type="button" class="scx-date pk-date" data-date="'+d.iso+'" role="radio" aria-checked="false"><span class="pk-date-inline">'+label+'</span></button>';
  }).join('');}
  function slotPills(){return SLOTS.map(function(s){return '<button type="button" class="scx-slot pk-slot" data-slot="'+s+'" role="radio" aria-checked="false">'+s+'</button>';}).join('');}
  function dayIndexOf(iso){ for(var i=0;i<DAYS.length;i++){ if(DAYS[i].iso===iso) return i+1; } return 0; }
  function lessonAt(iso, time){ var d=dayIndexOf(iso); if(!d||!LESSONS[d]) return null; return LESSONS[d][time] || null; }
  function lessonsForFascia(dayIndex, isAfternoon){
    if (!LESSONS[dayIndex]) return [];
    var out = [];
    Object.keys(LESSONS[dayIndex]).forEach(function(time){
      var l = LESSONS[dayIndex][time];
      if (l.isPause) return;
      if (!!l.isAfternoon === !!isAfternoon) out.push({ time: time, title: l.title, professor: l.professor });
    });
    out.sort(function(a,b){ return a.time.localeCompare(b.time); });
    return out;
  }
  if (mode === 'single_lessons') {
    var opts = document.querySelectorAll('.rv-opt');
    var countInp = document.getElementById('rvCount');
    var box = document.getElementById('rvLessons');
    function renderLessons(n){
      var h='';
      for (var i=0; i<n; i++) {
        h += '<div class="rv-lesson scx-clase">'+
               '<div class="scx-clase-header"><span class="scx-clase-title">CLASE '+(i+1)+'</span></div>'+
               '<div class="scx-clase-body">'+
                 '<div class="scx-clase-label">FECHA</div>'+
                 '<div class="scx-dyn-dates pk-dates rv-d" data-i="'+i+'">'+datePills()+'</div>'+
                 '<div class="scx-clase-label">HORARIO</div>'+
                 '<div class="scx-dyn-slots pk-slots-row rv-s" data-i="'+i+'">'+slotPills()+'</div>'+
                 '<div class="scx-clase-label">LECCIÓN</div>'+
                 '<div class="scx-lecion-display" data-lecion-display="'+i+'">-</div>'+
                 '<input type="hidden" name="lesson_day_'+i+'" value="">'+
                 '<input type="hidden" name="lesson_slot_'+i+'" value="">'+
               '</div>'+
             '</div>';
      }
      box.innerHTML = h;
    }
    function selOpt(btn){
      opts.forEach(function(o){o.classList.remove('is-selected'); o.setAttribute('aria-checked','false');});
      btn.classList.add('is-selected'); btn.setAttribute('aria-checked','true');
      countInp.value = btn.dataset.count;
      STATE.perParticipant = parseFloat(btn.dataset.price)||0;
      renderLessons(parseInt(btn.dataset.count, 10));
      sync();
    }
    opts.forEach(function(o){ o.addEventListener('click', function(){ selOpt(o); }); });
    if (opts[0]) selOpt(opts[0]);
    function updateLecionDisplay(idx){
      var d = form.querySelector('input[name="lesson_day_'+idx+'"]').value;
      var s = form.querySelector('input[name="lesson_slot_'+idx+'"]').value;
      var lecEl = box.querySelector('[data-lecion-display="'+idx+'"]');
      if (!lecEl) return;
      if (d && s) {
        var l = lessonAt(d, s);
        lecEl.textContent = l ? (l.title + (l.professor ? ' · ' + l.professor : '')) : '-';
      } else lecEl.textContent = '-';
    }
    box.addEventListener('click', function(e){
      var dt = e.target.closest('.pk-date'), sl = e.target.closest('.pk-slot');
      if (dt) {
        var c = dt.closest('.rv-d');
        c.querySelectorAll('.pk-date').forEach(function(x){x.classList.remove('is-selected');x.setAttribute('aria-checked','false');});
        dt.classList.add('is-selected'); dt.setAttribute('aria-checked','true');
        c.parentNode.querySelector('input[name="lesson_day_'+c.dataset.i+'"]').value = dt.dataset.date;
        updateLecionDisplay(parseInt(c.dataset.i, 10));
        sync();
      }
      if (sl) {
        var c2 = sl.closest('.rv-s');
        c2.querySelectorAll('.pk-slot').forEach(function(x){x.classList.remove('is-selected');x.setAttribute('aria-checked','false');});
        sl.classList.add('is-selected'); sl.setAttribute('aria-checked','true');
        c2.parentNode.querySelector('input[name="lesson_slot_'+c2.dataset.i+'"]').value = sl.dataset.slot;
        updateLecionDisplay(parseInt(c2.dataset.i, 10));
        sync();
      }
    });
  }

  // ===== Red — AM/PM per giorno + LECCIÓN display per giorno =====
  if (mode === 'red') {
    function updateRedLecion(dayIso, fascia){
      var lecEl = document.querySelector('[data-red-lecion="'+dayIso+'"]');
      if (!lecEl) return;
      var dayIdx = 0;
      DAYS.forEach(function(d, i){ if (d.iso === dayIso) dayIdx = i + 1; });
      if (!dayIdx || !fascia) { lecEl.textContent = '-'; return; }
      var isAfternoon = (fascia === 'PM');
      var ls = lessonsForFascia(dayIdx, isAfternoon);
      if (!ls.length) { lecEl.textContent = '-'; return; }
      lecEl.innerHTML = ls.map(function(x){
        return '<div style="font-size:13.5px;color:#5a5a5a;line-height:1.6">'+escapeHtml(x.time)+' — '+escapeHtml(x.title)+(x.professor?' · '+escapeHtml(x.professor):'')+'</div>';
      }).join('');
    }
    document.querySelectorAll('.rv-ampm').forEach(function(row){
      row.addEventListener('click', function(e){
        var b = e.target.closest('.pk-slot'); if (!b) return;
        row.querySelectorAll('.pk-slot').forEach(function(x){x.classList.remove('is-selected');x.setAttribute('aria-checked','false');});
        b.classList.add('is-selected'); b.setAttribute('aria-checked','true');
        var dayIso = row.dataset.day;
        row.parentNode.querySelector('input[name="day_'+dayIso+'"]').value = b.dataset.val;
        updateRedLecion(dayIso, b.dataset.val);
        sync();
      });
    });
  }

  // Billing toggle (scx-factura-card → scx-factura-form)
  (function(){
    var t = document.getElementById('rvBillToggle');
    var f = document.getElementById('rvBillFields');
    if (t && f) {
      t.addEventListener('change', function(){
        if (t.checked) { f.classList.add('is-open'); f.style.display='flex'; }
        else { f.classList.remove('is-open'); f.style.display='none'; }
        sync();
      });
    }
  })();

  // Metodo pagamento visivo
  document.querySelectorAll('.pk-pay-row-head').forEach(function(h){
    h.addEventListener('click', function(){
      document.querySelectorAll('.pk-pay-row').forEach(function(r){ r.classList.remove('is-active'); });
      document.querySelectorAll('.pk-pay-row-head').forEach(function(x){ x.setAttribute('aria-selected','false'); });
      h.closest('.pk-pay-row').classList.add('is-active'); h.setAttribute('aria-selected','true');
    });
  });

  // ===== Counter partecipanti =====
  var partCounter = document.getElementById('rvPartCounter');
  var partCountEl = document.getElementById('rvPartCount');
  partCounter.addEventListener('click', function(e){
    var b = e.target.closest('button[data-act]'); if (!b) return;
    var n = STATE.participantsCount;
    if (b.dataset.act === 'inc') n = Math.min(MAX_PARTS, n+1);
    else n = Math.max(1, n-1);
    if (n === STATE.participantsCount) return;
    STATE.participantsCount = n;
    partCountEl.textContent = n;
    renderParticipants();
    sync();
  });

  // ===== Partecipanti accordion =====
  var partsBox = document.getElementById('rvParticipants');
  function renderParticipants(){
    // Salva valori esistenti prima di rerender
    var existing = [];
    partsBox.querySelectorAll('.rv-part').forEach(function(el){
      existing.push({
        firstName: el.querySelector('input[data-fld=firstName]').value,
        lastName:  el.querySelector('input[data-fld=lastName]').value,
        birthDate: el.querySelector('input[data-fld=birthDate]').value,
        address:   el.querySelector('input[data-fld=address]').value,
        city:      el.querySelector('input[data-fld=city]').value,
        zip:       el.querySelector('input[data-fld=zip]').value,
        country:   el.querySelector('input[data-fld=country]') ? el.querySelector('input[data-fld=country]').value : 'ES',
        email:     el.querySelector('input[data-fld=email]')   ? el.querySelector('input[data-fld=email]').value : '',
        phone:     el.querySelector('input[data-fld=phone]')   ? el.querySelector('input[data-fld=phone]').value : '',
        tutorIdx:  (function(){ var r=el.querySelector('input[name^="participant_tutor_"]:checked'); return r ? r.value : ''; })(),
      });
    });

    var html = '';
    for (var i=0; i<STATE.participantsCount; i++) {
      var p = existing[i] || {};
      html += '<div class="rv-part scx-participant-card" data-pi="'+i+'">'+
        '<div class="rv-part-head scx-participant-header" data-toggle="'+i+'">'+
          '<span class="scx-participant-title">Participante '+(i+1)+'</span>'+
          '<span class="rv-part-status" data-status style="display:none"></span>'+
          '<button type="button" class="scx-participant-toggle" aria-expanded="true">'+
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>'+
          '</button>'+
        '</div>'+
        '<div class="rv-part-body scx-participant-body">'+
          '<div class="scx-participant-grid">'+
            '<input class="scx-pg-input" type="text" data-fld="firstName" placeholder="Nombre" value="'+escapeHtml(p.firstName||'')+'">'+
            '<input class="scx-pg-input" type="text" data-fld="lastName" placeholder="Apellidos" value="'+escapeHtml(p.lastName||'')+'">'+
            '<input class="scx-pg-input scx-pg-full" type="text" data-fld="address" placeholder="Dirección de residencia (calle y número)" value="'+escapeHtml(p.address||'')+'">'+
            '<div class="scx-pg-row3">'+
              '<input class="scx-pg-input" type="text" data-fld="city" placeholder="Ciudad" value="'+escapeHtml(p.city||'')+'">'+
              '<input class="scx-pg-input" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" data-fld="zip" placeholder="Código postal" value="'+escapeHtml(p.zip||'')+'">'+
              '<input class="scx-pg-input" type="text" data-fld="country" placeholder="ES" value="'+escapeHtml(p.country||'ES')+'">'+
            '</div>'+
            '<input class="scx-pg-input scx-minor-hide" type="tel" inputmode="numeric" data-fld="phone" placeholder="Teléfono" value="'+escapeHtml(p.phone||'')+'">'+
            '<input class="scx-pg-input scx-minor-hide" type="email" data-fld="email" placeholder="Email" value="'+escapeHtml(p.email||'')+'">'+
            '<label class="scx-pg-full scx-pg-label" style="font-family:\'Manrope\',system-ui,sans-serif;font-size:11px;font-weight:700;color:#5a5a5a;text-transform:uppercase;letter-spacing:.16em;margin:8px 0 -4px">Fecha de nacimiento</label>'+
            '<input class="scx-pg-input scx-pg-full" type="date" data-fld="birthDate" data-participant-birth placeholder="dd/mm/aaaa" value="'+escapeHtml(p.birthDate||'')+'">'+
            '<div class="scx-minor-tutor-note scx-minor-hide-inverse rv-hide" data-minor-note>'+
              'Este participante es menor de edad. <strong>El pagante actúa como tutor responsable.</strong>'+
            '</div>'+
          '</div>'+
        '</div>'+
      '</div>';
    }
    partsBox.innerHTML = html;
    // Restore tutor selection (re-render then re-fill)
    partsBox.querySelectorAll('.rv-part').forEach(function(el, idx){
      var prev = existing[idx];
      updateTutorOptions(idx);
      if (prev && prev.tutorIdx !== '') {
        var rb = el.querySelector('input[name="participant_tutor_'+idx+'"][value="'+prev.tutorIdx+'"]');
        if (rb) rb.checked = true;
      }
    });
    // Tutte le card aperte di default (design pattern); collassa tutte tranne openParticipantIdx
    if (STATE.openParticipantIdx >= STATE.participantsCount) STATE.openParticipantIdx = 0;
    partsBox.querySelectorAll('.rv-part').forEach(function(c, k){
      c.classList.add('is-open');  // legacy class per il vecchio CSS
      var body = c.querySelector('.rv-part-body');
      if (k !== STATE.openParticipantIdx) {
        c.classList.add('is-collapsed');
        if (body) body.classList.add('is-collapsed');
      }
    });
    refreshAllStatuses();
  }
  partsBox.addEventListener('click', function(e){
    var t = e.target.closest('[data-toggle]'); if (!t) return;
    var idx = parseInt(t.dataset.toggle, 10);
    var card = t.closest('.rv-part');
    var body = card.querySelector('.rv-part-body');
    var wasCollapsed = card.classList.contains('is-collapsed');
    if (wasCollapsed) {
      card.classList.remove('is-collapsed');
      if (body) body.classList.remove('is-collapsed');
      STATE.openParticipantIdx = idx;
    } else {
      card.classList.add('is-collapsed');
      if (body) body.classList.add('is-collapsed');
    }
  });
  partsBox.addEventListener('change', function(e){
    var inp = e.target.closest('input[data-fld=birthDate]');
    if (inp) onBirthChange(inp);
    sync();
    refreshAllStatuses();
  });
  partsBox.addEventListener('input', function(){ sync(); refreshAllStatuses(); });

  function onBirthChange(inp){
    var card = inp.closest('.rv-part');
    var age = ageYears(inp.value);
    var minor = (age != null && age < 18);
    var noteBox = card.querySelector('[data-minor-note]');
    if (minor) {
      card.classList.add('scx-is-minor');
      // scx-minor-hide CSS: nasconde email/phone — svuota anche i valori
      card.querySelectorAll('.scx-minor-hide').forEach(function(x){ if (x.tagName === 'INPUT') x.value=''; });
      if (noteBox) noteBox.classList.remove('rv-hide');
    } else {
      card.classList.remove('scx-is-minor');
      if (noteBox) noteBox.classList.add('rv-hide');
    }
    showHideTutorsSection();
  }

  function isParticipantComplete(card){
    var fn = card.querySelector('input[data-fld=firstName]').value.trim();
    var ln = card.querySelector('input[data-fld=lastName]').value.trim();
    var bd = card.querySelector('input[data-fld=birthDate]').value;
    var ad = card.querySelector('input[data-fld=address]').value.trim();
    var ci = card.querySelector('input[data-fld=city]').value.trim();
    var zp = card.querySelector('input[data-fld=zip]').value.trim();
    if (fn.length<2 || ln.length<2 || !bd || !ad || !ci || !zp) return false;
    var age = ageYears(bd);
    if (age == null) return false;
    if (age < 18) {
      return true;  // minore: nessun campo aggiuntivo, il pagante è il tutor
    } else {
      var em = card.querySelector('input[data-fld=email]').value.trim();
      var ph = card.querySelector('input[data-fld=phone]').value.trim();
      return isValidEmail(em) && !!ph;
    }
  }
  function refreshAllStatuses(){
    partsBox.querySelectorAll('.rv-part').forEach(function(card){
      var st = card.querySelector('[data-status]');
      var bd = card.querySelector('input[data-fld=birthDate]').value;
      var age = ageYears(bd);
      var badge = '';
      if (age != null) {
        if (age < 18) badge = '<span class="rv-part-badge rv-part-badge-minor">menor</span>';
        else badge = '<span class="rv-part-badge rv-part-badge-adult">adulto</span>';
      }
      var ok = isParticipantComplete(card);
      var okBadge = ok ? '<span class="rv-part-badge rv-part-badge-ok">completo</span>'
                       : '<span class="rv-part-badge rv-part-badge-incomplete">incompleto</span>';
      st.innerHTML = badge + ' ' + okBadge;
    });
  }

  // ===== Consent minorenni: appare solo se almeno un partecipante è minore =====
  // (Il tutore è automaticamente il pagante — niente sezione tutor separata)
  var minorConsentBox = document.getElementById('rvMinorConsent');
  var minorConsentCb = document.getElementById('rvMc');
  function showHideTutorsSection(){
    var hasMinor = false;
    partsBox.querySelectorAll('.rv-part').forEach(function(card){
      var bd = card.querySelector('input[data-fld=birthDate]').value;
      var age = ageYears(bd);
      if (age != null && age < 18) hasMinor = true;
    });
    if (hasMinor) {
      minorConsentBox.classList.remove('rv-hide');
      minorConsentCb.required = true;
    } else {
      minorConsentBox.classList.add('rv-hide');
      minorConsentCb.required = false;
      minorConsentCb.checked = false;
    }
  }
  function updateTutorOptions(){}  // no-op: nessuna selezione tutor — il pagante è il tutor di tutti i minori

  // ===== Extras =====
  function extrasInfo(){
    var sum = 0, rows = [];
    EXTRAS.forEach(function(x){
      var cb = form.querySelector('input[type=checkbox][name="extras"][value="'+x.id+'"]');
      var on = x.mandatory || (cb && cb.checked);
      if (on) { sum += (x.price||0); rows.push(x); }
    });
    return { sum: sum, rows: rows };
  }

  // ===== Selezione lezioni/giorni OK? =====
  function selectionOk(){
    if (mode === 'single_lessons') {
      var n = parseInt(document.getElementById('rvCount').value, 10);
      for (var i=0; i<n; i++) {
        var d = form.querySelector('input[name="lesson_day_'+i+'"]');
        var s = form.querySelector('input[name="lesson_slot_'+i+'"]');
        if (!d || !s || !d.value || !s.value) return false;
      }
      return true;
    }
    if (mode === 'red') {
      var rows = document.querySelectorAll('.rv-ampm');
      for (var k=0; k<rows.length; k++) {
        var inp = rows[k].parentNode.querySelector('input');
        if (!inp.value) return false;
      }
      return true;
    }
    return true;
  }

  // ===== Validation =====
  function payerOk(){
    var fn = form.payerFirstName.value.trim();
    var ln = form.payerLastName.value.trim();
    var em = form.payerEmail.value.trim();
    var ph = form.payerPhone.value.trim();
    if (fn.length<2 || ln.length<2 || !ph) return false;
    if (!isValidEmail(em)) return false;
    if (!document.getElementById('rvIc').checked) return false;
    if (!document.getElementById('rvDc').checked) return false;
    if (!document.getElementById('rvHc').checked) return false;
    // Se c'è almeno un minore, il pagante deve aver dato il consenso minorenni
    var mc = document.getElementById('rvMc');
    if (mc && mc.required && !mc.checked) return false;
    return true;
  }
  function participantsOk(){
    var cards = partsBox.querySelectorAll('.rv-part');
    if (cards.length === 0) return false;
    for (var i=0; i<cards.length; i++) if (!isParticipantComplete(cards[i])) return false;
    return true;
  }
  function tutorsOk(){ return true; }  // tutore = pagante (validato in payerOk via minorConsent)

  // ===== Sync (totale + dettaglio + bottoni) — gli elementi sono già stati raccolti in alto =====
  function sync(){
    var N = STATE.participantsCount;
    sumPartsEl.textContent = N + (N===1 ? ' persona' : ' personas');

    // dettaglio
    var detHtml = '—';
    if (mode === 'single_lessons') {
      var n = parseInt(document.getElementById('rvCount').value, 10) || 1;
      var lines = [];
      for (var i=0; i<n; i++) {
        var dEl = form.querySelector('input[name="lesson_day_'+i+'"]');
        var sEl = form.querySelector('input[name="lesson_slot_'+i+'"]');
        var d = dEl ? dEl.value : '';
        var s = sEl ? sEl.value : '';
        if (d && s) {
          var dayInfo = DAYS.find(function(x){return x.iso===d;});
          var dayLabel = dayInfo ? (dayInfo.num+' '+dayInfo.mon) : d;
          var l = lessonAt(d, s);
          if (l) lines.push('<div><strong>'+s+'</strong> '+escapeHtml(l.title)+(l.professor?' <span style="opacity:.65">· '+escapeHtml(l.professor)+'</span>':'')+' <span style="opacity:.55;font-size:.85em">'+dayLabel+'</span></div>');
          else lines.push('<div><strong>'+s+'</strong> <span style="opacity:.55">'+dayLabel+'</span></div>');
        }
      }
      detHtml = lines.length ? lines.join('') : (n+' clase'+(n>1?'s':''));
    } else if (mode === 'red') {
      var rows = document.querySelectorAll('.rv-ampm');
      var blocks = [];
      rows.forEach(function(row, idx){
        var picked = row.parentNode.querySelector('input').value;
        if (!picked) return;
        var dayIdx = idx + 1;
        var dayInfo = DAYS[idx];
        var dayLabel = dayInfo ? (dayInfo.num+' '+dayInfo.mon) : ('Día '+dayIdx);
        var fascia = picked === 'AM' ? 'Mañana' : 'Tarde';
        var ls = lessonsForFascia(dayIdx, picked === 'PM');
        var lessonsHtml = ls.length ? ls.map(function(x){
          return '<div style="font-size:.92em;opacity:.85;padding:1px 0 1px 12px"><strong>'+x.time+'</strong> '+escapeHtml(x.title)+(x.professor?' <span style="opacity:.7">· '+escapeHtml(x.professor)+'</span>':'')+'</div>';
        }).join('') : '';
        blocks.push('<div style="margin-bottom:8px"><strong>'+dayLabel+' — '+fascia+'</strong>'+lessonsHtml+'</div>');
      });
      detHtml = blocks.length ? blocks.join('') : ('3 clases/día · '+DAYS.length+' días');
    } else if (mode === 'junior') {
      detHtml = 'Mañanas 9:30–12:30 · '+DAYS.length+' días';
    } else {
      /* GOLD / open: elenca TUTTE le lezioni dei giorni */
      var goldBlocks = [];
      DAYS.forEach(function(d, idx){
        var dayIdx = idx + 1;
        var dayInfo = d;
        var dayLabel = dayInfo ? (dayInfo.num+' '+dayInfo.mon+' '+dayInfo.label.split(' ').pop()) : ('Día '+dayIdx);
        if (!LESSONS[dayIdx]) return;
        var times = Object.keys(LESSONS[dayIdx]).sort();
        var dayHtml = '<div style="margin-top:'+(idx>0?'10px':'0')+'"><div style="font-weight:700;font-size:13px;color:#2a2a2a;text-align:right;margin-bottom:4px">'+escapeHtml(dayLabel)+'</div>';
        times.forEach(function(t){
          var l = LESSONS[dayIdx][t];
          if (l.isPause) return;
          dayHtml += '<div style="font-size:12.5px;text-align:right;color:#5a5a5a;line-height:1.5">'+escapeHtml(t)+' — '+escapeHtml(l.title)+(l.professor?' · '+escapeHtml(l.professor):'')+'</div>';
        });
        dayHtml += '</div>';
        goldBlocks.push(dayHtml);
      });
      detHtml = goldBlocks.length ? goldBlocks.join('') : 'Open class · '+DAYS.length+' días';
    }

    // Riepilogo extras
    var ext = extrasInfo();
    if (ext.rows.length) {
      detHtml += '<div style="margin-top:8px;padding-top:8px;border-top:1px dashed rgba(0,0,0,.1)">';
      ext.rows.forEach(function(x){
        detHtml += '<div style="display:flex;justify-content:space-between;font-size:.92em;padding:2px 0">'+
          '<span>'+escapeHtml(x.name)+(x.mandatory?' <span style="opacity:.65;font-size:.85em">(obl.)</span>':'')+'</span>'+
          '<span>+'+x.price+'€'+(N>1?' <span class="pk-summary-multiplier">× '+N+'</span>':'')+'</span>'+
        '</div>';
      });
      detHtml += '</div>';
    }
    if (N > 1) {
      detHtml += '<div style="margin-top:8px;padding-top:8px;border-top:1px dashed rgba(0,0,0,.1);font-size:.92em;display:flex;justify-content:space-between">'+
        '<span>Paquete por participante</span>'+
        '<span>'+STATE.perParticipant+'€ × '+N+'</span>'+
      '</div>';
    }

    // ===== Sconto quantità =====
    var subtotal = STATE.perParticipant * N;
    var discountAmount = 0;
    if (DISC_THR > 0 && DISC_PCT > 0 && N >= DISC_THR) {
      discountAmount = Math.round(subtotal * DISC_PCT) / 100;
      detHtml += '<div style="margin-top:6px;padding:6px 0;font-size:.92em;display:flex;justify-content:space-between;color:#1b6b3e;font-weight:600">'+
        '<span>Descuento '+DISC_PCT+'% ('+DISC_THR+'+ participantes)</span>'+
        '<span>−'+discountAmount.toFixed(2)+'€</span>'+
      '</div>';
    }

    detEl.innerHTML = detHtml;
    detEl.classList.remove('pk-summary-empty');

    var grossPack = subtotal - discountAmount;        // lordo pacchetto post multi-discount
    var refDiscGross = 0;
    if (window.RV_REFCODE && window.RV_REFCODE.valid) {
      var IVA = 0.21;
      var netPack = grossPack / (1 + IVA);
      var refDiscNet;
      if (window.RV_REFCODE.discountType === 'fixed') {
        refDiscNet = parseFloat(window.RV_REFCODE.discountValue) || 0;
        if (refDiscNet > netPack) refDiscNet = netPack;
      } else {
        refDiscNet = netPack * (parseFloat(window.RV_REFCODE.discountValue) || 0) / 100;
      }
      refDiscGross = Math.round(refDiscNet * (1 + IVA) * 100) / 100;
    }
    var grand = grossPack - refDiscGross + (ext.sum * N);
    totalEl.textContent = (Math.round(grand*100)/100) + '€';

    /* Riga sconto referral nel summary */
    var refRow = document.getElementById('rvSumRefcodeRow');
    if (refRow) {
      if (refDiscGross > 0 && window.RV_REFCODE && window.RV_REFCODE.valid) {
        refRow.hidden = false;
        document.getElementById('rvSumRefcodeName').textContent = window.RV_REFCODE.code;
        document.getElementById('rvSumRefcodeAmt').textContent = '−' + refDiscGross.toFixed(2) + '€';
      } else {
        refRow.hidden = true;
      }
    }
    /* Aggiorna amount Stripe Payment Element se montato */
    if (typeof updateStripeAmount === 'function') updateStripeAmount();

    /* Riempi le nuove righe summary stile design */
    var unitEl = document.querySelector('[data-sum-unit]');
    if (unitEl) unitEl.textContent = STATE.perParticipant + '€ × ' + N;
    var seguroEl = document.querySelector('[data-sum-seguro]');
    if (seguroEl && ext.rows.length) {
      var seguroPrice = ext.rows.reduce(function(s,x){return s + (x.price||0);}, 0);
      seguroEl.textContent = '+' + seguroPrice + '€ × ' + N;
    }
    var detalleEl = document.querySelector('[data-sum-detalle]');
    if (detalleEl && mode === 'single_lessons') {
      var nClasses = parseInt(document.getElementById('rvCount').value, 10) || 1;
      detalleEl.textContent = nClasses + (nClasses===1?' clase':' clases');
    }

    var ready = selectionOk() && payerOk() && participantsOk() && tutorsOk();
    subs.forEach(function(b){ if (ready) b.classList.remove('is-disabled'); else b.classList.add('is-disabled'); });
  }

  form.addEventListener('input', sync);
  form.addEventListener('change', sync);

  var BOOKINGS_ENABLED = <%= bookingsEnabled ? 'true' : 'false' %>;

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (!(selectionOk() && payerOk() && participantsOk() && tutorsOk())) {
      sync();
      window.scrollTo({top:0,behavior:'smooth'});
      return;
    }
    if (!BOOKINGS_ENABLED) { showBookingsOffModal(); return; }
    startEmbeddedCheckout();
  });

  // ===== Modale "Bookings disabled" =====
  function showBookingsOffModal(){ var m=document.getElementById('rvBookingsOff'); if(!m)return; m.hidden=false; document.body.style.overflow='hidden'; }
  function hideBookingsOffModal(){ var m=document.getElementById('rvBookingsOff'); if(!m)return; m.hidden=true; document.body.style.overflow=''; }
  (function(){
    var x = document.getElementById('rvBkOffClose');
    var bd = document.getElementById('rvBkOffBackdrop');
    if (x) x.addEventListener('click', hideBookingsOffModal);
    if (bd) bd.addEventListener('click', hideBookingsOffModal);
    document.addEventListener('keydown', function(e){ if (e.key==='Escape') hideBookingsOffModal(); });
  })();

  // ===== Stripe Elements (Payment Element inline — un click = pagamento) =====
  var STRIPE_PK = <%- JSON.stringify(stripePk || '') %>;
  var stripeObj = null, elementsObj = null, paymentEl = null;
  function getStripeJs(){
    return new Promise(function(resolve, reject){
      if (stripeObj) return resolve(stripeObj);
      if (!STRIPE_PK) return reject(new Error('Stripe non configurato'));
      var tries = 0;
      function check(){
        if (window.Stripe) { try { stripeObj = window.Stripe(STRIPE_PK); resolve(stripeObj); } catch(e){ reject(e); } return; }
        if (++tries > 60) return reject(new Error('Stripe.js non caricato'));
        setTimeout(check, 100);
      }
      check();
    });
  }
  /* Mount Stripe Payment Element unificato — auto-include card / link / paypal / sepa / qualsiasi metodo attivo */
  var paymentElement = null;
  async function mountPaymentElement(){
    try {
      var stripe = await getStripeJs();
      if (elementsObj && paymentElement) return;
      var amount = Math.max(50, Math.round((parseFloat(totalEl.textContent)||0) * 100));
      elementsObj = stripe.elements({
        mode: 'payment',
        amount: amount,
        currency: '<%= (plan.currency || "eur").toLowerCase() %>',
        paymentMethodCreation: 'manual',
        appearance: {
          theme: 'stripe',
          variables: {
            colorPrimary: '#F5C518',
            colorBackground: '#ffffff',
            colorText: '#2a2a2a',
            colorDanger: '#c0392b',
            fontFamily: 'Manrope, system-ui, sans-serif',
            fontSizeBase: '15px',
            borderRadius: '8px',
            spacingUnit: '4px',
          },
          rules: {
            '.Input': { border: '1px solid rgba(42,42,42,.18)', boxShadow: 'none', padding: '14px 16px', fontSize: '15px' },
            '.Input:focus': { borderColor: '#F5C518', boxShadow: 'none' },
            '.Label': { fontSize: '11px', fontWeight: '700', color: '#5a5a5a', textTransform: 'uppercase', letterSpacing: '.16em' },
            '.Tab': { border: '1px solid rgba(42,42,42,.15)', borderRadius: '10px', padding: '14px', backgroundColor: '#ffffff' },
            '.Tab:hover': { borderColor: '#F5C518', backgroundColor: '#ffffff' },
            '.Tab--selected': { backgroundColor: '#fdf7e3', borderColor: '#F5C518', boxShadow: '0 0 0 1px #F5C518 inset', color: '#2a2a2a' },
            '.TabLabel': { fontWeight: '600' },
            '.TabIcon--selected, .TabLabel--selected': { color: '#2a2a2a' },
          },
        },
      });
      paymentElement = elementsObj.create('payment', { layout: { type: 'tabs', defaultCollapsed: false } });
      var wrap = document.getElementById('scx-pay-element');
      if (wrap) wrap.innerHTML = '';
      paymentElement.mount('#scx-pay-element');
    } catch (e) { console.warn('[stripe] mount fail:', e.message); }
  }
  function updateStripeAmount(){
    if (!elementsObj) return;
    var amount = Math.max(50, Math.round((parseFloat(totalEl.textContent)||0) * 100));
    try { elementsObj.update({ amount: amount }); } catch(e){}
  }
  /* Monta Stripe Elements immediato — placeholders visibili da subito */
  setTimeout(function(){ mountPaymentElement(); }, 100);

  function buildPayload(){
    var payer = {
      firstName: form.payerFirstName.value.trim(),
      lastName: form.payerLastName.value.trim(),
      email: form.payerEmail.value.trim(),
      phone: form.payerPhone.value.trim(),
      imageConsent: document.getElementById('rvIc').checked,
      dataConsent: document.getElementById('rvDc').checked,
      healthConsent: document.getElementById('rvHc').checked,
    };
    if (document.getElementById('rvBillToggle').checked) {
      payer.billing = {
        address: (form.billingAddress.value||'').trim(),
        city:    (form.billingCity.value||'').trim(),
        zip:     (form.billingZip.value||'').trim(),
        country: (form.billingCountry.value||'').trim() || 'ES',
        nif:     (form.billingNif.value||'').trim(),
      };
    }
    var participants = [];
    partsBox.querySelectorAll('.rv-part').forEach(function(card, idx){
      var bd = card.querySelector('input[data-fld=birthDate]').value;
      var age = ageYears(bd);
      var isMinor = (age != null && age < 18);
      var pp = {
        firstName: card.querySelector('input[data-fld=firstName]').value.trim(),
        lastName:  card.querySelector('input[data-fld=lastName]').value.trim(),
        birthDate: bd,
        address:   card.querySelector('input[data-fld=address]').value.trim(),
        city:      card.querySelector('input[data-fld=city]').value.trim(),
        zip:       card.querySelector('input[data-fld=zip]').value.trim(),
        country:   card.querySelector('input[data-fld=country]').value.trim() || 'ES',
      };
      if (!isMinor) {
        pp.email = card.querySelector('input[data-fld=email]').value.trim();
        pp.phone = card.querySelector('input[data-fld=phone]').value.trim();
      }
      participants.push(pp);
    });
    var extras = [];
    document.querySelectorAll('input[type=checkbox][name="extras"]:not(:disabled)').forEach(function(cb){
      if (cb.checked) extras.push(parseInt(cb.value, 10));
    });
    // minorConsent: il pagante autorizza la partecipazione dei minori
    var mcEl = document.getElementById('rvMc');
    payer.minorConsent = !!(mcEl && mcEl.checked);
    var payload = { payer: payer, participants: participants, tutors: [], extras: extras };
    if (window.RV_REFCODE && window.RV_REFCODE.valid) {
      payload.referralCode = window.RV_REFCODE.code;
    }
    if (mode === 'single_lessons') {
      payload.classesPerParticipant = parseInt(document.getElementById('rvCount').value, 10);
      var lessons = [];
      var n = payload.classesPerParticipant;
      for (var i=0; i<n; i++) {
        lessons.push({
          day: form.querySelector('input[name="lesson_day_'+i+'"]').value,
          slot: form.querySelector('input[name="lesson_slot_'+i+'"]').value,
        });
      }
      payload.lessons = lessons;
    }
    return payload;
  }

  /* Pagamento inline 1 click — Stripe Payment Element (auto-include tutti i metodi attivi) */
  async function startEmbeddedCheckout(){
    var btnL = document.getElementById('rvSubmitL');
    var btnR = document.getElementById('rvSubmitR');
    var msgEl = document.getElementById('scx-pay-message');
    function setBtn(txt, dis){ [btnL,btnR].forEach(function(b){ if (!b) return; b.disabled = !!dis; if (txt) b.textContent = txt; }); }
    function showMsg(t){ if (msgEl) { msgEl.textContent = t; msgEl.hidden = false; } }
    function clearMsg(){ if (msgEl) { msgEl.textContent = ''; msgEl.hidden = true; } }
    clearMsg();
    setBtn('Procesando...', true);
    try {
      // 1. Assicurati che Payment Element sia montato
      await mountPaymentElement();
      if (!elementsObj || !paymentElement) throw new Error('Métodos de pago no cargados, prueba a recargar');
      // 2. Validazione client-side del Payment Element
      var sub = await elementsObj.submit();
      if (sub && sub.error) throw new Error(sub.error.message || 'Datos de pago no válidos');
      // 3. Crea PaymentIntent server-side (+ booking pending)
      var r = await fetch('/reserva/' + <%- JSON.stringify(plan.slug) %> + '/payment-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(buildPayload()),
        credentials: 'same-origin',
      });
      var j = await r.json().catch(function(){ return {}; });
      if (!r.ok || !j.ok) throw new Error(j.error || ('HTTP ' + r.status));
      var origin = window.location.origin;
      var successUrl = origin + '/reserva/success?b=' + j.bookingId;
      // 4. Conferma pagamento (Stripe gestisce automaticamente carta/Link/PayPal/3DS/redirect)
      var stripe = await getStripeJs();
      var conf = await stripe.confirmPayment({
        elements: elementsObj,
        clientSecret: j.clientSecret,
        confirmParams: {
          return_url: successUrl,
          receipt_email: form.payerEmail.value.trim(),
          payment_method_data: { billing_details: { name: (form.payerFirstName.value + ' ' + form.payerLastName.value).trim(), email: form.payerEmail.value.trim(), phone: form.payerPhone.value.trim() } },
        },
        redirect: 'if_required',
      });
      if (conf && conf.error) throw new Error(conf.error.message || 'Pago no confirmado');
      // Success without redirect → vai alla success
      window.location.href = successUrl;
    } catch (err) {
      showMsg('Error: ' + (err.message || 'No se ha podido procesar el pago.'));
    } finally {
      setBtn('Confirmar y pagar', false);
    }
  }

  var backBtn = document.getElementById('rvEmbedBack');
