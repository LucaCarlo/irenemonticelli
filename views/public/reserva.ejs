  // ===== Codice referral (validazione AJAX) =====
  window.RV_REFCODE = null;
  (function(){
    var input = document.getElementById('rvRefCodeInput');
    var btn = document.getElementById('rvRefCodeApply');
    var st = document.getElementById('rvRefCodeStatus');
    if (!input || !btn || !st) return;

    function showStatus(msg, ok){
      st.hidden = false;
      st.textContent = msg;
      st.className = 'rv-refcode-status ' + (ok ? 'ok' : 'err');
    }
    function clearStatus(){
      st.hidden = true; st.textContent = '';
      window.RV_REFCODE = null;
      btn.classList.remove('is-applied');
      btn.textContent = 'Aplicar';
      input.disabled = false;
      sync();
    }

    input.addEventListener('input', function(){
      input.value = input.value.toUpperCase();
      if (window.RV_REFCODE) clearStatus();
    });

    btn.addEventListener('click', function(){
      if (window.RV_REFCODE) { clearStatus(); return; }
      var code = (input.value||'').trim();
      if (!code) return;
      btn.disabled = true;
      btn.textContent = 'Verificando…';
      fetch('/reserva/validate-code', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ code: code })
      }).then(function(r){return r.json();}).then(function(j){
        btn.disabled = false;
        if (j.ok) {
          window.RV_REFCODE = { valid:true, code: j.code, discountType: j.discountType, discountValue: j.discountValue };
          showStatus('✓ Código aplicado: ' + j.label, true);
          btn.classList.add('is-applied');
          btn.textContent = 'Quitar';
          input.disabled = true;
          sync();
        } else {
          showStatus('✗ ' + (j.error || 'Código no válido'), false);
          window.RV_REFCODE = null;
          btn.textContent = 'Aplicar';
        }
      }).catch(function(){
        btn.disabled = false;
        btn.textContent = 'Aplicar';
        showStatus('Error de conexión. Reintenta.', false);
      });
    });
  })();

  // ===== Init =====
  renderParticipants();
  sync();
})();
</script>
<script id="scx-flatpickr-init">
(function(){
  if (typeof flatpickr === 'undefined') { setTimeout(arguments.callee, 200); return; }
  var CAL_ICO='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
  var CHEV='<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';
  var MONTHS=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  function closeAllDrops(){document.querySelectorAll('.scx-fp-drop.visible').forEach(function(d){d.classList.remove('visible');});document.querySelectorAll('.scx-fp-btn.open').forEach(function(b){b.classList.remove('open');});}
  function makeSelector(label,items,onSelect){
    var sel=document.createElement('div');sel.className='scx-fp-sel';
    var btn=document.createElement('button');btn.type='button';btn.className='scx-fp-btn';btn.innerHTML=label+CHEV;
    var drop=document.createElement('ul');drop.className='scx-fp-drop';
    items.forEach(function(item){var li=document.createElement('li');li.textContent=item.label;li.dataset.val=item.val;li.addEventListener('click',function(e){e.stopPropagation();closeAllDrops();onSelect(item.val,li);});drop.appendChild(li);});
    btn.addEventListener('click',function(e){e.stopPropagation();var isOpen=drop.classList.contains('visible');closeAllDrops();if(!isOpen){drop.classList.add('visible');btn.classList.add('open');}});
    sel.appendChild(btn);sel.appendChild(drop);return {el:sel,btn:btn,drop:drop};
  }
  function buildHeader(fp){
    var cal=fp.calendarContainer;if(!cal)return;
    var old=cal.querySelector('.scx-fp-header');if(old)old.remove();
    var hdr=document.createElement('div');hdr.className='scx-fp-header';
    var curMonth=fp.currentMonth;
    var monthItems=MONTHS.map(function(m,i){return {label:m,val:i};});
    var mSel=makeSelector(MONTHS[curMonth],monthItems,function(val){fp.changeMonth(val-fp.currentMonth,false);mSel.btn.innerHTML=MONTHS[val]+CHEV;mSel.drop.querySelectorAll('li').forEach(function(el){el.classList.toggle('active',parseInt(el.dataset.val)===val);});});
    mSel.drop.querySelectorAll('li').forEach(function(el){el.classList.toggle('active',parseInt(el.dataset.val)===curMonth);});
    var curYear=fp.currentYear;var thisYear=new Date().getFullYear();
    var yearItems=[];for(var y=thisYear;y>=1924;y--)yearItems.push({label:String(y),val:y});
    var ySel=makeSelector(String(curYear),yearItems,function(val){fp.changeYear(val);ySel.btn.innerHTML=String(val)+CHEV;ySel.drop.querySelectorAll('li').forEach(function(el){el.classList.toggle('active',parseInt(el.dataset.val)===val);});});
    ySel.drop.querySelectorAll('li').forEach(function(el){el.classList.toggle('active',parseInt(el.dataset.val)===curYear);});
    setTimeout(function(){var act=ySel.drop.querySelector('li.active');if(act)act.scrollIntoView({block:'nearest'});},50);
    var prevBtn=document.createElement('button');prevBtn.type='button';prevBtn.style.cssText='background:none;border:none;cursor:pointer;padding:5px;color:#5a5a5a;display:flex;align-items:center';
    prevBtn.innerHTML='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>';
    prevBtn.addEventListener('click',function(e){e.stopPropagation();fp.changeMonth(-1);});
    var nextBtn=document.createElement('button');nextBtn.type='button';nextBtn.style.cssText='background:none;border:none;cursor:pointer;padding:5px;color:#5a5a5a;display:flex;align-items:center';
    nextBtn.innerHTML='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>';
    nextBtn.addEventListener('click',function(e){e.stopPropagation();fp.changeMonth(1);});
    mSel.drop.classList.add('months-drop');ySel.drop.classList.add('years-drop');
    hdr.appendChild(prevBtn);hdr.appendChild(mSel.el);hdr.appendChild(ySel.el);hdr.appendChild(nextBtn);
    var xBtn=document.createElement('button');xBtn.type='button';xBtn.className='scx-cal-close';
    xBtn.innerHTML='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    xBtn.addEventListener('click',function(e){e.stopPropagation();closeAllDrops();fp.close();});
    var oldX=cal.querySelector('.scx-cal-close');if(oldX)oldX.remove();cal.appendChild(xBtn);
    var months=cal.querySelector('.flatpickr-months');if(months)months.after(hdr);else cal.prepend(hdr);
    cal._scxMSel=mSel;cal._scxYSel=ySel;
  }
  function updateHeader(fp){var cal=fp.calendarContainer;if(!cal)return;if(cal._scxMSel)cal._scxMSel.btn.innerHTML=MONTHS[fp.currentMonth]+CHEV;if(cal._scxYSel)cal._scxYSel.btn.innerHTML=String(fp.currentYear)+CHEV;if(cal._scxMSel)cal._scxMSel.drop.querySelectorAll('li').forEach(function(el){el.classList.toggle('active',parseInt(el.dataset.val)===fp.currentMonth);});if(cal._scxYSel)cal._scxYSel.drop.querySelectorAll('li').forEach(function(el){el.classList.toggle('active',parseInt(el.dataset.val)===fp.currentYear);});}
  function initFp(input){
    if(input._flatpickr||input.dataset.fpReady)return;input.dataset.fpReady='1';
    var isFullCol=input.classList.contains('scx-pg-full');
    var wrapper=document.createElement('div');wrapper.className='scx-date-wrap'+(isFullCol?' scx-pg-full':'');
    if(isFullCol)input.classList.remove('scx-pg-full');
    input.parentNode.insertBefore(wrapper,input);wrapper.appendChild(input);
    var calBtn=document.createElement('button');calBtn.type='button';calBtn.className='scx-cal-btn';calBtn.innerHTML=CAL_ICO;calBtn.tabIndex=-1;wrapper.appendChild(calBtn);
    input.placeholder='dd/mm/aaaa';
    var fp=flatpickr(input,{
      dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',allowInput:false,clickOpens:false,maxDate:'today',disableMobile:false,
      onChange:function(){input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));},
      onReady:function(_s,_str,fp2){buildHeader(fp2);if(fp2.altInput){fp2.altInput.className=input.className;fp2.altInput.style.cssText='width:100%;padding-right:42px;cursor:pointer;box-sizing:border-box';fp2.altInput.placeholder='dd/mm/aaaa';}},
      onMonthChange:function(_s,_str,fp2){updateHeader(fp2);},
      onYearChange:function(_s,_str,fp2){updateHeader(fp2);}
    });
    calBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();fp.toggle();});
  }
  document.addEventListener('click',function(){closeAllDrops();});
  function initAll(){document.querySelectorAll('input[data-participant-birth],input[data-payer-birth]').forEach(initFp);}
  initAll();
  new MutationObserver(function(muts){muts.forEach(function(m){m.addedNodes.forEach(function(n){if(n.nodeType!==1)return;if(n.querySelectorAll){n.querySelectorAll('[data-participant-birth],[data-payer-birth]').forEach(initFp);}if(n.matches&&(n.matches('[data-participant-birth]')||n.matches('[data-payer-birth]')))initFp(n);});});}).observe(document.body,{childList:true,subtree:true});
})();
</script>
<script src="/tracker.js" defer></script>
</body>
