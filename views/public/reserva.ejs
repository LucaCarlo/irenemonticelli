<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= plan.name %> — Reserva — Irene Monticelli</title>
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/reserva77.css">
<style>
  body{margin:0;background:#f6f6f4;padding-top:0}
  /* === Override reserva77.css: il preloader del sito qui non c'è, quindi
       nav-links/nav-toggle devono partire OPACITY 1 (sennò il burger è invisibile).
       NB: NON tocco "transform" perché su mobile il pannello deve restare
       translateX(100%) di default (off-screen), altrimenti il menu è già aperto. === */
  header.site .nav-links,
  header.site .nav-toggle{opacity:1 !important}
  /* Su desktop forzo translateY(0) per evitare il -8px di animazione assente */
  @media (min-width:881px){
    header.site .nav-links{transform:translateY(0) !important}
  }
  /* === HEADER unificato (stesso pattern del sito pubblico) === */
  header.site{position:sticky;top:0;left:0;right:0;z-index:50;background:rgba(255,255,255,.92);
    backdrop-filter:saturate(140%) blur(14px);-webkit-backdrop-filter:saturate(140%) blur(14px);
    border-bottom:1px solid rgba(0,0,0,.07)}
  header.site .nav{display:flex;align-items:center;justify-content:space-between;max-width:1320px;margin:0 auto;padding:14px 5vw;gap:24px}
  header.site .logo{display:block;height:34px;color:#1c1f26;flex-shrink:0;transition:opacity .25s}
  header.site .logo:hover{opacity:.7}
  header.site .logo svg{height:100%;width:auto;display:block;fill:currentColor}
  header.site .logo .cls-1{fill:#ffba30}
  header.site .nav-links{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
  header.site .nav-links a[data-h]{position:relative;padding:9px 14px;color:#1c1f26;transition:color .25s}
  header.site .nav-links a[data-h]:hover{color:#c8970a;text-decoration:none}
  .nav-referral{display:inline-flex !important;align-items:center;gap:6px;
    background:#F5C518;color:#1c1f26 !important;padding:8px 16px !important;border-radius:99px !important;
    font-size:12.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
    margin-left:10px;transition:.22s ease;border:1.5px solid #F5C518;text-decoration:none !important}
  .nav-referral::before{content:"★";font-size:11px;line-height:1;color:#1c1f26}
  .nav-referral:hover{background:#fff !important;color:#1c1f26 !important;border-color:#fff;transform:translateY(-1px);box-shadow:0 8px 22px -10px rgba(245,197,24,.5);text-decoration:none !important}
  .nav-toggle{display:none;background:transparent;border:0;padding:8px;cursor:pointer;flex-shrink:0;color:#1c1f26;width:36px;height:36px}
  .nav-toggle span{display:block;width:22px;height:2px;background:currentColor;margin:5px auto;transition:transform .35s,opacity .35s}
  .nav-toggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-toggle.open span:nth-child(2){opacity:0}
  .nav-toggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  @media (max-width:880px){
    header.site .nav-links{position:fixed;top:0;right:0;height:100vh;width:min(380px,82vw);
      background:rgba(255,255,255,.98);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
      flex-direction:column;align-items:flex-start;justify-content:center;
      padding:80px 6vw;gap:18px;font-size:18px;font-weight:300;
      transform:translateX(100%);transition:transform .5s cubic-bezier(.7,0,.2,1);z-index:99}
    header.site .nav-links.open{transform:translateX(0)}
    .nav-toggle{display:block;z-index:101;position:relative}
    .nav-referral{margin-left:0 !important;margin-top:10px !important;font-size:13.5px !important;padding:11px 22px !important;align-self:flex-start}
  }
  .pk-booking{padding:34px 0 70px}
  .rv-formula{display:flex;gap:10px;flex-wrap:wrap}
  /* Override: nessun padding interno + niente border (l'ha già scx-clase) */
  .rv-lesson{border:0;border-radius:0;padding:0;margin:0}
  .rv-lesson > b{display:block;margin-bottom:8px}
  /* L'header scx-clase deve estendere all bordo del card */
  .pk-booking-wrap .scx-clase{padding:0 !important}
  .pk-booking-wrap .scx-clase-header{margin:0 !important;width:100% !important;box-sizing:border-box}
  .rv-consent{display:flex;gap:12px;align-items:flex-start;margin:14px 0;font-size:14px;line-height:1.5}
  .rv-consent input{width:20px;height:20px;margin-top:1px;flex-shrink:0}
  .rv-hide{display:none !important}
  .rv-err{background:#fdecec;border:1px solid #f3c9c9;color:#b53636;padding:12px 16px;border-radius:12px;margin:0 6vw 18px;font-size:14px}
  .pk-pay-row-panel p{margin:.4em 0}
  .pk-form .pk-row{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}
  .pk-form .pk-row.pk-row-1{grid-template-columns:1fr !important}
  .pk-form .pk-row.pk-row-3{grid-template-columns:1fr 1fr 1fr !important}
  .pk-form .pk-field{min-width:0}
  @media(max-width:680px){.pk-form .pk-row,.pk-form .pk-row.pk-row-3{grid-template-columns:1fr !important;gap:0}}
  .pk-form .pk-field input,.pk-form .pk-field select{
    font-family:inherit;font-weight:300;font-size:17px;color:#2a2a2a;background:transparent;
    border:0;border-bottom:1px solid rgba(42,42,42,.22);border-radius:0;
    padding:14px 0 16px;outline:none;width:100%;box-shadow:none;
    transition:border-bottom-color .35s cubic-bezier(.7,0,.2,1),border-bottom-width .35s cubic-bezier(.7,0,.2,1)}
  .pk-form .pk-field input::placeholder{color:rgba(42,42,42,.32)}
  .pk-form .pk-field input:focus,.pk-form .pk-field select:focus{
    border-bottom-color:#e0aa00;border-bottom-width:1.5px;padding-bottom:15.5px}
  .pk-form .pk-field input[type=date]{color:#2a2a2a}
  .pk-form .pk-error{display:none !important}
  body.page-pack .pk-booking::after{content:'';position:fixed;top:0;bottom:0;
    left:50%;right:0;background:#fafaf8;z-index:0;pointer-events:none}
  body.page-pack .pk-booking::before{content:'';position:fixed;top:0;bottom:0;
    left:50%;width:1px;margin-left:-.5px;background:rgba(0,0,0,.13);z-index:3;pointer-events:none}
  body.page-pack .pk-booking{background:#fff !important;padding:0 !important;margin:0 !important;
    max-width:none !important;width:100% !important;border:0 !important;position:relative;z-index:1}
  body.page-pack .pk-booking-wrap{max-width:1280px !important;margin:0 auto !important;
    padding:0 !important;width:100% !important;border:0 !important;
    box-sizing:border-box;background:transparent !important;position:relative;z-index:2}
  body.page-pack .pk-checkout-grid{display:block !important;
    width:100% !important;max-width:none !important;
    margin:0 !important;padding:0 !important;border:0 !important;
    position:relative !important;min-height:calc(100vh - 72px)}
  body.page-pack .pk-checkout-main{width:50% !important;min-width:0 !important;
    background:#fff !important;border:0 !important;
    padding:24px 40px 90px 5vw !important;
    min-height:calc(100vh - 72px) !important;height:auto !important;
    display:block !important;box-sizing:border-box;float:none;position:relative;z-index:2}
  body.page-pack .pk-checkout-main .pk-form{display:block !important;
    max-width:none !important;width:100% !important;
    margin:0 !important;padding:0 !important;box-sizing:border-box}
  body.page-pack .pk-checkout-main .pk-form>.pk-block:first-child{padding-top:0 !important;margin-top:0 !important}
  body.page-pack .pk-checkout-main .pk-block-pack{padding-top:0 !important;text-align:left !important}
  body.page-pack .pk-checkout-main .pk-pack-title{margin:0 0 12px !important;padding:0 !important;line-height:1.05;text-align:left !important}
  body.page-pack .pk-checkout-main .pk-pack-desc{margin:0 0 18px !important;max-width:none !important;text-align:left !important}
  body.page-pack .pk-checkout-main .pk-change-pack{display:inline-block !important;text-align:left !important}
  body.page-pack .pk-summary-sticky{position:fixed !important;
    top:0 !important;
    right:max(0px, calc(50vw - 640px)) !important;
    width:min(50vw, 640px) !important;
    height:100vh !important;
    overflow-y:auto !important;
    background:transparent !important;
    padding:96px 5vw 48px 40px !important;
    margin:0 !important;
    display:block !important;box-sizing:border-box;
    z-index:2 !important}
  body.page-pack .pk-summary-card{display:block !important;box-sizing:border-box;
    width:100% !important;max-width:none !important;
    margin:0 !important;padding:0 !important;background:transparent !important;border:0 !important}
  body.page-pack .pk-summary-title{margin:0 0 22px !important;padding:0 !important}
  .pk-summary-card .pk-summary-title{margin:0 0 18px !important;padding:0 !important;line-height:1.15;white-space:normal}
  .pk-summary-row,.pk-summary-card .pk-summary-row{display:flex !important;justify-content:space-between;
    align-items:baseline;gap:16px;padding:9px 0}
  .pk-summary-label,.pk-summary-card .pk-summary-label{white-space:nowrap}
  .pk-summary-value,.pk-summary-card .pk-summary-value{text-align:right}
  .pk-summary-trigger{display:none}

  @media(max-width:980px){
    body.page-pack .pk-booking::before,
    body.page-pack .pk-booking::after{display:none !important}
    body.page-pack .pk-checkout-grid{display:block !important;min-height:0 !important}
    body.page-pack .pk-checkout-main{width:100% !important;
      padding:24px 5vw 92px !important;border-right:0 !important;
      border-bottom:0 !important;min-height:0 !important}
    body.page-pack .pk-checkout-main .pk-form{max-width:none !important}

    body.page-pack .pk-summary-sticky{position:fixed !important;
      top:auto !important;right:0 !important;bottom:0 !important;left:0 !important;
      width:100% !important;max-width:none !important;
      height:auto !important;max-height:88vh !important;
      overflow:hidden !important;
      background:#fafaf8 !important;
      border-top:1px solid rgba(0,0,0,.12) !important;
      box-shadow:0 -10px 30px rgba(0,0,0,.10) !important;
      padding:0 !important;margin:0 !important;
      transform:translateY(calc(100% - 72px)) !important;
      transition:transform .45s cubic-bezier(.7,0,.2,1) !important;
      z-index:20 !important;
      border-radius:14px 14px 0 0 !important;
      display:flex !important;flex-direction:column !important}
    body.page-pack .pk-summary-sticky.is-open{transform:translateY(0) !important;
      max-height:88vh !important;overflow-y:auto !important}

    body.page-pack .pk-summary-sticky .pk-summary-trigger{
      display:flex !important;align-items:center;justify-content:space-between;
      width:100%;background:transparent;border:0;cursor:pointer;
      padding:18px 5vw;height:72px;flex-shrink:0;
      font:inherit;color:inherit;text-align:left}
    .pk-trigger-meta{display:flex;flex-direction:column;gap:1px}
    .pk-trigger-lbl{font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:#7a8190;font-weight:600}
    .pk-trigger-amt{font-size:15px;font-weight:500;color:#1c1f26}
    .pk-trigger-amt strong{font-weight:700;margin-left:6px}
    .pk-trigger-arrow{font-size:14px;color:#1c1f26;transition:transform .35s ease;display:inline-block}
    body.page-pack .pk-summary-sticky.is-open .pk-trigger-arrow{transform:rotate(180deg)}

    body.page-pack .pk-summary-card{
      padding:6px 5vw 30px !important;max-width:none !important;
      background:transparent !important;border:0 !important}
    body.page-pack .pk-summary-title{display:none !important}
  }
  body.page-pack .pk-sub-label-birth{
    font-size:13px !important;
    font-weight:600 !important;
    letter-spacing:.08em !important;
    color:#1c1f26 !important;
    margin:0 0 8px !important;
    display:block !important;
  }
  body.page-pack .pk-field-birth input[type=date]{display:block !important;width:100%;box-sizing:border-box}

  .pk-bk-off[hidden]{display:none !important}
  .pk-bk-off{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px}
  .pk-bk-off-backdrop{position:absolute;inset:0;background:rgba(20,18,14,.55);backdrop-filter:blur(4px);
    -webkit-backdrop-filter:blur(4px);animation:bk-fade .25s ease-out}
  .pk-bk-off-box{position:relative;background:#fff;border-radius:14px;max-width:520px;width:100%;
    padding:36px 36px 28px;box-shadow:0 30px 80px rgba(0,0,0,.25);text-align:center;
    animation:bk-pop .35s cubic-bezier(.16,1,.3,1)}
  .pk-bk-off-close{position:absolute;top:12px;right:14px;background:none;border:0;
    font-size:28px;line-height:1;color:#9aa1b2;cursor:pointer;padding:6px 12px}
  .pk-bk-off-close:hover{color:#1c1f26}
  .pk-bk-off-icon{display:flex;justify-content:center;color:#c8970a;margin-bottom:14px}
  .pk-bk-off-box h3{font-family:var(--sans,Inter,Arial);font-weight:400;letter-spacing:-.01em;
    font-size:22px;line-height:1.25;margin:0 0 14px;color:#1c1f26}
  .pk-bk-off-box p{font-size:14.5px;line-height:1.6;color:#5a5e6a;margin:0 0 14px}
  .pk-bk-off-box p:last-of-type{margin-bottom:18px}
  .pk-bk-off-actions{display:flex;flex-direction:column;gap:10px;margin:18px 0 16px}
  .pk-bk-off-cta{display:inline-block;padding:12px 22px;border:1.5px solid #1c1f26;
    border-radius:99px;text-decoration:none;color:#1c1f26;font-size:13px;font-weight:600;
    letter-spacing:.06em;transition:background .35s ease,color .35s ease,transform .35s ease}
  .pk-bk-off-cta:hover{background:#1c1f26;color:#e0aa00;transform:translateY(-2px)}
  .pk-bk-off-cta.primary{background:#e0aa00;border-color:#e0aa00;color:#1c1f26}
  .pk-bk-off-cta.primary:hover{background:#c8970a;border-color:#c8970a;color:#fff}
  .pk-bk-off-cta.ghost{border-color:rgba(0,0,0,.15);font-weight:500;letter-spacing:.02em;text-transform:none}
  .pk-bk-off-foot{font-size:12.5px;color:#9aa1b2;margin:8px 0 0 !important}
  @keyframes bk-fade{from{opacity:0}to{opacity:1}}
  @keyframes bk-pop{from{opacity:0;transform:translateY(20px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}

  .pk-refund-policy{display:flex;gap:12px;align-items:flex-start;margin-top:24px;
    padding:14px 16px;background:#fdf8e8;border:1px solid #ead9a8;border-radius:8px;
    color:#7a5800;font-size:13px;line-height:1.55}
  .pk-refund-policy svg{flex-shrink:0;color:#c8970a;margin-top:1px}
  .pk-refund-policy strong{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
    color:#7a5800;margin-bottom:4px;font-weight:600}
  .pk-refund-policy p{margin:0;color:#5e4400}
  .pk-refund-policy a{color:#7a5800;text-decoration:underline}
  .pk-refund-policy a:hover{color:#000}

  .pk-embed-wrap{padding:0;margin:0}
  .pk-embed-back{display:inline-flex;align-items:center;gap:6px;background:none;border:0;
    cursor:pointer;color:#7a8190;font-size:13.5px;padding:0;margin:0 0 18px;letter-spacing:.04em}
  .pk-embed-back:hover{color:#1c1f26}
  .pk-embed-title{font-family:var(--sans,Inter,Arial);font-weight:300;letter-spacing:-.02em;
    font-size:clamp(28px,2.4vw,36px);margin:0 0 18px;line-height:1.1;color:#1c1f26}
  #embed-payment{min-height:520px}
  .pk-embed-loading{color:#7a8190;padding:40px 0}
  .pk-embed-error{background:#fff3f0;border:1px solid #e7c1b8;color:#8a2a1c;
    padding:14px 18px;border-radius:8px;margin-bottom:18px}

  /* ===== F3: counter partecipanti + accordion partecipanti + tutori ===== */
  .rv-counter{display:inline-flex;align-items:center;gap:0;border:1px solid rgba(42,42,42,.15);
    border-radius:10px;background:#fff;width:fit-content;overflow:hidden;margin:8px 0 0}
  .rv-counter button{background:transparent;border:0;cursor:pointer;
    width:44px;height:44px;font-size:20px;font-weight:400;color:#1c1f26;line-height:1;
    transition:background .25s ease,color .25s ease;display:flex;align-items:center;justify-content:center}
  .rv-counter button:hover:not(:disabled){background:#fdf8e8;color:#c8970a}
  .rv-counter button:disabled{opacity:.3;cursor:not-allowed}
  .rv-counter .rv-counter-val{min-width:54px;text-align:center;font-size:17px;font-weight:600;color:#1c1f26;
    padding:0 6px;border-left:1px solid rgba(42,42,42,.1);border-right:1px solid rgba(42,42,42,.1);
    height:44px;display:flex;align-items:center;justify-content:center}
  .rv-counter-hint{margin-top:8px;font-size:12.5px;color:#7a8190;line-height:1.45}

  /* Accordion partecipante */
  .rv-part{border:1px solid rgba(42,42,42,.12);border-radius:12px;background:#fff;margin-bottom:12px;
    overflow:hidden;transition:border-color .25s ease,box-shadow .25s ease}
  .rv-part:hover{border-color:rgba(224,170,0,.4)}
  .rv-part-head{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;
    user-select:none;background:#fafaf8;border-bottom:1px solid transparent;transition:background .2s ease}
  .rv-part-head:hover{background:#f7f6f2}
  /* Header partecipante grigio chiaro come design (era giallo prima) */
  .rv-part.is-open .rv-part-head,.rv-part .rv-part-head,.scx-participant-card .scx-participant-header{background:#fafbfc !important;border-bottom:1px solid #dde0e4 !important;color:#2a2a2a !important}
  .rv-part-num{flex-shrink:0;display:flex;align-items:center;justify-content:center;
    width:30px;height:30px;border-radius:50%;background:#1c1f26;color:#e0aa00;
    font-size:13px;font-weight:700}
  .rv-part-title{flex:1;font-size:14.5px;font-weight:600;color:#1c1f26;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .rv-part-status{font-size:11.5px;color:#7a8190;font-weight:500}
  .rv-part-badge{font-size:9.5px;padding:2px 7px;border-radius:99px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .rv-part-badge-minor{background:#fff3d6;color:#7a5800}
  .rv-part-badge-adult{background:#e3f0ff;color:#0d5290}
  .rv-part-badge-ok{background:#d6f3df;color:#1b6b3e}
  .rv-part-badge-incomplete{background:#ffe1dc;color:#8a2a1c}
  .rv-part-arrow{font-size:14px;color:#1c1f26;transition:transform .25s ease;flex-shrink:0}
  .rv-part.is-open .rv-part-arrow{transform:rotate(180deg)}
  /* Visibilità accordion gestita da scx-participant-body.is-collapsed */
  .rv-part-body{padding:14px 16px}
  .rv-part-section{margin-top:10px}
  .rv-part-section h4{margin:0 0 8px;font-size:12px;font-weight:600;letter-spacing:.12em;
    text-transform:uppercase;color:#7a8190}

  /* Tutor: blocco selettore per ogni minore */
  .rv-tutor-pick{margin-top:10px;padding:12px 14px;background:#fffaee;border:1px solid #ead9a8;border-radius:10px}
  .rv-tutor-pick-label{font-size:12.5px;font-weight:600;color:#7a5800;margin-bottom:8px;letter-spacing:.04em}
  .rv-tutor-pick-opts{display:flex;flex-direction:column;gap:6px}
  .rv-tutor-pick-opt{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:6px;
    cursor:pointer;font-size:13.5px;color:#1c1f26;transition:background .2s ease}
  .rv-tutor-pick-opt:hover{background:#fdf8e8}
  .rv-tutor-pick-opt input[type=radio]{width:16px;height:16px;accent-color:#c8970a;flex-shrink:0}
  .rv-tutor-pick-opt.is-new{border-top:1px dashed rgba(0,0,0,.1);margin-top:4px;padding-top:10px}

  /* Sezione tutori */
  .rv-tutors-empty{font-size:13.5px;color:#7a8190;font-style:italic;padding:14px 0}
  .rv-tutor-block{border:1px solid rgba(42,42,42,.12);border-radius:12px;background:#fff;margin-bottom:12px;
    padding:14px 18px}
  .rv-tutor-block-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;
    flex-wrap:wrap;gap:10px}
  .rv-tutor-block-title{font-size:14.5px;font-weight:600;color:#1c1f26}
  .rv-tutor-block-used{font-size:11.5px;color:#7a8190;font-weight:500}
  .rv-tutor-block-del{background:transparent;border:0;color:#9aa1b2;cursor:pointer;font-size:18px;
    line-height:1;padding:4px 8px;border-radius:50%;transition:background .2s ease,color .2s ease}
  .rv-tutor-block-del:hover{background:#ffe1dc;color:#8a2a1c}
  .rv-tutor-block-del:disabled{opacity:.3;cursor:not-allowed}

  .rv-add-btn{background:#fff;border:1.5px dashed rgba(42,42,42,.25);border-radius:10px;
    color:#1c1f26;font-family:inherit;font-size:13.5px;font-weight:500;letter-spacing:.04em;
    padding:12px 18px;cursor:pointer;width:100%;
    transition:border-color .25s ease,background .25s ease,color .25s ease}
  .rv-add-btn:hover{border-color:#c8970a;background:#fdf8e8;color:#7a5800}

  /* Summary update for participants */
  .pk-summary-row-detail{font-size:13.5px;color:#5a5e6a}
  .pk-summary-multiplier{opacity:.65;margin-left:4px;font-size:.88em}

  /* Billing toggle (datos para factura, opcional) */
  .rv-billing-toggle{display:flex;align-items:center;gap:10px;padding:12px 14px;background:#fafbfc;
