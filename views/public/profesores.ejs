<%- shellPrefix %>
<style>
  #page-profesores{background:var(--white)}

  .prof-hero{padding:110px var(--pad-x) 30px;max-width:calc(var(--max-w) + 2*var(--pad-x));
    margin:0 auto;text-align:center}
  .prof-hero-inner{max-width:760px;margin:0 auto}
  .prof-hero .sec-num{justify-content:center;display:flex;align-items:center;gap:10px;margin-bottom:8px}
  .prof-hero .sec-num .sec-dash{display:none}
  .prof-hero-title{font-family:var(--sans);font-weight:300;font-size:clamp(26px,3.2vw,40px);
    line-height:1.04;letter-spacing:-.025em;margin:18px 0 24px;color:var(--ink);text-transform:uppercase}
  .prof-hero-title .it{font-style:italic}
  .prof-hero-title .yel{color:var(--yellow)}
  .prof-hero-lede{font-size:clamp(16px,1.4vw,18px);line-height:1.6;color:var(--ink-soft);
    font-weight:300;margin:0 auto;max-width:600px}

  .prof-section{padding:20px var(--pad-x) 120px;max-width:calc(var(--max-w) + 2*var(--pad-x));margin:0 auto}
  .prof-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px}

  .prof-card{position:relative;min-height:680px;border:1px solid rgba(42,42,42,.12);border-radius:0;
    background:#fff;overflow:hidden;display:block;
    transition:transform .55s cubic-bezier(.19,1,.22,1),border-color .55s cubic-bezier(.19,1,.22,1),box-shadow .55s cubic-bezier(.19,1,.22,1)}
  .prof-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;background:var(--yellow);
    transform:scaleX(0);transform-origin:left;transition:transform .55s cubic-bezier(.19,1,.22,1);z-index:5}
  .prof-card:hover,.prof-card.open{transform:translateY(-10px);border-color:var(--yellow);
    box-shadow:0 26px 56px -24px rgba(42,42,42,.32)}
  .prof-card:hover::before,.prof-card.open::before{transform:scaleX(1)}
  .prof-card-inner{position:absolute;inset:0;cursor:pointer}

  .prof-photo{position:absolute;inset:0;background:linear-gradient(135deg,#f0efe9 0%,#e6e4dc 100%);overflow:hidden}
  .prof-photo img{width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block}
  .prof-photo-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    color:#b3ac9e;font-size:12px;letter-spacing:.2em;text-transform:uppercase;
    background:radial-gradient(circle at 50% 38%,rgba(42,42,42,.08) 0 22%,transparent 23%),
      linear-gradient(135deg,#efeee8 0%,#e3e1d8 100%)}

  .prof-meta{position:absolute;left:0;right:0;bottom:0;padding:24px 28px;
    background:rgba(42,42,42,.82);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);
    z-index:2;transition:opacity .45s cubic-bezier(.19,1,.22,1)}
  .prof-name{font-family:var(--sans);font-weight:500;font-size:27px;line-height:1.2;
    color:#fff;margin:0 0 6px;letter-spacing:.01em}
  .prof-disc{font-family:var(--sans);font-size:13px;letter-spacing:.18em;text-transform:uppercase;
    font-weight:600;color:var(--yellow)}
  .prof-card:hover .prof-meta,.prof-card.open .prof-meta{opacity:0}

  .prof-bio{position:absolute;inset:0;background:var(--ink);color:#fff;padding:44px 40px;
    display:flex;flex-direction:column;justify-content:center;
    opacity:0;visibility:hidden;transform:translateY(12px);
    transition:opacity .5s cubic-bezier(.19,1,.22,1),transform .5s cubic-bezier(.19,1,.22,1),visibility .5s;
    z-index:4;overflow-y:auto}
  .prof-card:hover .prof-bio,.prof-card.open .prof-bio{opacity:1;visibility:visible;transform:translateY(0)}
  .prof-bio-name{font-family:var(--sans);font-weight:500;font-size:26px;line-height:1.15;color:#fff;margin:0 0 6px}
  .prof-bio-disc{font-family:var(--sans);font-size:11px;letter-spacing:.18em;text-transform:uppercase;
    font-weight:600;color:var(--yellow);margin-bottom:20px}
  .prof-bio-text{font-family:var(--sans);margin:0;max-width:none}
  .prof-bio-text p{font-size:15px;line-height:1.55;font-weight:300;color:rgba(255,255,255,.86);margin:0 0 11px}
  .prof-bio-text p:last-child{margin-bottom:0}
  .prof-bio-text strong{color:#fff;font-weight:500}
  .prof-bio-text em,.prof-bio-text i{font-style:italic;color:#f4e6c5}
  .prof-bio-text u{text-underline-offset:3px}
  .prof-bio-text a{color:var(--yellow);text-decoration:underline}
  .prof-bio-text ul,.prof-bio-text ol{margin:0 0 11px;padding-left:1.3em}
  .prof-bio-text li{margin-bottom:5px}
  .prof-bio::-webkit-scrollbar{width:5px}
  .prof-bio::-webkit-scrollbar-thumb{background:rgba(255,255,255,.25);border-radius:3px}

  .prof-card.reveal{opacity:0;transform:translateY(28px);
    transition:opacity .9s cubic-bezier(.19,1,.22,1),transform .9s cubic-bezier(.19,1,.22,1),border-color .55s,box-shadow .55s}
  .prof-card.reveal.in{opacity:1;transform:translateY(0)}
  .prof-card.reveal.in:hover{transform:translateY(-10px)}

  .prof-empty{text-align:center;color:#7a8190;padding:70px 20px;grid-column:1/-1}

  @media (max-width:860px){
    .prof-grid{grid-template-columns:1fr;gap:20px}
    .prof-card{min-height:560px}
    .prof-bio{padding:34px 28px;justify-content:flex-start}
    .prof-bio-text p{font-size:14px}
  }
  @media (max-width:720px){
    .prof-hero{padding:120px 20px 30px}
    .prof-section{padding:20px 20px 70px}
  }
</style>

<section class="prof-hero" id="profesores">
  <div class="prof-hero-inner">
    <div class="sec-num reveal">Profesores</div>
    <h1 class="prof-hero-title reveal">Os presentamos a nuestros <i class="it yel">profesores</i></h1>
    <p class="prof-hero-lede reveal">Pasa o haz clic sobre cada retrato para descubrir su recorrido.</p>
  </div>
</section>

<section class="prof-section">
  <div class="prof-grid">
    <% if (!profs.length) { %>
      <div class="prof-empty">Pronto publicaremos el equipo de profesores.</div>
    <% } else { %>
      <% profs.forEach(function(p){ %>
        <article class="prof-card reveal">
          <div class="prof-card-inner" tabindex="0" role="button" aria-label="Ver recorrido de <%= p.firstName %> <%= p.lastName %>">
            <div class="prof-photo">
              <% if (p.photo) { %>
                <img loading="lazy" src="<%= p.photo.path %>" alt="<%= p.firstName %> <%= p.lastName %>">
              <% } else { %>
                <div class="prof-photo-ph">Foto próximamente</div>
              <% } %>
            </div>
            <div class="prof-meta">
              <div class="prof-name"><%= p.firstName %> <%= p.lastName %></div>
              <% if (p.danceType) { %><div class="prof-disc"><%= p.danceType %></div><% } %>
            </div>
            <div class="prof-bio">
              <div class="prof-bio-name"><%= p.firstName %> <%= p.lastName %></div>
              <% if (p.danceType) { %><div class="prof-bio-disc"><%= p.danceType %></div><% } %>
              <div class="prof-bio-text"><%- p.descriptionHtml || '' %></div>
            </div>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>

<section class="quote">
  <span class="quote-deco-l" aria-hidden="true"></span>
  <span class="quote-deco-r" aria-hidden="true"></span>
  <div class="quote-inner">
    <div class="quote-eyebrow reveal">Empezamos</div>
    <div class="quote-body reveal">
      <blockquote>¿List@ para <i class="it">moverte</i>? Descubre la Pro Dance Experience y <i class="it">elige tu pack</i>.</blockquote>
    </div>
    <a href="/pro-dance" data-nav="pro-dance" class="quote-cta reveal">Descubre los packs</a>
  </div>
</section>

<script>
  // Tap su mobile per aprire/chiudere la bio
  document.querySelectorAll('.prof-card-inner').forEach(function(inner){
    var card = inner.closest('.prof-card');
    function toggle(){ card.classList.toggle('open'); }
    inner.addEventListener('click', toggle);
    inner.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); toggle(); }
    });
  });
  // Re-osservo le card nell'IntersectionObserver del sito (se presente)
  if (window.__siteRevealIO) {
    document.querySelectorAll('.prof-card.reveal').forEach(function(el){
      try { window.__siteRevealIO.observe(el); } catch(e){}
    });
  }
</script>
<%- shellSuffix %>
