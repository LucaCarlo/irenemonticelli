<%- include('../partials/header') %>
<form method="post" action="/admin/referrals/<%= referrer.id %>" class="form fs-page" id="referrerForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="fs-page-head">
    <div>
      <h2>Referral <%= referrer.firstName %> <%= referrer.lastName %></h2>
      <p>
        <%= referrer.email %> ·
        <% if (referrer.status==='approved') { %><strong style="color:#1b6b3e">Attivo</strong>
        <% } else { %><strong style="color:#8a2a1c">Disattivato</strong><% } %>
        · Registrato il <%= new Date(referrer.createdAt).toLocaleDateString('it-IT',{day:'2-digit',month:'long',year:'numeric'}) %>
      </p>
    </div>
    <a class="btn btn-ghost" href="/admin/referrals">← Torna alla lista</a>
  </div>

  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#fdf2c9;color:#7a5800">👤</div>
      <div>
        <h3 class="fs-section-title">Anagrafica</h3>
        <p class="fs-section-sub">Dati forniti dal referrer in fase di registrazione.</p>
      </div>
    </div>
    <div class="fs-grid">
      <div class="field">
        <label class="field-lbl">Nome *</label>
        <input type="text" name="firstName" required value="<%= referrer.firstName %>">
      </div>
      <div class="field">
        <label class="field-lbl">Cognome *</label>
        <input type="text" name="lastName" required value="<%= referrer.lastName %>">
      </div>
      <div class="field">
        <label class="field-lbl">Email *</label>
        <input type="email" name="email" required value="<%= referrer.email %>">
        <div class="field-help">Verrà usata per il login in area riservata.</div>
      </div>
      <div class="field">
        <label class="field-lbl">Telefono</label>
        <input type="text" name="phone" value="<%= referrer.phone %>">
      </div>
      <div class="field field-full">
        <label class="field-lbl">IBAN (per pagamento commissioni)</label>
        <input type="text" name="iban" value="<%= referrer.iban %>" placeholder="ES00 0000 0000 0000 0000 0000" style="font-family:Consolas,Menlo,monospace;letter-spacing:.06em">
        <div class="field-help">Il referrer può modificarlo anche dalla sua dashboard.</div>
      </div>
    </div>
  </section>

  <% if (referrer.notes) { %>
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#e3f0ff;color:#0d5290">💬</div>
      <div>
        <h3 class="fs-section-title">Messaggio dal referrer</h3>
        <p class="fs-section-sub">Lasciato in fase di registrazione (sola lettura).</p>
      </div>
    </div>
    <p style="background:#fafbfc;padding:14px 18px;border-radius:10px;font-style:italic;color:#5a5e6a;margin:0;line-height:1.6;white-space:pre-wrap"><%= referrer.notes %></p>
  </section>
  <% } %>

  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#fff3d6;color:#7a5800">📝</div>
      <div>
        <h3 class="fs-section-title">Note interne</h3>
        <p class="fs-section-sub">Visibili solo agli amministratori, non al referrer.</p>
      </div>
    </div>
    <textarea name="internalNotes" rows="4" placeholder="Aggiungi note private…"><%= referrer.internalNotes %></textarea>
  </section>

</form>

<!-- Barra azioni fissa in basso (sempre visibile, anche scrollando nelle sezioni codici/stats) -->
<div class="ref-fixed-actions">
  <a class="btn btn-ghost" href="/admin/referrals">Annulla</a>
  <button class="btn btn-primary" type="submit" form="referrerForm">💾 Salva modifiche</button>
</div>
<style>
  .ref-fixed-actions{
    position:fixed; bottom:0; left:var(--sb-w); right:0; z-index:30;
    background:rgba(255,255,255,.96); backdrop-filter:blur(8px);
    border-top:1px solid var(--line); box-shadow:0 -8px 24px -10px rgba(0,0,0,.08);
    padding:14px 30px;
    display:flex; gap:12px; justify-content:flex-end; align-items:center;
  }
  .ref-fixed-actions .btn{min-width:140px; justify-content:center}
  /* Spazio sotto per non coprire il contenuto (sotto codici/stats) */
  .ref-fixed-pad{height:110px}
  @media (max-width:880px){
    .ref-fixed-actions{left:0; padding:12px 16px}
  }
</style>

<!-- ========== STATISTICHE ========== -->
<% if (referrer.status === 'approved' && stats) { %>
<div class="fs-section" style="margin-top:24px">
  <div class="fs-section-head">
    <div class="fs-section-ico" style="background:#e7f3ec;color:#1b6b3e">📊</div>
    <div>
      <h3 class="fs-section-title">Statistiche guadagni</h3>
      <p class="fs-section-sub">Riassunto delle commissioni generate da questo referrer.</p>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px">
    <div style="background:#fafbfc;border:1px solid var(--line);border-radius:10px;padding:14px 18px">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700">Totale commissioni</div>
      <div style="font-family:Georgia,serif;font-size:24px;margin-top:6px;color:var(--ink)"><%= stats.totalCommissions %></div>
    </div>
    <div style="background:#fffbe8;border:1px solid #ead9a8;border-radius:10px;padding:14px 18px">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#7a5800;font-weight:700">In attesa di pagamento</div>
      <div style="font-family:Georgia,serif;font-size:24px;margin-top:6px;color:var(--ink)"><%= stats.pendingAmount.toFixed(2) %> €</div>
    </div>
    <div style="background:#e7f3ec;border:1px solid #aedabe;border-radius:10px;padding:14px 18px">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#1b6b3e;font-weight:700">Già pagate</div>
      <div style="font-family:Georgia,serif;font-size:24px;margin-top:6px;color:var(--ink)"><%= stats.paidAmount.toFixed(2) %> €</div>
    </div>
  </div>
  <a href="/admin/referrals/commissions?referrerId=<%= referrer.id %>" class="btn btn-ghost btn-sm" style="margin-top:14px">Vedi dettaglio commissioni →</a>
</div>
<% } %>

<!-- ========== ANALYTICS LINK (FUNNEL + SOURCES) ========== -->
<% if (referrer.status === 'approved' && stats) { %>
<div class="fs-section" style="margin-top:24px">
  <div class="fs-section-head">
    <div class="fs-section-ico" style="background:#e3f0ff;color:#0d5290">📊</div>
    <div>
      <h3 class="fs-section-title">Analytics link</h3>
      <p class="fs-section-sub">Funnel di conversione del link tracciato <code>?ref=CODE</code> condiviso dal referrer.</p>
    </div>
  </div>

  <!-- Funnel KPI -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px">
    <div style="background:#fafbfc;border:1px solid var(--line);border-radius:10px;padding:14px 16px;text-align:center">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700">👁 Clic</div>
      <div style="font-family:Georgia,serif;font-size:26px;margin-top:6px;color:var(--ink)"><%= stats.clicks %></div>
    </div>
    <div style="background:#fafbfc;border:1px solid var(--line);border-radius:10px;padding:14px 16px;text-align:center">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700">🛒 Applicato</div>
      <div style="font-family:Georgia,serif;font-size:26px;margin-top:6px;color:var(--ink)"><%= stats.applied %></div>
    </div>
    <div style="background:#e7f3ec;border:1px solid #aedabe;border-radius:10px;padding:14px 16px;text-align:center">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#1b6b3e;font-weight:700">💳 Pagato</div>
      <div style="font-family:Georgia,serif;font-size:26px;margin-top:6px;color:#1b6b3e"><%= stats.paid %></div>
    </div>
    <div style="background:#fffbe8;border:1px solid #ead9a8;border-radius:10px;padding:14px 16px;text-align:center">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#7a5800;font-weight:700">📈 Conv. rate</div>
      <div style="font-family:Georgia,serif;font-size:26px;margin-top:6px;color:var(--ink)"><%= stats.conversionRate %>%</div>
    </div>
  </div>

  <% if (sources && sources.length) { %>
    <div style="margin-top:14px">
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:10px">Fonti del traffico</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% sources.forEach(function(s){ %>
          <div style="display:flex;align-items:center;gap:10px;font-size:13.5px">
            <span style="flex:0 0 110px;font-weight:600;text-transform:capitalize"><%= s.source %></span>
            <span style="flex:1;background:#f4f5f8;border-radius:99px;height:8px;overflow:hidden">
              <span style="display:block;height:100%;background:linear-gradient(90deg,#F5C518,#c8970a);width:<%= s.pct %>%;border-radius:99px"></span>
            </span>
            <span style="flex:0 0 80px;text-align:right;color:var(--muted);font-size:12px"><%= s.count %> · <%= s.pct %>%</span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } else if (stats.clicks === 0) { %>
    <p class="muted" style="padding:16px;background:#fafbfc;border-radius:8px;margin:8px 0 0;font-size:13.5px">Nessun click registrato ancora. Quando le persone apriranno il link <code>https://irenemonticelli.com/pro-dance?ref=CODE</code> i dati appariranno qui.</p>
  <% } %>
</div>
<% } %>

<!-- ========== CODICI SCONTO ========== -->
<% if (referrer.status === 'approved') { %>
<div class="fs-section" style="margin-top:24px">
  <div class="fs-section-head">
    <div class="fs-section-ico" style="background:#fdf2c9;color:#7a5800">🎫</div>
    <div>
      <h3 class="fs-section-title">Codici sconto</h3>
      <p class="fs-section-sub">Codici che il referrer può condividere. Ogni codice ha il suo sconto cliente e la sua % commissione.</p>
    </div>
  </div>

  <% if (referrer.codes && referrer.codes.length) { %>
    <div class="table-wrap" style="margin-bottom:18px">
      <table class="table">
        <thead><tr>
          <th>Codice</th>
          <th>Sconto cliente</th>
          <th>Commissione %</th>
          <th>Pacchetti applicabili</th>
          <th>Clic link</th>
          <th>Usi</th>
          <th>Scadenza</th>
          <th>Stato</th>
          <th></th>
        </tr></thead>
        <tbody>
        <% referrer.codes.forEach(function(c){ var assignedIds = (c.plans||[]).map(function(p){return p.id;}); %>
          <tr class="<%= c.active ? '' : 'is-off' %>">
            <td><code style="background:#fffbe8;color:#7a5800;font-weight:700;padding:3px 10px;border-radius:6px;font-size:13px;letter-spacing:.05em"><%= c.code %></code></td>
            <td><strong><%= c.discountValue %><%= c.discountType==='fixed' ? ' €' : ' %' %></strong></td>
            <td><strong style="color:#1b6b3e"><%= c.commissionPct %> %</strong></td>
            <td>
              <% if (!c.plans || !c.plans.length) { %>
                <span class="chip chip-ok">Tutti i pacchetti</span>
              <% } else { c.plans.forEach(function(p){ %>
                <span class="chip" style="background:#fff3d6;color:#7a5800;margin:2px"><%= p.name %></span>
              <% }) } %>
            </td>
            <td>👁 <strong><%= c.clicks || 0 %></strong></td>
            <td><%= c.usedCount %><%= c.maxUses ? ' / '+c.maxUses : '' %></td>
            <td><%= c.validUntil ? new Date(c.validUntil).toLocaleDateString('it-IT') : '—' %></td>
            <td><% if (c.active) { %><span class="badge badge-ok">attivo</span><% } else { %><span class="badge badge-off">disattivo</span><% } %></td>
            <td class="row-actions">
              <details class="code-edit-dd">
                <summary class="btn-ico" title="Modifica">✎</summary>
                <form method="post" action="/admin/referrals/codes/<%= c.id %>" class="form code-edit-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="fs-grid">
                    <div class="field">
                      <label class="field-lbl">Tipo sconto</label>
                      <select name="discountType">
                        <option value="percent" <%= c.discountType==='percent'?'selected':'' %>>%</option>
                        <option value="fixed" <%= c.discountType==='fixed'?'selected':'' %>>€ fissi</option>
                      </select>
                    </div>
                    <div class="field">
                      <label class="field-lbl">Valore sconto</label>
                      <input type="number" name="discountValue" step="0.5" min="0" value="<%= c.discountValue %>">
                    </div>
                    <div class="field">
                      <label class="field-lbl">Commissione %</label>
                      <input type="number" name="commissionPct" step="0.5" min="0" max="100" value="<%= c.commissionPct %>">
                    </div>
                    <div class="field">
                      <label class="field-lbl">Max usi</label>
                      <input type="number" name="maxUses" min="1" value="<%= c.maxUses || '' %>" placeholder="illimitato">
                    </div>
                    <div class="field">
                      <label class="field-lbl">Scadenza</label>
                      <input type="date" name="validUntil" value="<%= c.validUntil ? new Date(c.validUntil).toISOString().slice(0,10) : '' %>">
                    </div>
                    <div class="field field-full">
                      <label class="field-lbl">Pacchetti applicabili</label>
                      <div class="plan-chips">
                        <% plans.forEach(function(p){ %>
                          <label class="plan-chip">
                            <input type="checkbox" name="planIds" value="<%= p.id %>" <%= assignedIds.includes(p.id)?'checked':'' %>>
                            <span><%= p.name %></span>
                          </label>
                        <% }) %>
                      </div>
                      <div class="field-help">Nessuno selezionato = vale per <strong>tutti</strong> i pacchetti.</div>
                    </div>
                    <div class="field field-full">
                      <label class="field-lbl">Note interne</label>
                      <input type="text" name="internalNotes" value="<%= c.internalNotes || '' %>">
                    </div>
                  </div>
                  <div style="margin-top:10px;text-align:right"><button class="btn btn-primary btn-sm">💾 Salva</button></div>
                </form>
              </details>
              <form method="post" action="/admin/referrals/codes/<%= c.id %>/toggle" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-ico <%= c.active?'btn-ico-hide':'btn-ico-show' %>" title="<%= c.active?'Disattiva':'Riattiva' %>"><%- include('../partials/ico', { name: c.active?'eye':'eye-off' }) %></button>
              </form>
              <form method="post" action="/admin/referrals/codes/<%= c.id %>/delete" onsubmit="return confirm('Eliminare il codice <%= c.code %>?')" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-ico btn-ico-danger" title="Elimina"><%- include('../partials/ico', { name:'trash' }) %></button>
              </form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="muted" style="padding:18px;background:#fafbfc;border-radius:8px;margin-bottom:18px">Nessun codice ancora. Creane uno qui sotto e condividilo col referrer.</p>
  <% } %>

  <details>
    <summary style="cursor:pointer;font-weight:600;color:var(--brand-d);padding:10px 0">+ Crea nuovo codice</summary>
    <form method="post" action="/admin/referrals/<%= referrer.id %>/codes" class="form" style="background:#fafbfc;padding:18px;border-radius:10px;margin-top:10px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="fs-grid">
        <div class="field">
          <label class="field-lbl">Codice (lascia vuoto per generarlo automaticamente)</label>
          <input type="text" name="code" placeholder="es. <%= referrer.firstName.toUpperCase() %>20" style="text-transform:uppercase;font-family:monospace">
          <div class="field-help">Solo lettere/numeri/trattini. Case-insensitive.</div>
        </div>
        <div class="field">
          <label class="field-lbl">Tipo sconto</label>
          <select name="discountType">
            <option value="percent">Percentuale (%)</option>
            <option value="fixed">Fisso (€)</option>
          </select>
        </div>
        <div class="field">
          <label class="field-lbl">Valore sconto</label>
          <input type="number" name="discountValue" step="0.5" min="0" value="20" required>
          <div class="field-help">Si applica al netto del pacchetto (senza IVA, senza extras).</div>
        </div>
        <div class="field">
          <label class="field-lbl">Commissione referrer (%)</label>
          <input type="number" name="commissionPct" step="0.5" min="0" max="100" value="10" required>
          <div class="field-help">% calcolata sul netto post-sconto.</div>
        </div>
        <div class="field">
          <label class="field-lbl">Numero max usi (opzionale)</label>
          <input type="number" name="maxUses" min="1" placeholder="illimitato">
        </div>
        <div class="field">
          <label class="field-lbl">Valido fino al (opzionale)</label>
          <input type="date" name="validUntil">
        </div>
        <div class="field field-full">
          <label class="field-lbl">Pacchetti applicabili</label>
          <div class="plan-chips">
            <% plans.forEach(function(p){ %>
              <label class="plan-chip">
                <input type="checkbox" name="planIds" value="<%= p.id %>">
                <span><%= p.name %></span>
              </label>
            <% }) %>
          </div>
          <div class="field-help">Nessuno selezionato = vale per <strong>tutti</strong> i pacchetti. Spunta solo quelli su cui questo coupon deve funzionare.</div>
        </div>
        <div class="field field-full">
          <label class="field-lbl">Note interne</label>
          <input type="text" name="internalNotes" placeholder="es. campagna instagram estate 2026">
        </div>
      </div>
      <div style="margin-top:14px;display:flex;justify-content:flex-end">
        <button type="submit" class="btn btn-primary">✨ Crea codice</button>
      </div>
    </form>
  </details>
</div>

<style>
  .plan-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
  .plan-chip{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1.5px solid #d4d8e0;border-radius:20px;cursor:pointer;font-size:13.5px;background:#fff;transition:all .15s;user-select:none}
  .plan-chip:hover{border-color:#1c1f26}
  .plan-chip input{margin:0;accent-color:#e0aa00}
  .plan-chip input:checked + span{font-weight:700;color:#7a5800}
  .plan-chip:has(input:checked){background:#fffbe8;border-color:#e0aa00}
  .code-edit-dd{display:inline-block;position:relative}
  .code-edit-dd > summary{list-style:none;cursor:pointer;color:#0d5290}
  .code-edit-dd > summary::-webkit-details-marker{display:none}
  .code-edit-form{position:absolute;right:0;top:30px;z-index:30;background:#fff;border:1px solid #d4d8e0;border-radius:10px;padding:18px;box-shadow:0 12px 40px rgba(0,0,0,.12);width:min(640px, 90vw)}
</style>
<% } %>

<!-- Spazio sotto le sezioni per non far coprire dall'action bar fissa -->
<div class="ref-fixed-pad"></div>
<%- include('../partials/footer') %>
