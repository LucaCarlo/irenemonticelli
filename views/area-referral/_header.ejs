<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Irene Monticelli</title>
<link rel="icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600;1,9..144,700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#2a2a2a; --ink-soft:#5a5e6a; --muted:#8a8f9c; --black:#1c1f26;
  --white:#fff; --bg:#fafaf6;
  --line:#e6e8ed; --line-soft:rgba(42,42,42,.08);
  --yellow:#F5C518; --yellow-d:#c8970a;
  --green:#1b6b3e; --red:#a8351c;
  --pad-x:64px;
  --max-w:1180px;
  --sans:"Manrope",ui-sans-serif,system-ui,sans-serif;
  --serif:"Fraunces",ui-serif,Georgia,serif;
}
@media (max-width:1300px){:root{--pad-x:48px}}
@media (max-width:1100px){:root{--pad-x:36px}}
@media (max-width:960px){:root{--pad-x:28px}}
@media (max-width:720px){:root{--pad-x:18px}}
*{box-sizing:border-box}
html,body{margin:0;padding:0;overflow-x:hidden}
body{
  background:var(--bg); color:var(--ink);
  font-family:var(--sans); font-size:15px; line-height:1.55;
  -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}

/* ============ HEADER (identico al sito pubblico, ma statico — niente preloader/animazioni) ============ */
header.site{
  position:sticky; top:0; left:0; right:0; z-index:100;
  background:rgba(255,255,255,.88); backdrop-filter:saturate(140%) blur(14px); -webkit-backdrop-filter:saturate(140%) blur(14px);
  border-bottom:1px solid rgba(42,42,42,.09);
  box-shadow:0 1px 0 rgba(42,42,42,.04),0 12px 32px -28px rgba(0,0,0,.22);
}
.nav{display:flex;align-items:center;justify-content:space-between;padding:14px var(--pad-x);gap:24px;max-width:calc(var(--max-w) + 2*var(--pad-x));margin:0 auto;width:100%}
.logo{height:34px;display:block;color:var(--ink);flex-shrink:0;transition:opacity .25s}
.logo:hover{opacity:.7}
.logo svg{height:100%;width:auto;display:block;fill:currentColor}
.logo .cls-1{fill:#ffba30}

.nav-links{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
.nav-links a[data-h]{position:relative;padding:9px 14px;color:var(--ink);transition:color .25s}
.nav-links a[data-h]:hover{color:var(--yellow-d)}

.nav-referral{display:inline-flex !important;align-items:center;gap:6px;
  background:var(--yellow);color:#1c1f26 !important;
  padding:8px 16px !important;border-radius:99px !important;
  font-size:12.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
  margin-left:10px;transition:.22s ease;border:1.5px solid var(--yellow);
  text-decoration:none !important}
.nav-referral::before{content:"★";font-size:11px;line-height:1;color:#1c1f26}
.nav-referral:hover{background:#fff !important;color:#1c1f26 !important;border-color:#fff;transform:translateY(-1px);box-shadow:0 8px 22px -10px rgba(245,197,24,.5);text-decoration:none !important}

.nav-toggle{display:none;background:transparent;border:0;padding:8px;cursor:pointer;flex-shrink:0;color:var(--ink);width:36px;height:36px}
.nav-toggle span{display:block;width:22px;height:2px;background:currentColor;margin:5px auto;transition:transform .35s,opacity .35s}
.nav-toggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-toggle.open span:nth-child(2){opacity:0}
.nav-toggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

@media (max-width:880px){
  .nav-links{
    position:fixed;top:0;right:0;height:100vh;width:min(380px,82vw);
    background:rgba(255,255,255,.98);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    flex-direction:column;align-items:flex-start;justify-content:center;
    padding:80px var(--pad-x);gap:18px;font-size:18px;font-weight:300;
    transform:translateX(100%);transition:transform .5s cubic-bezier(.7,0,.2,1);z-index:99
  }
  .nav-links.open{transform:translateX(0)}
  .nav-toggle{display:block;z-index:101;position:relative}
  .nav-referral{margin-left:0 !important;margin-top:10px !important;font-size:13.5px !important;padding:11px 22px !important;align-self:flex-start}
}

/* ============ MAIN AREA ============ */
.ar-main{
  padding:clamp(40px,8vw,80px) var(--pad-x) clamp(60px,10vw,100px);
  max-width:calc(var(--max-w) + 2*var(--pad-x));
  margin:0 auto;width:100%;
}

/* ============ FOOTER (identico al sito pubblico) ============ */
footer{background:var(--black);color:#fff;padding:64px var(--pad-x) 28px;position:relative;z-index:2;margin-top:auto}
footer > *{padding-left:clamp(0px,2vw,32px);max-width:var(--max-w);margin-left:auto;margin-right:auto}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:36px;margin-bottom:56px}
@media (max-width:880px){.foot-grid{grid-template-columns:1fr 1fr;gap:48px}}
@media (max-width:560px){.foot-grid{grid-template-columns:1fr}}
.foot-logo{height:32px;color:#fff;margin-bottom:24px;display:inline-block;transition:opacity .45s cubic-bezier(.7,0,.2,1),transform .45s cubic-bezier(.7,0,.2,1)}
.foot-logo:hover{opacity:.72;transform:translateY(-2px)}
.foot-logo svg{height:100%;width:auto;color:#fff;fill:#fff}
.foot-logo svg path{fill:#fff}
.foot-logo svg path.cls-1{fill:#ffba30}
.foot-logo + p{font-size:15px;color:rgba(255,255,255,.7);max-width:380px;line-height:1.55;font-weight:300}
.foot-col h4{font-family:var(--sans);font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--yellow);margin-bottom:24px}
.foot-col ul{list-style:none;padding:0}
.foot-col li{margin-bottom:12px;font-size:15px;color:rgba(255,255,255,.85);font-weight:300}
.foot-col a{transition:color .25s;color:rgba(255,255,255,.85)}
.foot-col a:hover{color:var(--yellow);text-decoration:none}
.foot-bottom{padding-top:32px;display:flex;justify-content:space-between;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.5);font-weight:500;flex-wrap:wrap;gap:14px 32px;position:relative;align-items:center}
.foot-bottom::before{content:"";position:absolute;top:0;left:50%;width:100vw;height:1px;background:rgba(255,255,255,.12);transform:translateX(-50%)}
.foot-credit{color:rgba(255,255,255,.6);font-size:12px;letter-spacing:.04em;line-height:1.7;display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px}
.foot-credit a{color:#fff;text-decoration:none;border-bottom:1px solid transparent;transition:border-color .3s}
.foot-credit a:hover{border-bottom-color:var(--yellow)}
.foot-built{display:inline-flex;align-items:center;gap:12px;margin-left:8px}
.foot-built::before{content:"";display:inline-block;width:1px;height:22px;background:rgba(255,255,255,.5);flex-shrink:0}
.foot-vay-logo{display:inline-flex;align-items:center;height:18px;border:none !important}
.foot-vay-logo svg{height:18px;width:auto;display:block}
.foot-legal{display:inline-flex;align-items:center;gap:24px;font-size:12px;letter-spacing:.04em}
.foot-legal a{color:rgba(255,255,255,.6);text-decoration:none;transition:color .3s}
.foot-legal a:hover{color:#fff}
@media (max-width:720px){
  .foot-bottom{flex-direction:column;align-items:flex-start;gap:18px}
  .foot-credit{font-size:11.5px}
}

/* Layout body grid (sticky footer) */
.site-wrap{min-height:100vh;display:flex;flex-direction:column}
.site-wrap > main{flex:1}
</style>
</head>
