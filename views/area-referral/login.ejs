<%- include('_header') %>

<style>
  .lg-wrap{max-width:520px;margin:40px auto;text-align:center}
  .lg-sec-num{font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;font-weight:500;color:var(--ink-soft);
    margin-bottom:36px;display:inline-flex;align-items:center;gap:14px;justify-content:center}
  .lg-sec-dash{display:inline-block;width:40px;height:1.5px;background:var(--yellow)}

  .lg-wrap h1{font-family:var(--serif);font-size:clamp(46px,5.8vw,72px);font-weight:400;line-height:1.05;
    letter-spacing:-.012em;margin:0 0 22px;color:var(--black)}
  .lg-wrap h1 i{font-style:italic;color:var(--yellow-d)}
  .lg-wrap p.body-lg{font-size:17px;line-height:1.65;color:var(--ink-soft);font-weight:300;margin:0 auto 48px;max-width:420px}

  .lg-form{display:flex;flex-direction:column;gap:36px;max-width:420px;margin:0 auto;text-align:left}
  .lg-field{position:relative;display:flex;flex-direction:column}
  .lg-field label{font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;color:var(--ink-soft);margin-bottom:14px}
  .lg-field input{
    font-family:var(--sans);font-weight:300;font-size:17px;color:var(--ink);
    background:transparent;border:0;border-bottom:1px solid rgba(42,42,42,.22);
    padding:14px 0 16px;outline:none;width:100%;
    transition:border-bottom-color .35s cubic-bezier(.7,0,.2,1),border-bottom-width .35s cubic-bezier(.7,0,.2,1)
  }
  .lg-field input:focus{border-bottom-color:var(--yellow);border-bottom-width:1.5px;padding-bottom:15.5px}
  .lg-field input::placeholder{color:rgba(42,42,42,.35);font-weight:300}

  .lg-submit{
    align-self:center;margin-top:14px;
    display:inline-flex;align-items:center;gap:0;background:transparent;color:var(--yellow-d);
    padding:16px 50px;border-radius:999px;
    font-family:var(--sans);font-weight:500;font-size:13px;letter-spacing:.18em;text-transform:uppercase;
    border:1.5px solid var(--yellow);cursor:pointer;
    position:relative;overflow:hidden;isolation:isolate;
    transition:color .45s cubic-bezier(.7,0,.2,1),transform .45s cubic-bezier(.7,0,.2,1),box-shadow .45s cubic-bezier(.7,0,.2,1)
  }
  .lg-submit::before{content:"";position:absolute;inset:0;background:var(--yellow);transform:translateX(-101%);transition:transform .5s cubic-bezier(.7,0,.2,1);z-index:-1}
  .lg-submit:hover{color:#fff;transform:translateY(-1px);box-shadow:0 8px 24px -10px rgba(245,197,24,.5)}
  .lg-submit:hover::before{transform:translateX(0)}

  .lg-alert{padding:14px 16px;border-radius:12px;font-size:14px;line-height:1.5;border:1px solid;margin-bottom:24px;
    background:#fef0ec;border-color:#f3c5b9;color:#a8351c;text-align:left}

  .lg-divider{display:flex;align-items:center;gap:18px;margin:48px auto 24px;color:var(--muted);font-size:11px;
    text-transform:uppercase;letter-spacing:.22em;font-weight:500;max-width:420px}
  .lg-divider::before,.lg-divider::after{content:"";flex:1;height:1px;background:var(--line)}

  .lg-bottom{font-size:14.5px;color:var(--ink-soft)}
  .lg-bottom a{font-weight:500;color:var(--ink);border-bottom:1px solid var(--yellow);padding-bottom:1px}
  .lg-bottom a:hover{color:var(--yellow-d);text-decoration:none}
</style>

<div class="lg-wrap">
  <div class="lg-sec-num"><span class="lg-sec-dash"></span>Área Referidos</div>
  <h1>Hola<br><i>de nuevo</i>.</h1>
  <p class="body-lg">Accede a tu panel privado para ver tus inscripciones y ganancias.</p>

  <% if (error) { %>
    <div class="lg-alert" style="max-width:420px;margin:0 auto 28px"><%= error %></div>
  <% } %>

  <form method="post" action="/area-referral/login" class="lg-form" autocomplete="on">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="lg-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autocomplete="username" autofocus value="<%= email || '' %>" placeholder="tu@email.com">
    </div>

    <div class="lg-field">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
    </div>

    <button type="submit" class="lg-submit">Iniciar sesión</button>
  </form>

  <p style="text-align:center;font-size:13px;color:var(--ink-soft);margin:48px auto 0;max-width:380px;line-height:1.65;font-weight:300">
    Si has olvidado tu contraseña o tienes problemas para acceder, contacta directamente con <a href="mailto:info@irenemonticelli.com" style="color:var(--ink);border-bottom:1px solid var(--yellow)">info@irenemonticelli.com</a>.
  </p>
</div>

<%- include('_footer') %>
