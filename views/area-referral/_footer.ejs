<!-- Toggle menu mobile + chiudi alla pressione di una voce -->
<script>
(function(){
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.nav-toggle');
    if (btn) {
      e.preventDefault();
      var links = document.getElementById('navLinks');
      btn.classList.toggle('open');
      if (links) links.classList.toggle('open');
      return;
    }
    var link = e.target.closest('.nav-links a');
    if (link) {
      var openLinks = document.querySelector('.nav-links.open');
      if (openLinks) openLinks.classList.remove('open');
      var openBtn = document.querySelector('.nav-toggle.open');
      if (openBtn) openBtn.classList.remove('open');
    }
  });
})();
</script>
<!-- Footer credit dinamico (legge da /api/site-footer.json come la home) -->
<script>
(function(){
  try {
    fetch('/api/site-footer.json').then(function(r){return r.json();}).then(function(j){
      if (!j || !j.creditHtml) return;
      document.querySelectorAll('.foot-credit-dynamic').forEach(function(el){
        el.innerHTML = j.creditHtml;
      });
    }).catch(function(){});
  } catch(e){}
})();
</script>
