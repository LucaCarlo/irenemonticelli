<%- include('_header') %>

<style>
  .rg-section{display:grid;grid-template-columns:1fr 1.3fr;gap:80px;align-items:start;max-width:1200px;margin:0 auto}
  .rg-sec-num{font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;font-weight:500;color:var(--ink-soft);margin-bottom:36px;display:flex;align-items:center;gap:14px}
  .rg-sec-dash{display:inline-block;width:40px;height:1.5px;background:var(--yellow)}

  /* ===== Colonna sinistra: testo intro ===== */
  .rg-intro h1.h-section{
    font-family:var(--serif);
    font-size:clamp(46px,5.8vw,76px);font-weight:400;line-height:1.05;
    letter-spacing:-.012em;margin:0 0 32px;color:var(--black)
  }
  .rg-intro h1 i.it{font-style:italic}
  .rg-intro h1 .yel{color:var(--yellow-d)}
  .rg-intro p.body-lg{
    font-size:17px;line-height:1.65;color:var(--ink-soft);font-weight:300;
    margin:0 0 28px;max-width:480px
  }

  .rg-perks{display:flex;flex-direction:column;gap:24px;margin-top:36px;max-width:480px}
  .rg-perk{display:flex;gap:18px;align-items:flex-start;line-height:1.5}
  .rg-perk-n{flex-shrink:0;font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;color:var(--ink-soft);min-width:30px;padding-top:3px}
  .rg-perk-body strong{display:block;font-size:16px;color:var(--ink);font-weight:500;margin-bottom:4px;font-family:var(--serif);font-size:19px}
  .rg-perk-body span{font-size:14px;color:var(--ink-soft);font-weight:300}

  /* ===== Colonna destra: form ===== */
  .rg-form{display:flex;flex-direction:column;gap:32px;max-width:560px}
  .rg-form-row{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  @media (max-width:560px){.rg-form-row{grid-template-columns:1fr;gap:32px}}
  .rg-form-field{position:relative;display:flex;flex-direction:column}
  .rg-form-field label{font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;color:var(--ink-soft);margin-bottom:14px;line-height:1.4;min-height:17px;display:flex;align-items:center;gap:3px}
  .rg-form-field label .req{font-size:1em;color:var(--yellow-d);font-weight:700}
  .rg-form-field input,.rg-form-field textarea{
    font-family:var(--sans);font-weight:300;font-size:17px;color:var(--ink);
    background:transparent;border:0;border-bottom:1px solid rgba(42,42,42,.22);
    padding:14px 0 16px;outline:none;width:100%;
    transition:border-bottom-color .35s cubic-bezier(.7,0,.2,1),border-bottom-width .35s cubic-bezier(.7,0,.2,1)
  }
  .rg-form-field textarea{resize:vertical;min-height:120px;line-height:1.6;font-family:inherit}
  .rg-form-field input:focus,.rg-form-field textarea:focus{
    border-bottom-color:var(--yellow);border-bottom-width:1.5px;padding-bottom:15.5px
  }
  .rg-form-field input::placeholder,.rg-form-field textarea::placeholder{color:rgba(42,42,42,.35);font-weight:300}

  .rg-check{display:flex;gap:12px;align-items:flex-start;font-size:13.5px;color:var(--ink-soft);line-height:1.55;cursor:pointer;padding:0;margin-top:8px}
  .rg-check input{margin-top:3px;accent-color:var(--yellow-d);width:16px;height:16px;flex-shrink:0}
  .rg-check a{color:var(--ink);font-weight:500;text-decoration:underline}

  .rg-submit{
    align-self:flex-start;margin-top:14px;
    display:inline-flex;align-items:center;gap:0;background:transparent;color:var(--yellow-d);
    padding:16px 38px;border-radius:999px;
    font-family:var(--sans);font-weight:500;font-size:13px;letter-spacing:.18em;text-transform:uppercase;
    border:1.5px solid var(--yellow);cursor:pointer;
    position:relative;overflow:hidden;isolation:isolate;
    transition:color .45s cubic-bezier(.7,0,.2,1),transform .45s cubic-bezier(.7,0,.2,1),box-shadow .45s cubic-bezier(.7,0,.2,1)
  }
  .rg-submit::before{content:"";position:absolute;inset:0;background:var(--yellow);transform:translateX(-101%);transition:transform .5s cubic-bezier(.7,0,.2,1);z-index:-1}
  .rg-submit:hover{color:#fff;transform:translateY(-1px);box-shadow:0 8px 24px -10px rgba(245,197,24,.5)}
  .rg-submit:hover::before{transform:translateX(0)}

  .rg-bottom-link{font-size:14.5px;color:var(--ink-soft);margin-top:24px}
  .rg-bottom-link a{font-weight:500;color:var(--ink);border-bottom:1px solid var(--yellow);padding-bottom:1px}
  .rg-bottom-link a:hover{color:var(--yellow-d);text-decoration:none}

  .rg-alert{padding:16px 18px;border-radius:12px;font-size:14px;line-height:1.5;border:1px solid;margin-bottom:18px;
    background:#fef0ec;border-color:#f3c5b9;color:#a8351c}
  .rg-alert strong{display:block;margin-bottom:6px}
  .rg-alert ul{margin:0;padding-left:18px}

  /* ===== Stato "richiesta inviata" ===== */
  .rg-success-wrap{max-width:680px;margin:60px auto;text-align:center}
  .rg-success-ico{width:88px;height:88px;border-radius:50%;background:var(--yellow);
    margin:0 auto 32px;display:flex;align-items:center;justify-content:center}
  .rg-success-ico svg{width:42px;height:42px;color:#1c1f26;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
  .rg-success-wrap h1{font-family:var(--serif);font-size:clamp(40px,5vw,58px);font-weight:400;line-height:1.05;letter-spacing:-.01em;margin:0 0 20px}
  .rg-success-wrap p{color:var(--ink-soft);font-size:16.5px;line-height:1.65;margin:0 0 36px;max-width:520px;margin-left:auto;margin-right:auto}
  .rg-success-wrap a.rg-submit{display:inline-flex}

  @media (max-width:880px){
    .rg-section{grid-template-columns:1fr;gap:56px}
    .rg-form,.rg-perks,.rg-intro p.body-lg{max-width:none}
  }
</style>

<% if (submitted) { %>
  <div class="rg-success-wrap">
    <div class="rg-success-ico">
      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h1>¡Solicitud<br>enviada!</h1>
    <p>
      Hemos recibido tu solicitud de adhesión al programa de referidos.
      Recibirás un correo con tus credenciales de acceso en cuanto sea aprobada.
    </p>
    <a href="/" class="rg-submit">Volver al inicio</a>
  </div>
<% } else { %>
  <section class="rg-section">
    <!-- COLONNA SINISTRA: intro -->
    <div class="rg-intro">
      <div class="rg-sec-num"><span class="rg-sec-dash"></span>Programa de referidos</div>
      <h1 class="h-section">Conviértete<br>en <i class="it yel">referido</i>.</h1>
      <p class="body-lg">
        Comparte la pasión por la danza con tu comunidad. Por cada nueva inscripción
        generada con tu código personal, recibirás una comisión sobre la venta.
      </p>

      <div class="rg-perks">
        <div class="rg-perk">
          <span class="rg-perk-n">01</span>
          <div class="rg-perk-body">
            <strong>Envía tus datos</strong>
            <span>Completa el formulario en menos de un minuto.</span>
          </div>
        </div>
        <div class="rg-perk">
          <span class="rg-perk-n">02</span>
          <div class="rg-perk-body">
            <strong>Aprobación manual</strong>
            <span>Evaluaremos tu solicitud y te responderemos en pocos días.</span>
          </div>
        </div>
        <div class="rg-perk">
          <span class="rg-perk-n">03</span>
          <div class="rg-perk-body">
            <strong>Empieza a ganar</strong>
            <span>Recibe tu código y el acceso al panel privado con tus ganancias.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- COLONNA DESTRA: form -->
    <div>
      <% if (errors && errors.length) { %>
        <div class="rg-alert">
          <strong>Revisa los campos:</strong>
          <ul>
            <% errors.forEach(function(e){ %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="/area-referral/register" class="rg-form" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="rg-form-row">
          <div class="rg-form-field">
            <label for="firstName">Nombre <span class="req">*</span></label>
            <input type="text" id="firstName" name="firstName" required autocomplete="given-name" value="<%= (form && form.firstName) || '' %>" placeholder="Tu nombre">
          </div>
          <div class="rg-form-field">
            <label for="lastName">Apellidos <span class="req">*</span></label>
            <input type="text" id="lastName" name="lastName" required autocomplete="family-name" value="<%= (form && form.lastName) || '' %>" placeholder="Tus apellidos">
          </div>
        </div>

        <div class="rg-form-row">
          <div class="rg-form-field">
            <label for="email">Email <span class="req">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" value="<%= (form && form.email) || '' %>" placeholder="tu@email.com">
          </div>
          <div class="rg-form-field">
            <label for="phone">Teléfono</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" value="<%= (form && form.phone) || '' %>" placeholder="+34 …">
          </div>
        </div>

        <div class="rg-form-field">
          <label for="notes">Háblanos de ti (opcional)</label>
          <textarea id="notes" name="notes" placeholder="¿Cuál es tu comunidad? ¿Cuántos seguidores tienes? ¿Cómo piensas promover el programa?"><%= (form && form.notes) || '' %></textarea>
        </div>

        <label class="rg-check">
          <input type="checkbox" name="privacy" value="1" required>
          <span>Acepto la <a href="/privacidad" target="_blank">Política de Privacidad</a> y autorizo el tratamiento de mis datos con la finalidad de adherirme al programa de referidos.</span>
        </label>

        <button type="submit" class="rg-submit">Enviar solicitud</button>

        <div class="rg-bottom-link">¿Ya tienes una cuenta? <a href="/area-referral/login">Inicia sesión</a></div>
      </form>
    </div>
  </section>
<% } %>

<%- include('_footer') %>
