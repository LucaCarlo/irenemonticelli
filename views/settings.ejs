<%- include('partials/header') %>
<%
  var ICONS = {
    general:   { ico:'🪪', bg:'#fdf2c9', fg:'#7a5800' },
    contatti:  { ico:'📞', bg:'#e3f0ff', fg:'#0d5290' },
    smtp:      { ico:'✉',  bg:'#eef4ff', fg:'#3b4a7a' },
    stripe:    { ico:'💳', bg:'#e7f3ec', fg:'#1b6b3e' },
    recaptcha: { ico:'🛡', bg:'#fde8e8', fg:'#8a2a1c' },
    analytics: { ico:'📊', bg:'#fff3d6', fg:'#7a5800' },
    legal:     { ico:'⚖',  bg:'#f0e8f7', fg:'#5b3a86' },
    social:    { ico:'🔗', bg:'#e5f3ff', fg:'#0d5290' },
  };
  function statusFor(g, vals){
    if (g === 'smtp') {
      return vals.smtp_host ? { label: 'Configurato', cls: 'ok' } : { label: 'Da configurare', cls: 'warn' };
    }
    if (g === 'stripe') {
      if (!vals.stripe_publishable_key && !vals.stripe_secret_key) return { label: 'Inattivo', cls: 'off' };
      return { label: (vals.stripe_mode || 'test').toUpperCase(), cls: (vals.stripe_mode === 'live' ? 'live' : 'test') };
    }
    if (g === 'recaptcha') {
      return (vals.recaptcha_enabled === '1' || vals.recaptcha_enabled === 'true')
        ? { label: 'Attivo', cls: 'ok' } : { label: 'Off', cls: 'off' };
    }
    if (g === 'analytics') {
      var on = !!(vals.ga_measurement_id || vals.gtm_id || vals.meta_pixel_id);
      return { label: on ? 'Attivo' : 'Off', cls: on ? 'ok' : 'off' };
    }
    if (g === 'social') {
      var count = ['social_instagram','social_facebook','social_youtube','social_tiktok','social_linkedin'].filter(function(k){ return !!vals[k]; }).length;
      if (!count) return { label: '0', cls: 'off' };
      return { label: String(count), cls: 'info' };
    }
    if (g === 'general' && (vals.bookings_enabled === '1' || vals.bookings_enabled === 'true')) {
      return { label: 'Booking ON', cls: 'ok' };
    }
    if (g === 'general') return { label: 'Booking OFF', cls: 'off' };
    return null;
  }
%>

<div class="card st-head">
  <div>
    <h2 style="margin:0 0 4px">Impostazioni</h2>
    <p class="muted" style="margin:0;font-size:13.5px">Configura ogni aspetto del sito e dell'area admin. I valori vengono applicati immediatamente al salvataggio.</p>
  </div>
</div>

<div class="st-grid">
  <!-- SIDEBAR TABS -->
  <aside class="st-side">
    <% Object.keys(SCHEMA).forEach(function(g){ var grp=SCHEMA[g]; var ic=ICONS[g]||{ico:'⚙',bg:'#eef0f4',fg:'#5a5e6a'}; var st=statusFor(g, values); %>
      <a class="st-tab <%= active === g ? 'is-active' : '' %>" href="/admin/settings?tab=<%= g %>">
        <div class="st-tab-ico" style="background:<%= ic.bg %>;color:<%= ic.fg %>"><%= ic.ico %></div>
        <div class="st-tab-meta">
          <div class="st-tab-title"><%= grp.label %></div>
          <div class="st-tab-sub"><%= grp.fields.length %> camp<%= grp.fields.length===1?'o':'i' %></div>
        </div>
        <% if (st) { %><span class="st-tab-badge st-tab-badge-<%= st.cls %>"><%= st.label %></span><% } %>
      </a>
    <% }) %>
  </aside>

  <!-- MAIN PANEL -->
  <div class="st-main">
    <% var grp = SCHEMA[active] || SCHEMA.general; var ic = ICONS[active] || ICONS.general; %>
    <form method="post" action="/admin/settings/<%= active %>" class="card form st-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="st-card-head">
        <div class="st-card-ico" style="background:<%= ic.bg %>;color:<%= ic.fg %>"><%= ic.ico %></div>
        <div>
          <h2 style="margin:0"><%= grp.label %></h2>
          <p class="muted" style="margin:4px 0 0;font-size:13px"><%= grp.fields.length %> impostazion<%= grp.fields.length===1?'e':'i' %> in questo gruppo</p>
        </div>
      </div>

      <div class="form-grid st-form-grid">
        <% grp.fields.forEach(function(f){ var val = values[f.key] || ''; var isFull = (f.type==='textarea' || f.type==='media' || f.key==='footer_credit_html' || f.help); %>
          <div class="field <%= isFull ? 'field-full' : '' %>">
            <label class="field-lbl"><%= f.label %></label>
            <% if (f.type === 'bool') { %>
              <label class="switch st-switch">
                <input type="checkbox" name="<%= f.key %>" value="1" <%= (val==='1'||val==='true') ? 'checked' : '' %>>
                <span>Attivo</span>
              </label>
            <% } else if (f.type === 'select') { %>
              <select name="<%= f.key %>">
                <% f.options.forEach(function(o){ %><option value="<%= o %>" <%= val===o?'selected':'' %>><%= o %></option><% }) %>
              </select>
            <% } else if (f.type === 'media') { %>
              <% var picked = pickedMedia[parseInt(val,10)]; %>
              <div class="media-picker" data-target="<%= f.key %>">
                <input type="hidden" name="<%= f.key %>" value="<%= val %>">
                <div class="media-picker-preview">
                  <% if (picked) { %><img src="<%= picked.smallPath %>" alt=""><% } else { %><span class="muted">Nessuna immagine</span><% } %>
                </div>
                <div class="media-picker-actions">
                  <label class="btn btn-primary" style="cursor:pointer;margin:0">Carica file
                    <input type="file" class="media-picker-file" accept="image/*" hidden>
                  </label>
                  <button type="button" class="btn btn-ghost btn-pick">📁 Scegli dalla libreria</button>
                  <button type="button" class="btn btn-ghost btn-clear">↺ Rimuovi</button>
                  <div class="media-picker-status muted" style="font-size:13px" hidden></div>
                </div>
              </div>
            <% } else if (f.type === 'password') { %>
              <input type="password" name="<%= f.key %>" value="<%= val %>" placeholder="<%= f.placeholder||'' %>" autocomplete="new-password">
            <% } else if (f.type === 'textarea') { %>
              <textarea name="<%= f.key %>" rows="4" placeholder="<%= f.placeholder||'' %>"><%= val %></textarea>
            <% } else { %>
              <input type="<%= f.type==='number'?'number':'text' %>" name="<%= f.key %>" value="<%= val %>" placeholder="<%= f.placeholder||'' %>">
            <% } %>
            <% if (f.help) { %><div class="field-help"><%= f.help %></div><% } %>
          </div>
        <% }) %>
      </div>

      <div class="form-actions st-form-actions">
        <button type="submit" class="btn btn-primary">💾 Salva <%= grp.label %></button>
      </div>
    </form>

    <% if (active === 'smtp') { %>
    <form method="post" action="/admin/settings/test-email" class="card form st-card st-card-sub">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="st-card-head">
        <div class="st-card-ico" style="background:#e7f3ec;color:#1b6b3e">🧪</div>
        <div>
          <h3 style="margin:0">Test invio email</h3>
          <p class="muted" style="margin:4px 0 0;font-size:13px">Usa la configurazione SMTP qui sopra per inviare una mail di prova.</p>
        </div>
      </div>
      <div class="field">
        <label class="field-lbl">Indirizzo destinatario</label>
        <input type="email" name="to" placeholder="<%= currentUser.email %>">
        <div class="field-help">Lascia vuoto per usare la tua email di login.</div>
      </div>
      <div class="form-actions"><button class="btn btn-primary">Invia email di test</button></div>
    </form>
    <% } %>

    <% if (active === 'stripe') { %>
    <div class="card st-card st-card-sub">
      <div class="st-card-head">
        <div class="st-card-ico" style="background:#fff3d6;color:#7a5800">ℹ</div>
        <div>
          <h3 style="margin:0">Note sulla configurazione Stripe</h3>
        </div>
      </div>
      <ul style="margin:0;padding-left:20px;font-size:13.5px;line-height:1.7;color:var(--ink)">
        <li>In <strong>modalità test</strong> usa solo <code>pk_test_…</code> / <code>sk_test_…</code>.</li>
        <li>In <strong>modalità live</strong>: pagamenti reali, controlla webhooks su dashboard Stripe.</li>
        <li>Il <em>webhook secret</em> serve per validare gli eventi Stripe → la rotta <code>POST /webhooks/stripe</code> sul sito.</li>
      </ul>
    </div>
    <% } %>

  </div>
</div>

<style>
  .st-head{padding:18px 20px}
  .st-grid{display:grid;grid-template-columns:280px 1fr;gap:20px;align-items:start}

  .st-side{display:flex;flex-direction:column;gap:8px;position:sticky;top:80px;max-height:calc(100vh - 100px);overflow-y:auto;padding-right:4px}
  .st-side::-webkit-scrollbar{width:6px}
  .st-side::-webkit-scrollbar-thumb{background:#d8dbe2;border-radius:6px}

  .st-tab{display:flex;align-items:center;gap:12px;padding:11px 12px;background:#fff;border:1px solid var(--line);
    border-radius:11px;transition:.18s;color:var(--ink);position:relative}
  .st-tab:hover{text-decoration:none;border-color:#d8c98c;box-shadow:0 3px 14px rgba(0,0,0,.04);transform:translateY(-1px)}
  .st-tab.is-active{border-color:var(--brand);background:linear-gradient(135deg,#fffbe8,#fff);box-shadow:0 6px 18px rgba(224,170,0,.12)}
  .st-tab-ico{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
  .st-tab-meta{flex:1;min-width:0}
  .st-tab-title{font-weight:600;font-size:13.5px}
  .st-tab-sub{font-size:11.5px;color:var(--muted)}
  .st-tab-badge{font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:3px 7px;border-radius:99px;flex-shrink:0}
  .st-tab-badge-ok{background:#d6f3df;color:#1b6b3e}
  .st-tab-badge-off{background:#eef0f4;color:#5a5e6a}
  .st-tab-badge-warn{background:#ffe1b8;color:#7a4400}
  .st-tab-badge-test{background:#eef4ff;color:#0d5290}
  .st-tab-badge-live{background:#fde8e8;color:#8a2a1c}
  .st-tab-badge-info{background:#fff3d6;color:#7a5800}

  .st-main{min-width:0;display:flex;flex-direction:column;gap:20px}
  .st-card{padding:24px;margin:0}
  .st-card-sub{background:linear-gradient(135deg,#fafbfc,#fff)}
  .st-card-head{display:flex;align-items:center;gap:14px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid #eef0f4}
  .st-card-ico{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}

  .st-form-grid{grid-template-columns:repeat(2, minmax(220px, 1fr));gap:14px 22px}
  .st-form-grid .field{margin-bottom:0}
  .st-form-grid .field-full{grid-column:1 / -1}

  .st-form-actions{margin-top:22px;padding-top:18px;border-top:1px solid #eef0f4}
  .st-switch{padding:8px 14px;background:#fafbfc;border:1px solid var(--line);border-radius:9px;display:inline-flex}

  @media(max-width:1000px){
    .st-grid{grid-template-columns:1fr}
    .st-side{position:static;flex-direction:row;overflow-x:auto;flex-wrap:nowrap;max-height:none}
    .st-tab{min-width:240px;flex-shrink:0}
    .st-form-grid{grid-template-columns:1fr}
  }
</style>

<script>window.MEDIA_CSRF = "<%= csrfToken %>";</script>
<!-- Media picker modal -->
<div class="modal" id="pickerModal" hidden>
  <div class="modal-box">
    <div class="modal-head">
      <h3>Scegli immagine</h3>
      <button class="modal-x" id="pickerClose">&times;</button>
    </div>
    <div class="modal-body">
      <div class="media-grid" id="pickerGrid"><p class="muted">Caricamento...</p></div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
