<%- include('../partials/header') %>
<%
  var MESI=['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'];
  var MESI_S=['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'];
  var DOW_FULL=['Domenica','Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato'];
  var DOW=['Lun','Mar','Mer','Gio','Ven','Sab','Dom'];
  function fmtDate(d){ if(!d) return ''; var x=new Date(d); return x.toLocaleDateString('it-IT',{day:'2-digit',month:'long',year:'numeric'}); }
  function carryQ(extra){
    var p = [];
    if (eventId) p.push('event='+eventId);
    if (extra && extra.y) p.push('y='+extra.y);
    if (extra && extra.m) p.push('m='+extra.m);
    return '?' + p.join('&');
  }
%>
<div class="card">
  <div class="card-head">
    <h2>
      Prenotazioni
      <span class="muted" style="font-size:14px;font-weight:normal">· <%= total %> prenotazioni<% if (selectedEvent) { %> per "<%= selectedEvent.title %>"<% } %></span>
    </h2>
    <div class="head-tools" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <div class="view-switcher" style="display:inline-flex;border:1px solid #dde0e4;border-radius:8px;overflow:hidden">
        <a class="btn btn-sm btn-ghost" href="/admin/bookings" style="border:0;border-radius:0;padding:8px 14px">Vista lista</a>
        <a class="btn btn-sm" href="/admin/bookings/calendar" style="border:0;border-radius:0;border-left:1px solid #dde0e4;background:#1c1f26;color:#e0aa00;padding:8px 14px">Vista calendario</a>
      </div>
      <a class="btn btn-primary" href="/admin/bookings/new">+ Nuova prenotazione</a>
    </div>
  </div>

  <!-- Filtro evento — form grande e leggibile -->
  <form method="get" action="/admin/bookings/calendar" class="form cal-evfilter">
    <div class="field" style="margin-bottom:0">
      <label class="field-lbl">Filtra per evento</label>
      <select name="event" onchange="this.form.submit()">
        <option value="">— Vista mensile (tutte le prenotazioni per data) —</option>
        <% events.forEach(function(ev){ %>
          <option value="<%= ev.id %>" <%= ev.id===eventId?'selected':'' %>>
            <%= ev.title %><% if (ev.startDate) { %> · <%= new Date(ev.startDate).toLocaleDateString('it-IT',{day:'2-digit',month:'long',year:'numeric'}) %><% if (ev.endDate) { %> → <%= new Date(ev.endDate).toLocaleDateString('it-IT',{day:'2-digit',month:'long',year:'numeric'}) %><% } %><% } %>
          </option>
        <% }) %>
      </select>
    </div>
  </form>

  <% if (selectedEvent && eventDaysFull && eventDaysFull.length) { %>
    <div class="cal-evhead">
      <div>
        <strong><%= selectedEvent.title %></strong>
        <% if (selectedEvent.startDate && selectedEvent.endDate) { %>
          · <%= fmtDate(selectedEvent.startDate) %> → <%= fmtDate(selectedEvent.endDate) %>
        <% } %>
        <% if (selectedEvent.location) { %> · <span class="muted"><%= selectedEvent.location %></span><% } %>
      </div>
      <div class="muted" style="font-size:12.5px">
        Mostro <strong><%= eventDaysFull.length %> giorn<%= eventDaysFull.length===1?'o':'i' %></strong> dell'evento, affiancati. Ogni colonna = un giorno.
      </div>
    </div>

    <div class="cal-event-grid" style="--cols:<%= eventDaysFull.length %>">
      <% eventDaysFull.forEach(function(d){
           var items = byIso[d.iso] || [];
      %>
        <div class="cal-event-col">
          <div class="cal-event-head">
            <div class="cal-event-day-num"><%= d.d %></div>
            <div class="cal-event-day-meta">
              <div class="cal-event-day-dow"><%= DOW_FULL[d.dow] %></div>
              <div class="cal-event-day-month"><%= MESI[d.m-1] %> <%= d.y %></div>
            </div>
            <div class="cal-event-day-count"><%= items.length %></div>
          </div>
          <div class="cal-event-body">
            <% if (!items.length) { %>
              <div class="cal-event-empty">Nessuna prenotazione</div>
            <% } else {
                 // Riordina per: mattina prima della tarde, poi per orario, poi per nome
                 items.sort(function(x,y){
                   var sx = x.segment==='AM'?0:(x.segment==='PM'?2:1);
                   var sy = y.segment==='AM'?0:(y.segment==='PM'?2:1);
                   if (sx !== sy) return sx - sy;
                   var tx = (x.slots && x.slots[0]) || '99:99';
                   var ty = (y.slots && y.slots[0]) || '99:99';
                   return tx.localeCompare(ty) || (x.booking.customerName||'').localeCompare(y.booking.customerName||'');
                 });
            %>
              <% items.forEach(function(it){ var b = it.booking; %>
                <a class="cal-event-card" href="/admin/bookings/<%= b.id %>/edit">
                  <div class="cal-event-card-head">
                    <strong><%= b.customerName %></strong>
                    <span class="cal-status cal-status-<%= b.status %>"><%= b.status %></span>
                  </div>
                  <!-- Orari / fascia / pack-row -->
                  <div class="cal-event-card-slots">
                    <% if (it.mode==='single_lessons' && it.slots && it.slots.length) { %>
                      <% it.slots.forEach(function(t){ %><span class="cal-slot"><%= t %></span><% }) %>
                    <% } else if (it.mode==='red' && it.segment==='AM') { %>
                      <span class="cal-segment cal-seg-am">☀️ Mañana</span>
                    <% } else if (it.mode==='red' && it.segment==='PM') { %>
                      <span class="cal-segment cal-seg-pm">🌇 Tarde</span>
                    <% } else if (it.mode==='red') { %>
                      <span class="cal-segment cal-seg-warn">⚠️ fascia da impostare</span>
                    <% } else { %>
                      <span class="cal-segment cal-seg-all">📅 Tutto il giorno</span>
                    <% } %>
                  </div>
                  <div class="cal-event-card-sub">
                    <%= b.plan ? b.plan.name : '—' %>
                    <% if ((b.participantsCount||1) > 1) { %> · <strong><%= b.participantsCount %> pax</strong><% } %>
                    <% if (b.amount) { %> · <strong><%= b.amount %>€</strong><% } %>
                  </div>
                  <div class="cal-event-card-meta"><%= b.customerEmail %></div>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

  <% } else { %>
    <div class="cal-monthnav">
      <a class="btn btn-ghost btn-sm" href="/admin/bookings/calendar<%= carryQ({y:prev.y, m:prev.m}) %>">← <%= MESI_S[prev.m-1] %></a>
      <h3 class="cal-month-title"><%= MESI[m-1] %> <%= y %></h3>
      <a class="btn btn-ghost btn-sm" href="/admin/bookings/calendar<%= carryQ({y:next.y, m:next.m}) %>"><%= MESI_S[next.m-1] %> →</a>
    </div>
    <div class="cal">
      <% DOW.forEach(function(d){ %><div class="cal-h"><%= d %></div><% }) %>
      <% for (var i=0;i<firstDow;i++){ %><div class="cal-cell empty"></div><% } %>
      <% for (var day=1; day<=daysInMonth; day++){
           var items=byDay[day]||[];
      %>
        <div class="cal-cell">
          <div class="cal-day">
            <span><%= day %></span>
            <% if(items.length){ %><span class="cal-badge"><%= items.length %></span><% } %>
          </div>
          <% items.slice(0,5).forEach(function(it){ var b = it.booking;
               var slotLabel = '';
               if (it.mode==='single_lessons' && it.slots && it.slots.length) slotLabel = it.slots.join(',');
               else if (it.mode==='red' && it.segment==='AM') slotLabel = 'AM';
               else if (it.mode==='red' && it.segment==='PM') slotLabel = 'PM';
               else if (it.mode==='red') slotLabel = '⚠';
               else slotLabel = '◯';
          %>
            <a class="cal-ev" href="/admin/bookings/<%= b.id %>/edit" title="<%= b.customerName %> · <%= b.plan?b.plan.name:'' %><%= slotLabel?(' · '+slotLabel):'' %>">
              <span class="cal-status-dot cal-status-<%= b.status %>"></span>
              <span class="cal-ev-time"><%= slotLabel %></span>
              <span class="cal-ev-name"><%= b.customerName %></span>
            </a>
          <% }) %>
          <% if(items.length>5){ %><div class="muted" style="font-size:11px">+<%= items.length-5 %> altre</div><% } %>
        </div>
      <% } %>
    </div>
    <p class="muted" style="font-size:12px;margin-top:12px">
      <span class="cal-status-dot cal-status-confirmed"></span> Confermata &nbsp;
      <span class="cal-status-dot cal-status-pending"></span> In attesa &nbsp;
      <span class="cal-status-dot cal-status-cancelled"></span> Annullata
    </p>
  <% } %>
</div>

<style>
  .cal-evfilter{margin:18px 0 22px;padding:18px 20px;background:#fafbfc;border:1px solid #eef0f4;border-radius:10px}
  .cal-evfilter select{font-size:15px !important}

  .cal-evhead{background:#fdf8e8;border:1px solid #ead9a8;border-radius:8px;
    padding:14px 18px;margin-bottom:18px;color:#5e4400;font-size:14px;
    display:flex;flex-direction:column;gap:6px}
  .cal-evhead strong{color:#7a5800;font-size:15px}

  .cal-event-grid{display:grid;grid-template-columns:repeat(var(--cols),1fr);gap:14px}
  @media(max-width:1100px){.cal-event-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:720px){.cal-event-grid{grid-template-columns:1fr}}
  .cal-event-col{background:#fff;border:1px solid #ead9a8;border-radius:10px;overflow:hidden;
    display:flex;flex-direction:column}
  .cal-event-head{padding:18px 20px;background:linear-gradient(135deg,#fffbe8,#fdf2c9);
    border-bottom:2px solid #e0aa00;display:flex;align-items:center;gap:14px}
  .cal-event-day-num{font-family:Georgia,serif;font-size:46px;font-weight:600;line-height:1;color:#1c1f26}
  .cal-event-day-meta{flex:1}
  .cal-event-day-dow{font-size:14px;font-weight:600;color:#1c1f26}
  .cal-event-day-month{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:#7a5800}
  .cal-event-day-count{font-size:13px;background:#1c1f26;color:#e0aa00;width:36px;height:36px;
    border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700}
  .cal-event-body{padding:14px;flex:1;min-height:280px;display:flex;flex-direction:column;gap:8px}
  .cal-event-empty{text-align:center;color:#9aa1b2;font-size:13px;font-style:italic;padding:40px 10px}
  .cal-event-card{display:block;padding:11px 14px;border:1px solid #eef0f4;border-radius:8px;
    text-decoration:none;color:#1c1f26;background:#fafbfc;
    transition:background .2s ease,border-color .2s ease,transform .2s ease}
  .cal-event-card:hover{background:#fff;border-color:#e0aa00;transform:translateX(2px)}
  .cal-event-card-head{display:flex;align-items:center;gap:8px;margin-bottom:4px}
  .cal-event-card-head strong{font-size:14px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cal-event-card-sub{font-size:12.5px;color:#5a5e6a;margin-bottom:2px}
  .cal-event-card-meta{font-size:11px;color:#9aa1b2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cal-event-card-slots{display:flex;flex-wrap:wrap;gap:4px;margin:4px 0 6px}
  .cal-slot{font-size:11px;font-weight:700;padding:3px 8px;border-radius:4px;background:#1c1f26;color:#e0aa00;font-family:'Courier New',monospace;letter-spacing:.04em}
  .cal-segment{font-size:11px;font-weight:700;padding:3px 8px;border-radius:4px}
  .cal-seg-am{background:#fffbe8;color:#7a5800;border:1px solid #e8d99a}
  .cal-seg-pm{background:#fde7d6;color:#8a4a1c;border:1px solid #e8b88a}
  .cal-seg-all{background:#e7f3ec;color:#1b6b3e;border:1px solid #aedabe}
  .cal-seg-warn{background:#ffe1dc;color:#8a2a1c;border:1px solid #f0a8a0}

  .cal-ev-time{font-size:9.5px;background:#1c1f26;color:#e0aa00;padding:1px 5px;border-radius:3px;font-family:'Courier New',monospace;font-weight:700;flex-shrink:0;letter-spacing:.02em}
  .cal-ev-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  .cal-status{font-size:9.5px;padding:2px 6px;border-radius:99px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .cal-status-confirmed{background:#d6f3df;color:#1b6b3e}
  .cal-status-pending{background:#fff3d6;color:#7a5800}
  .cal-status-cancelled{background:#ffe1dc;color:#8a2a1c}

  .cal-monthnav{display:flex;align-items:center;justify-content:space-between;margin:14px 0 18px}
  .cal-month-title{margin:0;font-size:20px}
  .cal{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
  .cal-h{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#7a8190;padding:6px 4px;text-align:center;font-weight:600}
  .cal-cell{min-height:96px;border:1px solid #eef0f4;border-radius:9px;padding:6px;background:#fff}
  .cal-cell.empty{background:transparent;border:0}
  .cal-day{font-weight:700;font-size:13px;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
  .cal-badge{background:#e0aa00;color:#1c1408;border-radius:20px;font-size:10px;padding:1px 7px}
  .cal-ev{display:flex;align-items:center;gap:5px;font-size:11.5px;background:#f4f5f8;border-radius:6px;padding:3px 6px;margin:2px 0;text-decoration:none;color:#1c1f26;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cal-ev:hover{background:#eef0f4}
  .cal-status-dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex-shrink:0;background:#999}
  .cal-status-dot.cal-status-confirmed{background:#1f9d55}
  .cal-status-dot.cal-status-pending{background:#c98a00}
  .cal-status-dot.cal-status-cancelled{background:#d23f3f}
</style>
<%- include('../partials/footer') %>
