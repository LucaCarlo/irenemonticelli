<%- include('../partials/header') %>

<form method="post" action="<%= prof ? '/admin/professors/'+prof.id : '/admin/professors' %>" class="form fs-page" id="profForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="fs-page-head">
    <div>
      <h2><%= prof ? 'Modifica professore' : 'Nuovo professore' %></h2>
      <p><%= prof ? 'ID #'+prof.id+' · dati anagrafici, biografia e foto.' : 'Aggiungi un nuovo professore: anagrafica, foto profilo e biografia.' %></p>
    </div>
    <a class="btn btn-ghost" href="/admin/professors">← Torna ai professori</a>
  </div>

  <!-- SEZIONE 1: Anagrafica + foto -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#fdf2c9;color:#7a5800">👤</div>
      <div>
        <h3 class="fs-section-title">Anagrafica e foto</h3>
        <p class="fs-section-sub">Nome visibile sul sito + foto profilo usata nelle card e nel programma.</p>
      </div>
    </div>

    <div class="prof-layout">
      <div class="prof-photo">
        <label class="field-lbl">Foto profilo</label>
        <div class="media-picker" data-target="photoMediaId">
          <input type="hidden" name="photoMediaId" value="<%= prof && prof.photoMediaId ? prof.photoMediaId : '' %>">
          <div class="media-picker-preview prof-photo-preview">
            <% if (photo) { %><img src="<%= photo.smallPath || photo.path %>" alt=""><% } else { %><div class="prof-photo-empty"><div style="font-size:38px">👤</div><div style="font-size:12px;margin-top:6px">Nessuna foto</div></div><% } %>
          </div>
          <div class="media-picker-actions" style="display:flex;flex-direction:column;gap:6px;align-items:stretch">
            <label class="btn btn-primary" style="cursor:pointer;margin:0;justify-content:center">
              ⬆ Carica file
              <input type="file" class="media-picker-file" accept="image/*" hidden>
            </label>
            <button type="button" class="btn btn-ghost btn-pick">📁 Libreria</button>
            <button type="button" class="btn btn-ghost btn-clear">↺ Rimuovi</button>
            <div class="media-picker-status muted" style="font-size:13px" hidden></div>
          </div>
        </div>
        <div class="field-help" style="margin-top:8px">Consigliata foto verticale 600×800 o più, sfondo neutro.</div>
      </div>

      <div class="prof-fields">
        <div class="fs-grid">
          <div class="field">
            <label class="field-lbl">Nome *</label>
            <input type="text" name="firstName" required value="<%= prof ? prof.firstName : '' %>" placeholder="es. Irene">
          </div>
          <div class="field">
            <label class="field-lbl">Cognome *</label>
            <input type="text" name="lastName" required value="<%= prof ? prof.lastName : '' %>" placeholder="es. Monticelli">
          </div>
          <div class="field field-full">
            <label class="field-lbl">Tipo di danza</label>
            <input type="text" name="danceType" value="<%= prof ? prof.danceType : '' %>" placeholder="es. Contemporáneo, Ballet, Modern">
            <div class="field-help">Stile principale insegnato. Compare nella sezione professori del sito.</div>
          </div>
          <div class="field">
            <label class="field-lbl">Ordine</label>
            <input type="number" name="sort" value="<%= prof ? prof.sort : 0 %>">
            <div class="field-help">Valore più basso = mostrato per primo.</div>
          </div>
          <div class="field">
            <div class="fs-switch-card" style="height:100%">
              <label class="switch" style="margin:0">
                <input type="checkbox" name="active" value="1" <%= !prof || prof.active ? 'checked':'' %>>
                <span><strong>Visibile</strong></span>
              </label>
              <span class="muted" style="font-size:12px">Se OFF, non compare sul sito.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2: Biografia -->
  <section class="fs-section">
    <div class="fs-section-head">
      <div class="fs-section-ico" style="background:#e3f0ff;color:#0d5290">📖</div>
      <div>
        <h3 class="fs-section-title">Biografia</h3>
        <p class="fs-section-sub">Testo lungo della scheda professore: formazione, esperienza, premi.</p>
      </div>
    </div>
    <textarea name="descriptionHtml" class="rich-editor"><%= prof ? prof.descriptionHtml : '' %></textarea>
    <div class="field-help" style="margin-top:10px">Supporta grassetto, corsivo, elenchi puntati e numerati, link, tabelle, immagini, citazioni e codice.</div>
  </section>

  <div class="fs-actions">
    <a class="btn btn-ghost" href="/admin/professors">Annulla</a>
    <button class="btn btn-primary" type="submit"><%= prof ? '💾 Salva modifiche' : '✨ Crea professore' %></button>
  </div>
</form>

<style>
  .prof-layout{display:grid;grid-template-columns:260px 1fr;gap:24px;align-items:start}
  .prof-photo .media-picker{display:flex;flex-direction:column;gap:12px}
  .prof-photo-preview{width:100% !important;height:280px !important;border-radius:14px;overflow:hidden;background:#fafbfc;border:1px dashed var(--line);display:flex;align-items:center;justify-content:center}
  .prof-photo-preview img{width:100%;height:100%;object-fit:cover}
  .prof-photo-empty{display:flex;flex-direction:column;align-items:center;color:#9aa1b2}
  .prof-fields{min-width:0}
  @media(max-width:780px){
    .prof-layout{grid-template-columns:1fr}
    .prof-photo-preview{height:240px}
  }
</style>

<script>window.MEDIA_CSRF = "<%= csrfToken %>";</script>
<!-- Media picker modal -->
<div class="modal" id="pickerModal" hidden>
  <div class="modal-box">
    <div class="modal-head"><h3>Scegli immagine</h3><button class="modal-x" id="pickerClose">&times;</button></div>
    <div class="modal-body"><div class="media-grid" id="pickerGrid"><p class="muted">Caricamento...</p></div></div>
  </div>
</div>

<%- include('../partials/tinymce') %>
<%- include('../partials/footer') %>
