<%- include('../partials/header') %>
<div class="card form-card wide">
  <div class="card-head">
    <h2>Messaggio #<%= item.id %></h2>
    <div class="head-tools">
      <a class="btn btn-ghost" href="/admin/messages">← Torna ai messaggi</a>
      <a class="btn btn-primary" href="mailto:<%= item.email %>?subject=Re: <%= encodeURIComponent(item.subject||'') %>">Rispondi via email</a>
    </div>
  </div>

  <table class="kv">
    <tr><td>Da</td><td><strong><%= item.name %></strong> &lt;<a href="mailto:<%= item.email %>"><%= item.email %></a>&gt;</td></tr>
    <tr><td>Oggetto</td><td><%= item.subject || '(senza oggetto)' %></td></tr>
    <tr><td>Data</td><td><%= new Date(item.createdAt).toLocaleString('it-IT') %></td></tr>
    <tr><td>IP / User-Agent</td><td class="muted" style="font-size:12.5px"><%= item.ip || '—' %> · <%= item.userAgent || '—' %></td></tr>
    <tr><td>Stato</td><td><span class="badge badge-<%= item.status %>"><%= item.status %></span></td></tr>
  </table>

  <div class="msg-body"><%= item.body %></div>

  <div class="form-actions">
    <form method="post" action="/admin/messages/<%= item.id %>/status" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (item.status !== 'archived') { %>
        <input type="hidden" name="status" value="archived">
        <button class="btn btn-ghost">Archivia</button>
      <% } else { %>
        <input type="hidden" name="status" value="read">
        <button class="btn btn-ghost">De-archivia</button>
      <% } %>
    </form>
    <form method="post" action="/admin/messages/<%= item.id %>/delete" style="display:inline" onsubmit="return confirm('Eliminare definitivamente il messaggio?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger">Elimina</button>
    </form>
  </div>
</div>
<style>
  table.kv{width:100%;border-collapse:collapse;margin-bottom:22px}
  table.kv td{padding:9px 6px;border-bottom:1px solid #eef0f4;vertical-align:top}
  table.kv td:first-child{color:#7a8190;width:160px;font-size:13px;text-transform:uppercase;letter-spacing:.07em}
  .msg-body{white-space:pre-wrap;background:#f7f8fa;padding:22px;border-radius:10px;line-height:1.6;font-size:15px;border:1px solid #eef0f4;margin-bottom:18px}
  .badge{display:inline-block;padding:3px 11px;border-radius:99px;font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;font-weight:600}
  .badge-new{background:#ffeec0;color:#7a5800}
  .badge-read{background:#e3f0ff;color:#0d5290}
  .badge-archived{background:#e6e6e6;color:#666}
</style>
<%- include('../partials/footer') %>
